<!DOCTYPE html>
<html>
<head>
<meta http-equiv="X-UA-Compatible" content="IE=9" />
<meta charset="utf-8" />
<title>Path-Config</title>
<HTA:APPLICATION
    ID="PathConfigApplication"
    APPLICATIONNAME="Path-Config"
    BORDER="thin"
    CAPTION="yes"
    ICON="Path-Config.ico"
    MAXIMIZEBUTTON="yes"
    MINIMIZEBUTTON="yes"
    SCROLL="yes"
    SINGLEINSTANCE="yes"
    SYSMENU="yes"
    WINDOWSTATE="normal"
/>
<style type="text/css">
html, body {
    margin: 0;
    min-width: 1350px;
    min-height: 680px;
    background: #17181b;
    color: #d8d9dc;
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 14px;
}
body {
    overflow: auto;
}
button, input, select {
    font: inherit;
}
.app {
    padding: 16px 18px 22px 18px;
}
.topbar {
    position: relative;
    min-height: 64px;
    padding: 14px 16px;
    border: 1px solid #33363c;
    background: #202226;
    box-shadow: 0 2px 10px rgba(0,0,0,.35);
}
.brand {
    float: left;
    width: 260px;
}
.brand-title {
    color: #fff;
    font-size: 22px;
    font-weight: 650;
    letter-spacing: .2px;
}
.brand-version {
    margin-top: 4px;
    color: #858a93;
    font-size: 12px;
}
.top-actions {
    float: right;
    padding-top: 3px;
}
.clear {
    clear: both;
}
.button {
    min-width: 126px;
    height: 38px;
    margin-left: 8px;
    padding: 0 18px;
    border: 1px solid #444850;
    background: #2a2d32;
    color: #f0f1f2;
    cursor: pointer;
}
.button:hover {
    border-color: #6b717b;
    background: #33373d;
}
.save-state-frozen,
.save-state-frozen:hover {
    border-color: #444850;
    background: #2a2d32;
    color: #686d75;
    cursor: default;
}

.button-primary.config {
    border-color: #e58d19;
    color: #ffad3e;
}
.button-primary.apply {
    border-color: #397dd1;
    color: #71b2ff;
}
.button-apply-action,
.button-apply-action:hover {
    border-color: #34794c;
    color: #76df96;
}
.button-danger {
    border-color: #713f46;
    color: #ff9aa7;
}
.button-small {
    min-width: 0;
    height: 30px;
    margin: 0 0 0 6px;
    padding: 0 10px;
    font-size: 12px;
}
.tabs-shell {
    margin-top: 16px;
    border: 1px solid #33363c;
    background: #1d1f22;
}
.tabs {
    min-height: 44px;
    padding: 0 10px;
    border-bottom: 1px solid #33363c;
    background: #202226;
    white-space: nowrap;
    overflow-x: auto;
}
.tab {
    display: inline-block;
    height: 43px;
    margin-right: 2px;
    padding: 0 18px;
    border: 0;
    border-bottom: 3px solid transparent;
    background: transparent;
    color: #aeb2b9;
    cursor: pointer;
}
.tab:hover {
    color: #fff;
    background: #272a2f;
}
.tab.active.config {
    border-bottom-color: #f39a23;
    color: #ffb552;
}
.tab.active.apply {
    border-bottom-color: #438de5;
    color: #85bfff;
}
.tab-tools {
    min-height: 36px;
    padding: 9px 14px 6px 14px;
    border-bottom: 1px solid #2e3136;
    text-align: right;
}
.tab-tools-left {
    float: left;
    padding: 6px 0 0 2px;
    color: #858a93;
    font-size: 12px;
}
.content {
    min-height: 540px;
    padding: 20px;
}
.section {
    margin-bottom: 24px;
}
.section-head {
    min-height: 24px;
    margin-bottom: 10px;
}
.section-title {
    display: inline-block;
    color: #fff;
    font-size: 17px;
    font-weight: 650;
}
.section-action {
    display: inline-block;
    margin-left: 10px;
    vertical-align: 2px;
    border: 0;
    background: transparent;
    color: #f2a23a;
    cursor: pointer;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
}
.section-action:hover {
    color: #ffc473;
}
.data-table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0 6px;
    table-layout: fixed;
}
.data-table th {
    padding: 0 7px 3px 7px;
    color: #858a93;
    font-size: 11px;
    font-weight: 600;
    text-align: left;
    text-transform: uppercase;
}
.data-table td {
    padding: 0 4px;
    vertical-align: middle;
}
.path-table td {
    padding-right: 10px;
    padding-left: 10px;
}
.path-table .status-header {
    padding-right: 8px;
    padding-left: 8px;
    text-align: center;
}
.path-table .status-admin {
    color: #f2a23a;
}
.path-table .status-start {
    color: #69c77d;
}
.path-table .status-menu {
    color: #5aa9e6;
}
.path-table {
    min-width: 1270px;
}
.path-field {
    min-width: 560px;
}
.path-table td:first-child {
    padding-left: 0;
    text-align: left;
}
.path-table td:last-child {
    padding-right: 0;
    text-align: right;
}
.path-table .button-small {
    margin-left: 0;
}
.path-browse-button {
    box-sizing: border-box;
    width: 64px;
    padding-right: 0;
    padding-left: 0;
}
.move-cell .button,
.path-table td:last-child .button-small {
    box-sizing: border-box;
    width: 30px;
    padding-right: 0;
    padding-left: 0;
}
.program-table {
    min-width: 1270px;
}
.program-table td {
    padding-right: 10px;
    padding-left: 10px;
}
.program-table td:first-child {
    padding-left: 0;
    text-align: left;
}
.program-table td:last-child {
    padding-right: 0;
    text-align: right;
}
.links-apply-table td:last-child {
    text-align: left;
}
.program-table .button-small {
    box-sizing: border-box;
    width: 30px;
    margin-left: 0;
    padding-right: 0;
    padding-left: 0;
}
.program-table .row-action-pair .button-small + .button-small {
    margin-left: 20px;
}
.field {
    box-sizing: border-box;
    width: 100%;
    height: 32px;
    padding: 5px 8px;
    border: 1px solid #3b3f46;
    background: #141518;
    color: #d8d9dc;
    outline: none;
}
.field:focus {
    border-color: #727984;
}
.field.valid {
    color: #76df96;
}
.field.invalid {
    border-color: #80434b;
    color: #ff8f9d;
}
.field.same-directory {
    border-color: #b86f16;
    color: #f2a23a;
}
.readonly {
    min-height: 24px;
    padding: 6px 8px;
    border-bottom: 1px solid #2d3035;
    color: #d8d9dc;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}
.readonly.boolean-status {
    min-width: 30px;
    padding-right: 0;
    padding-left: 0;
    overflow: visible;
    text-align: center;
    text-overflow: clip;
}
.readonly.valid {
    color: #76df96;
}
.readonly.invalid {
    color: #ff8f9d;
}
.readonly.same-directory {
    border-bottom-color: #b86f16;
    color: #f2a23a;
}
.yes {
    color: #76df96;
}
.no {
    color: #747983;
}
.mismatch {
    color: #ff5f6d;
    font-weight: 650;
}
.empty-state {
    padding: 16px 8px;
    border: 1px dashed #343840;
    color: #737984;
    text-align: center;
}
.check-wrap {
    display: block;
    padding: 6px 0;
    text-align: center;
    white-space: nowrap;
}
.path-table .check-wrap input {
    width: 20px;
    height: 20px;
    margin: 0;
    vertical-align: middle;
}
.move-cell {
    padding-right: 0 !important;
    text-align: right;
}
.move-cell .button {
    margin-left: 0;
}
.row-menu-button {
    width: 30px;
    padding: 0;
}
.row-menu-cell {
    padding-left: 0 !important;
    text-align: left;
}
.footer-actions {
    margin-top: 28px;
    padding-top: 18px;
    border-top: 1px solid #303339;
    text-align: right;
}
.status {
    min-height: 18px;
    margin-top: 10px;
    color: #7f858f;
    font-size: 12px;
    text-align: right;
}
.context-menu {
    position: absolute;
    z-index: 9999;
    display: none;
    width: 190px;
    padding: 5px;
    border: 1px solid #454a52;
    background: #25282d;
    box-shadow: 0 5px 16px rgba(0,0,0,.45);
}
.context-menu button {
    display: block;
    width: 100%;
    height: 32px;
    padding: 0 10px;
    border: 0;
    background: transparent;
    color: #d8d9dc;
    text-align: left;
    cursor: pointer;
}
.context-menu button:hover {
    background: #34383e;
}
.context-menu button[disabled],
.context-menu button[disabled]:hover {
    background: transparent;
    color: #62666e;
    cursor: default;
}
</style>
