var fso = null;
var wsh = null;
var appDir = "";
var lastBrowseDirectory = "C:\\";
var iniPath = "";
var legacyIniPath = "";
var logPath = "";
var saveTimer = null;
var sourcePath = "";
var sourceSignature = "";
var sourceChangeTime = 0;
var sourceReloadPending = false;
var isRestarting = false;
var heartbeatPath = "";
var relaunchRequestPath = "";
var persistentMenuIndex = -1;
var browseMenuPath = "";
var hasUnsavedChanges = false;
var state = {
    mode: "Config",
    activeUiTab: 0,
    activeProgramTab: 0,
    tabs: [],
    data: {},
    persistent: []
};

function trimText(value) {
    return String(value == null ? "" : value).replace(/^\s+|\s+$/g, "");
}

function html(value) {
    return String(value == null ? "" : value)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#39;");
}

function cleanIniValue(value) {
    return String(value == null ? "" : value).replace(/[\r\n]+/g, " ");
}

function lower(value) {
    return String(value).toLowerCase();
}

function environmentVariableKey(name) {
    return "$" + lower(trimText(name));
}

function addConfiguredEnvironment(variables, name, value) {
    name = trimText(name);
    value = trimText(value);
    if (name && value) {
        variables[environmentVariableKey(name)] = value;
    }
}

function configuredEnvironmentVariables() {
    var variables = {};
    var i, j, data;
    for (i = 0; i < state.persistent.length; i++) {
        addConfiguredEnvironment(variables, state.persistent[i].env_var, state.persistent[i].path);
    }
    for (i = 0; i < state.tabs.length; i++) {
        data = state.data[state.tabs[i]];
        if (!data) {
            continue;
        }
        for (j = 0; j < data.paths.length; j++) {
            addConfiguredEnvironment(variables, data.paths[j].env_var, data.paths[j].path);
        }
        for (j = 0; j < data.envs.length; j++) {
            addConfiguredEnvironment(variables, data.envs[j].name, data.envs[j].val);
        }
    }
    return variables;
}

function expandEnvironmentText(value, variables, resolving, depth) {
    var text = String(value == null ? "" : value);
    if (depth > 32 || text.indexOf("%") < 0) {
        return text;
    }
    return text.replace(/%([^%]+)%/g, function(token, name) {
        var key = environmentVariableKey(name);
        var replacement = "";
        if (resolving[key]) {
            return token;
        }
        resolving[key] = true;
        if (Object.prototype.hasOwnProperty.call(variables, key)) {
            replacement = variables[key];
        } else {
            try {
                replacement = wsh.ExpandEnvironmentStrings(token);
            } catch (ignoreEnvironment) {
                replacement = token;
            }
            if (replacement === token) {
                delete resolving[key];
                return token;
            }
        }
        replacement = expandEnvironmentText(replacement, variables, resolving, depth + 1);
        delete resolving[key];
        return replacement;
    });
}

function expandPathVariables(value, variables) {
    var text = trimText(value);
    if (text.indexOf("%") < 0) {
        return text;
    }
    return expandEnvironmentText(text, variables || configuredEnvironmentVariables(), {}, 0);
}

function environmentRegistryType(value) {
    return /%[^%]+%/.test(String(value || "")) ? "REG_EXPAND_SZ" : "REG_SZ";
}

function pathExists(path) {
    path = expandPathVariables(path);
    if (!path) {
        return false;
    }
    try {
        return fso.FileExists(path) || fso.FolderExists(path);
    } catch (ignore) {
        return false;
    }
}

function quoteArg(value) {
    return '"' + String(value).replace(/"/g, '""') + '"';
}

function getAppDirectory() {
    var path = decodeURIComponent(window.location.pathname).replace(/\//g, "\\");
    if (/^\\[A-Za-z]:/.test(path)) {
        path = path.substr(1);
    }
    return fso.GetParentFolderName(path);
}

function getApplicationPath() {
    var path = decodeURIComponent(window.location.pathname).replace(/\//g, "\\");
    if (/^\\[A-Za-z]:/.test(path)) {
        path = path.substr(1);
    }
    return path;
}

function getSourceSignature() {
    var source = fso.GetFile(sourcePath);
    return String(source.DateLastModified) + "|" + String(source.Size);
}

function watchForSourceUpdate() {
    try {
        var currentSignature = getSourceSignature();
        var now = new Date().valueOf();
        if (currentSignature !== sourceSignature) {
            sourceSignature = currentSignature;
            sourceChangeTime = now;
            sourceReloadPending = true;
            return;
        }
        if (sourceReloadPending && now - sourceChangeTime >= 1500) {
            if (hasUnsavedChanges) {
                setStatus("New version detected; save changes to restart automatically.");
                return;
            }
            restartApplication();
        }
    } catch (ignoreSourceUpdate) {}
}

function restartApplication() {
    try {
        if (hasUnsavedChanges && !saveState(false)) {
            sourceReloadPending = false;
            setStatus("Relaunch cancelled because current changes could not be saved.");
            return;
        }
        sourceReloadPending = false;
        isRestarting = true;
        hasUnsavedChanges = false;
        window.location.reload(true);
    } catch (errorRestart) {
        isRestarting = false;
        sourceReloadPending = false;
        setStatus("Could not restart Path-Config: " + errorRestart.message);
    }
}

function maintainLauncherBridge() {
    try {
        writeText(heartbeatPath, String(new Date().valueOf()));
        if (!fso.FileExists(relaunchRequestPath)) {
            return;
        }
        fso.DeleteFile(relaunchRequestPath, true);
        restartApplication();
    } catch (ignoreLauncherBridge) {}
}

function cleanupLauncherBridge() {
    if (isRestarting) {
        return;
    }
    try {
        if (fso.FileExists(heartbeatPath)) {
            fso.DeleteFile(heartbeatPath, true);
        }
        if (fso.FileExists(relaunchRequestPath)) {
            fso.DeleteFile(relaunchRequestPath, true);
        }
    } catch (ignoreLauncherCleanup) {}
}
function readText(path) {
    var stream = fso.OpenTextFile(path, 1, false, 0);
    var value = stream.ReadAll();
    stream.Close();
    return value;
}

function writeText(path, value) {
    var stream = fso.CreateTextFile(path, true, false);
    stream.Write(value);
    stream.Close();
}

function parseIni(text) {
    var ini = {};
    var current = "";
    var lines = String(text).replace(/\r\n/g, "\n").replace(/\r/g, "\n").split("\n");
    var i, line, match, splitAt, key, value;
    for (i = 0; i < lines.length; i++) {
        line = lines[i];
        if (!trimText(line) || /^\s*[;#]/.test(line)) {
            continue;
        }
        match = /^\s*\[([^\]]+)\]\s*$/.exec(line);
        if (match) {
            current = match[1];
            if (!ini[current]) {
                ini[current] = {};
            }
            continue;
        }
        splitAt = line.indexOf("=");
        if (current && splitAt >= 0) {
            key = trimText(line.substr(0, splitAt));
            value = line.substr(splitAt + 1);
            ini[current][key] = value;
        }
    }
    return ini;
}

function iniValue(ini, section, key, fallback) {
    if (ini[section] && typeof ini[section][key] !== "undefined") {
        return ini[section][key];
    }
    return fallback;
}

function asNumber(value, fallback) {
    var parsed = parseInt(value, 10);
    return isNaN(parsed) ? fallback : parsed;
}

function loadState() {
    var source = "";
    if (fso.FileExists(iniPath)) {
        source = iniPath;
    } else if (fso.FileExists(legacyIniPath)) {
        source = legacyIniPath;
    }

    if (!source) {
        state.tabs = ["PROGRAMS"];
        state.data = {"PROGRAMS": {paths: [emptyPathRow()], envs: [], execs: [], links: []}};
        state.persistent = [{path: "", env_var: "", run_as_admin: 0, run_on_startup: 0, menu: 0}];
        return;
    }

    var ini = parseIni(readText(source));
    var tabText = iniValue(ini, "Settings", "Tabs", "");
    var candidateTabs = tabText.split("|");
    var i, name;
    state.tabs = [];
    for (i = 0; i < candidateTabs.length; i++) {
        name = trimText(candidateTabs[i]);
        if (name && lower(name) !== "paths" && lower(name) !== "common" && name !== "WINDOWS") {
            state.tabs.push(name);
        }
    }
    if (!state.tabs.length) {
        state.tabs.push("PROGRAMS");
    }

    state.mode = lower(iniValue(ini, "Settings", "Mode", "Config")) === "apply" ? "Apply" : "Config";
    state.activeUiTab = asNumber(iniValue(ini, "Settings", "ActiveTab", "1"), 1) - 1;
    state.activeProgramTab = asNumber(iniValue(ini, "Settings", "ActiveProgramTab", "1"), 1) - 1;
    if (state.activeUiTab < 0 || state.activeUiTab > state.tabs.length) {
        state.activeUiTab = 0;
    }
    if (state.activeProgramTab < 0 || state.activeProgramTab >= state.tabs.length) {
        state.activeProgramTab = 0;
    }
    if (state.activeUiTab > 0) {
        state.activeProgramTab = state.activeUiTab - 1;
    }

    state.persistent = [];
    for (i = 1; ; i++) {
        var pathKey = i + "_Path";
        var legacyKey = String(i);
        var pathValue = iniValue(ini, "PersistentPaths", pathKey, null);
        var legacyValue = iniValue(ini, "PersistentPaths", legacyKey, null);
        if (pathValue === null && legacyValue === null) {
            break;
        }
        if (pathValue === null) {
            pathValue = legacyValue;
        }
        state.persistent.push({
            path: pathValue || "",
            env_var: iniValue(ini, "PersistentPaths", i + "_EnvVar", ""),
            run_as_admin: asNumber(iniValue(ini, "PersistentPaths", i + "_RunAsAdmin", "0"), 0) ? 1 : 0,
            run_on_startup: asNumber(iniValue(ini, "PersistentPaths", i + "_RunOnStartup", "0"), 0) ? 1 : 0,
            menu: asNumber(iniValue(ini, "PersistentPaths", i + "_Menu", "0"), 0) ? 1 : 0
        });
    }
    if (!state.persistent.length) {
        state.persistent.push({path: "", env_var: "", run_as_admin: 0, run_on_startup: 0, menu: 0});
    }

    state.data = {};
    for (i = 0; i < state.tabs.length; i++) {
        name = state.tabs[i];
        state.data[name] = {
            paths: loadProgramPathRows(ini, name + "_Paths"),
            envs: loadNameValueRows(ini, name + "_Envs"),
            execs: loadSimpleRows(ini, name + "_Execs"),
            links: loadLinkRows(ini, name + "_Links")
        };
        if (!state.data[name].paths.length) {
            state.data[name].paths.push(emptyPathRow());
        }
    }

    if (source !== iniPath) {
        hasUnsavedChanges = true;
    }
}

function loadNameValueRows(ini, section) {
    var rows = [];
    var i, name, value, legacy;
    for (i = 1; ; i++) {
        name = iniValue(ini, section, i + "_Name", null);
        if (name === null) {
            legacy = iniValue(ini, section, String(i), null);
            if (legacy === null) {
                break;
            }
            rows.push({name: "", val: legacy});
        } else {
            value = iniValue(ini, section, i + "_Val", "");
            rows.push({name: name, val: value});
        }
    }
    return rows;
}

function emptyPathRow(path, envVar) {
    return {
        path: path || "",
        env_var: envVar || "",
        run_as_admin: 0,
        run_on_startup: 0,
        menu: 0
    };
}

function loadProgramPathRows(ini, section) {
    var rows = [];
    var i, path, envVar, legacy;
    for (i = 1; ; i++) {
        path = iniValue(ini, section, i + "_Path", null);
        if (path === null) {
            path = iniValue(ini, section, i + "_Val", null);
        }
        if (path === null) {
            legacy = iniValue(ini, section, String(i), null);
            if (legacy === null) {
                break;
            }
            path = legacy;
        }
        envVar = iniValue(ini, section, i + "_EnvVar", null);
        if (envVar === null) {
            envVar = iniValue(ini, section, i + "_Name", "");
        }
        rows.push({
            path: path || "",
            env_var: envVar || "",
            run_as_admin: asNumber(iniValue(ini, section, i + "_RunAsAdmin", "0"), 0) ? 1 : 0,
            run_on_startup: asNumber(iniValue(ini, section, i + "_RunOnStartup", "0"), 0) ? 1 : 0,
            menu: asNumber(iniValue(ini, section, i + "_Menu", "0"), 0) ? 1 : 0
        });
    }
    return rows;
}

function loadSimpleRows(ini, section) {
    var rows = [];
    var i, value;
    for (i = 1; ; i++) {
        value = iniValue(ini, section, String(i), null);
        if (value === null) {
            break;
        }
        rows.push(value);
    }
    return rows;
}

function loadLinkRows(ini, section) {
    var rows = [];
    var i, src, legacy, target, split;
    for (i = 1; ; i++) {
        src = iniValue(ini, section, i + "_Src", null);
        if (src === null) {
            legacy = iniValue(ini, section, String(i), null);
            if (legacy === null) {
                break;
            }
            rows.push({src: legacy, tgt_dir: "", tgt_name: "", type: "Shortcut"});
            continue;
        }
        var targetDir = iniValue(ini, section, i + "_TgtDir", "");
        var targetName = iniValue(ini, section, i + "_TgtName", "");
        if (!targetDir && !targetName) {
            target = iniValue(ini, section, i + "_Tgt", "");
            if (target) {
                split = splitPath(target);
                targetDir = split.dir;
                targetName = split.name;
            }
        }
        rows.push({
            src: src,
            tgt_dir: targetDir,
            tgt_name: targetName,
            type: iniValue(ini, section, i + "_Type", "Shortcut") || "Shortcut"
        });
    }
    return rows;
}

function splitPath(path) {
    return {
        dir: fso.GetParentFolderName(path),
        name: fso.GetFileName(path)
    };
}

function section(lines, name) {
    lines.push("[" + name + "]");
}

function entry(lines, key, value) {
    lines.push(key + "=" + cleanIniValue(value));
}

function saveState(showMessage, stateAlreadyCaptured) {
    if (!stateAlreadyCaptured) {
        captureState();
    }
    var lines = [];
    var i, j, name, data, row;
    section(lines, "Settings");
    entry(lines, "Tabs", state.tabs.join("|"));
    entry(lines, "SchemaVersion", VERSION);
    entry(lines, "ActiveTab", state.activeUiTab + 1);
    entry(lines, "ActiveProgramTab", state.activeProgramTab + 1);
    entry(lines, "Mode", state.mode);
    lines.push("");

    section(lines, "PersistentPaths");
    for (i = 0; i < state.persistent.length; i++) {
        row = state.persistent[i];
        entry(lines, (i + 1) + "_Path", row.path);
        entry(lines, (i + 1) + "_EnvVar", row.env_var);
        entry(lines, (i + 1) + "_RunAsAdmin", row.run_as_admin ? 1 : 0);
        entry(lines, (i + 1) + "_RunOnStartup", row.run_on_startup ? 1 : 0);
        entry(lines, (i + 1) + "_Menu", row.menu ? 1 : 0);
    }
    lines.push("");

    for (i = 0; i < state.tabs.length; i++) {
        name = state.tabs[i];
        data = state.data[name];
        section(lines, name + "_Paths");
        for (j = 0; j < data.paths.length; j++) {
            row = data.paths[j];
            entry(lines, (j + 1) + "_Path", row.path);
            entry(lines, (j + 1) + "_EnvVar", row.env_var);
            entry(lines, (j + 1) + "_RunAsAdmin", row.run_as_admin ? 1 : 0);
            entry(lines, (j + 1) + "_RunOnStartup", row.run_on_startup ? 1 : 0);
            entry(lines, (j + 1) + "_Menu", row.menu ? 1 : 0);
        }
        lines.push("");
        if (data.envs.length) {
            section(lines, name + "_Envs");
            for (j = 0; j < data.envs.length; j++) {
                entry(lines, (j + 1) + "_Name", data.envs[j].name);
                entry(lines, (j + 1) + "_Val", data.envs[j].val);
            }
            lines.push("");
        }
        if (data.execs.length) {
            section(lines, name + "_Execs");
            for (j = 0; j < data.execs.length; j++) {
                entry(lines, j + 1, data.execs[j]);
            }
            lines.push("");
        }
        if (data.links.length) {
            section(lines, name + "_Links");
            for (j = 0; j < data.links.length; j++) {
                row = data.links[j];
                entry(lines, (j + 1) + "_Src", row.src);
                entry(lines, (j + 1) + "_TgtDir", row.tgt_dir);
                entry(lines, (j + 1) + "_TgtName", row.tgt_name);
                entry(lines, (j + 1) + "_Type", row.type);
            }
            lines.push("");
        }
    }

    var temporary = iniPath + ".tmp";
    try {
        writeText(temporary, lines.join("\r\n"));
        if (fso.FileExists(iniPath)) {
            fso.DeleteFile(iniPath, true);
        }
        fso.MoveFile(temporary, iniPath);
        hasUnsavedChanges = false;
        updateSaveStateButton();
        setStatus("Saved to Path-Config.ini");
        if (showMessage) {
            alert("Persistent paths and dynamic configurations were saved.");
        }
        return true;
    } catch (error) {
        try {
            if (fso.FileExists(temporary)) {
                fso.DeleteFile(temporary, true);
            }
        } catch (ignore) {}
        alert("Could not save Path-Config.ini.\n\n" + error.message);
        return false;
    }
}

function captureState() {
    var inputs = document.getElementsByTagName("input");
    var selects = document.getElementsByTagName("select");
    var i, changed;
    var anyChanged = false;
    for (i = 0; i < inputs.length; i++) {
        changed = captureElement(inputs[i]);
        anyChanged = anyChanged || changed;
    }
    for (i = 0; i < selects.length; i++) {
        changed = captureElement(selects[i]);
        anyChanged = anyChanged || changed;
    }
    if (anyChanged) {
        markDirty();
    }
}

function captureElement(element) {
    var scope = element.getAttribute("data-scope");
    if (!scope) {
        return false;
    }
    var field = element.getAttribute("data-field");
    var index = asNumber(element.getAttribute("data-index"), -1);
    var value = element.type === "checkbox" ? (element.checked ? 1 : 0) : element.value;
    if (element.type !== "checkbox" && state.mode === "Config") {
        value = normalizeConfigPathValue(element, value);
        if (element.value !== value) {
            element.value = value;
        }
    }
    var oldValue;
    if (scope === "persistent" && index >= 0 && state.persistent[index]) {
        oldValue = state.persistent[index][field];
        state.persistent[index][field] = value;
        return String(oldValue) !== String(value);
    }
    var kind = element.getAttribute("data-kind");
    var tabIndex = asNumber(element.getAttribute("data-tab"), -1);
    if (tabIndex < 0 || !state.tabs[tabIndex]) {
        return false;
    }
    var rows = state.data[state.tabs[tabIndex]][kind];
    if (kind === "execs") {
        oldValue = rows[index];
        rows[index] = value;
        return String(oldValue) !== String(value);
    }
    if (rows[index]) {
        oldValue = rows[index][field];
        rows[index][field] = value;
        var valueChanged = String(oldValue) !== String(value);
        var linkNameChanged = kind === "links" && field === "src" ?
            autofillLinkName(element, rows[index], oldValue) : false;
        return valueChanged || linkNameChanged;
    }
    return false;
}

function linkNameFromSource(source) {
    source = trimText(source).replace(/[\\\/]+$/, "");
    return source ? fso.GetFileName(source) : "";
}

function autofillLinkName(sourceInput, row, oldSource) {
    var currentName = trimText(row.tgt_name);
    var oldDefault = linkNameFromSource(oldSource);
    if (currentName && currentName !== oldDefault) {
        return false;
    }
    var linkName = linkNameFromSource(row.src);
    if (!linkName || currentName === linkName) {
        return false;
    }
    row.tgt_name = linkName;
    var inputs = document.getElementsByTagName("input");
    var i;
    for (i = 0; i < inputs.length; i++) {
        if (inputs[i].getAttribute("data-scope") === "dynamic" &&
                inputs[i].getAttribute("data-kind") === "links" &&
                inputs[i].getAttribute("data-tab") === sourceInput.getAttribute("data-tab") &&
                inputs[i].getAttribute("data-index") === sourceInput.getAttribute("data-index") &&
                inputs[i].getAttribute("data-field") === "tgt_name") {
            inputs[i].value = linkName;
            break;
        }
    }
    return true;
}

function normalizeConfigPathValue(element, value) {
    var isPath = element.getAttribute("data-pathcheck") === "1";
    if (!isPath && element.getAttribute("data-smartcheck") === "1") {
        isPath = looksLikePath(value);
    }
    if (!isPath) {
        return value;
    }
    value = trimText(value).replace(/\//g, "\\");
    if (/^[a-z]:\\/i.test(value)) {
        value = value.charAt(0).toUpperCase() + value.substr(1);
    }
    var expanded = expandPathVariables(value);
    try {
        if (expanded && fso.FolderExists(expanded) && !/\\$/.test(value)) {
            value += "\\";
        }
    } catch (ignoreConfigFolderCheck) {}
    return value;
}

function markDirty() {
    hasUnsavedChanges = true;
    updateSaveStateButton();
    setStatus("Unsaved changes");
}

function updateSaveStateButton() {
    var button = document.getElementById("saveStateButton");
    if (button) {
        button.className = hasUnsavedChanges ? "button" : "button save-state-frozen";
        button.onclick = hasUnsavedChanges ? function() { saveState(true); } : null;
    }
}

function trackInputChange() {
    var eventObject = window.event;
    var target = eventObject ? eventObject.srcElement : null;
    if (target && target.getAttribute && target.getAttribute("data-scope")) {
        if (captureElement(target)) {
            markDirty();
        }
    }
}

function showDirtyStatus() {
    if (hasUnsavedChanges) {
        setStatus("Unsaved changes");
    }
}

function render(preserveWindowSize) {
    start11PinCache = null;
    startupStateCache = null;
    document.title = "Path-Config v" + VERSION;
    var modeClass = lower(state.mode);
    var top = '<div class="topbar">' +
        '<div class="brand"><div class="brand-title">Path-Config</div>' +
        '<div class="brand-version">HTA edition &middot; v' + VERSION + '</div></div>' +
        '<div class="top-actions">';
    if (state.mode === "Apply" && state.activeUiTab > 0) {
        top += '<button class="button button-apply-action" onclick="applyCurrentProgram()">APPLY ' +
            html(state.tabs[state.activeUiTab - 1]).toUpperCase() + '</button>';
    }
    top += '<button class="button button-primary ' + modeClass + '" onclick="toggleMode()">MODE: ' +
        state.mode.toUpperCase() + '</button>';
    if (state.mode === "Config") {
        if (hasUnsavedChanges) {
            top += '<button id="saveStateButton" class="button" onclick="saveState(true)">SAVE STATE</button>';
        } else {
            top += '<button id="saveStateButton" class="button save-state-frozen">SAVE STATE</button>';
        }
    } else {
        top += '<button class="button button-apply-action" onclick="applyAll()">APPLY ALL</button>';
    }
    top += '</div><div class="clear"></div></div>';

    var tabs = '<div class="tabs" id="tabs" oncontextmenu="return tabContextMenu()">';
    tabs += tabButton(0, "Common");
    var i;
    for (i = 0; i < state.tabs.length; i++) {
        tabs += tabButton(i + 1, state.tabs[i]);
    }
    tabs += '</div>';

    var tools = '<div class="tab-tools"><div class="tab-tools-left">';
    tools += state.activeUiTab === 0 ? "Fixed system tab" : "Program configuration";
    tools += '</div>';
    if (state.mode === "Config") {
        tools += '<button class="button button-small" onclick="addProgram()">+ PROGRAM TAB</button>';
        if (state.activeUiTab > 0) {
            tools += state.activeProgramTab > 0 ?
                '<button class="button button-small" title="Move tab left" onclick="moveProgramTab(-1)">&#8592;</button>' :
                '<button class="button button-small save-state-frozen" title="Tab is already at the left boundary">&#8592;</button>';
            tools += state.activeProgramTab < state.tabs.length - 1 ?
                '<button class="button button-small" title="Move tab right" onclick="moveProgramTab(1)">&#8594;</button>' :
                '<button class="button button-small save-state-frozen" title="Tab is already at the right boundary">&#8594;</button>';
            tools += '<button class="button button-small" onclick="renameProgram()">RENAME</button>';
            tools += '<button class="button button-small button-danger" onclick="deleteProgram()">DELETE</button>';
        }
    }
    tools += '<div class="clear"></div></div>';

    var content = state.activeUiTab === 0 ? renderPersistent() : renderProgram(state.activeUiTab - 1);
    document.getElementById("app").innerHTML = top +
        '<div class="tabs-shell">' + tabs + tools + '<div class="content">' + content + '</div></div>' +
        '<div class="status" id="status">Ready</div>';
    validateInputs();
    showDirtyStatus();
    if (!preserveWindowSize) {
        window.setTimeout(fitWindowToContent, 0);
    }
}

function fitWindowToContent() {
    try {
        var availableWidth = screen.availWidth;
        var availableHeight = screen.availHeight;
        var desiredWidth = Math.max(1, Math.floor(availableWidth / 2));
        var viewportHeight = document.documentElement.clientHeight || document.body.clientHeight;
        var currentOuterHeight = window.outerHeight || (viewportHeight + 48);
        var chromeHeight = Math.max(0, currentOuterHeight - viewportHeight);
        var previousOverflow = document.body.style.overflowY;
        document.body.style.overflowY = "hidden";
        var contentHeight = Math.max(document.body.scrollHeight, document.documentElement.scrollHeight);
        var minimumHeight = Math.min(720, availableHeight);
        var desiredHeight = Math.min(availableHeight, Math.max(minimumHeight, contentHeight + chromeHeight + 4));

        window.resizeTo(desiredWidth, desiredHeight);
        window.moveTo(
            Math.max(0, (availableWidth - desiredWidth) / 2),
            Math.max(0, (availableHeight - desiredHeight) / 2)
        );
        document.body.style.overflowY = previousOverflow || "auto";
    } catch (ignoreSize) {
        document.body.style.overflowY = "auto";
    }
}

function tabButton(index, label) {
    var active = state.activeUiTab === index ? " active " + lower(state.mode) : "";
    return '<button class="tab' + active + '" data-tab-index="' + index +
        '" onclick="selectTab(' + index + ')">' + html(label) + '</button>';
}

function renderPersistent() {
    var out = '<div class="section"><div class="section-head"><span class="section-title">Persistent Paths</span>';
    if (state.mode === "Config") {
        out += '<button class="section-action" onclick="addPersistent()">+ Add file path</button>';
    }
    out += '</div><table class="data-table path-table"><colgroup>' +
        '<col style="width:40px"><col style="width:56px"><col style="width:56px"><col style="width:56px">' +
        '<col style="width:84px"><col><col style="width:20%"><col style="width:40px"></colgroup>' +
        '<thead><tr><th></th><th class="status-header status-admin">ADMIN</th>' +
        '<th class="status-header status-start">STARTUP</th><th class="status-header status-menu">MENU</th>' +
        '<th></th><th>File path</th><th>Environment variable</th><th></th></tr></thead><tbody>';
    var i, row;
    for (i = 0; i < state.persistent.length; i++) {
        row = state.persistent[i];
        out += '<tr>';
        if (state.mode === "Config") {
            out += '<td class="row-menu-cell"><button class="button button-small row-menu-button" id="persistentMenu_' + i +
                '" title="Row menu" onclick="return showPersistentRowMenu(' + i + ',this)"' +
                ' oncontextmenu="return showPersistentRowMenu(' + i + ',this)">&#9776;</button></td>';
            out += checkboxInput("persistent", "", i, "run_as_admin", row.run_as_admin);
            out += checkboxInput("persistent", "", i, "run_on_startup", row.run_on_startup);
            out += checkboxInput("persistent", "", i, "menu", row.menu);
            out += '<td><button class="button button-small path-browse-button" onclick="browsePersistent(' + i + ')" oncontextmenu="return showBrowseContextMenu(this)">Browse</button></td>';
            out += fieldInput("persistent", "", i, "path", row.path, 'data-pathcheck="1"');
            out += fieldInput("persistent", "", i, "env_var", row.env_var, "");
            out += '<td class="move-cell"><button class="button button-small" id="persistentMove_' + i +
                '" title="Left click: move down; right click: move up" onclick="movePersistent(' + i +
                ',1)" oncontextmenu="return movePersistentUp(' + i + ')">&#8597;</button></td>';
        } else {
            out += '<td></td>';
            out += adminPropertyMatchCell(row.path, row.run_as_admin);
            out += startupMatchCell(row.path, row.run_on_startup);
            out += menuPinMatchCell(row.path, row.menu);
            out += '<td></td>';
            out += readonlyCell(row.path, "pathcheck");
            out += readonlyCell(row.env_var, "");
            out += '<td></td>';
        }
        out += '</tr>';
    }
    out += '</tbody></table></div>';
    if (state.mode === "Apply") {
        out += '<div class="footer-actions"><button class="button button-apply-action" onclick="applyPaths()">APPLY PATHS</button></div>';
    }
    return out;
}

function renderProgram(tabIndex) {
    var name = state.tabs[tabIndex];
    var data = state.data[name];
    var out = renderProgramPaths(tabIndex, data.paths);
    out += renderLinksSection(tabIndex, data.links);
    out += renderNameValueSection(tabIndex, "envs", "Environment Variables", data.envs, false);
    out += renderExecSection(tabIndex, data.execs);
    return out;
}

function renderProgramPaths(tabIndex, rows) {
    var out = '<div class="section"><div class="section-head"><span class="section-title">Paths</span>';
    if (state.mode === "Config") {
        out += '<button class="section-action" onclick="addDynamicRow(' + tabIndex + ',\'paths\')">+ Add file path</button>';
    }
    out += '</div><table class="data-table path-table"><colgroup>' +
        '<col><col style="width:84px"><col style="width:20%">' +
        '<col style="width:56px"><col style="width:56px"><col style="width:56px"><col style="width:40px"></colgroup>' +
        '<thead><tr><th>File path</th><th></th><th>Environment variable</th>' +
        '<th class="status-header status-admin">ADMIN</th><th class="status-header status-start">STARTUP</th><th class="status-header status-menu">MENU</th><th></th></tr></thead><tbody>';
    var i, row;
    for (i = 0; i < rows.length; i++) {
        row = rows[i];
        out += '<tr>';
        if (state.mode === "Config") {
            out += fieldInput("dynamic", "paths", i, "path", row.path, 'data-tab="' + tabIndex + '" data-pathcheck="1"');
            out += '<td><button class="button button-small path-browse-button" onclick="browseDynamicPath(' + tabIndex + ',' + i + ')" oncontextmenu="return showBrowseContextMenu(this)">Browse</button></td>';
            out += fieldInput("dynamic", "paths", i, "env_var", row.env_var, 'data-tab="' + tabIndex + '"');
            out += checkboxInput("dynamic", "paths", i, "run_as_admin", row.run_as_admin, tabIndex);
            out += checkboxInput("dynamic", "paths", i, "run_on_startup", row.run_on_startup, tabIndex);
            out += checkboxInput("dynamic", "paths", i, "menu", row.menu, tabIndex);
            out += '<td>' + (i > 0 ? '<button class="button button-small button-danger" onclick="deleteDynamicRow(' +
                tabIndex + ',\'paths\',' + i + ')">X</button>' : '') + '</td>';
        } else {
            out += readonlyCell(row.path, "pathcheck");
            out += '<td></td>';
            out += readonlyCell(row.env_var, "");
            out += adminPropertyMatchCell(row.path, row.run_as_admin);
            out += startupMatchCell(row.path, row.run_on_startup);
            out += menuPinMatchCell(row.path, row.menu);
            out += '<td></td>';
        }
        out += '</tr>';
    }
    return out + '</tbody></table></div>';
}

function renderNameValueSection(tabIndex, kind, title, rows, keepFirst) {
    var out = '<div class="section"><div class="section-head"><span class="section-title">' + html(title) + '</span>';
    if (state.mode === "Config") {
        out += '<button class="section-action" onclick="addDynamicRow(' + tabIndex + ',\'' + kind + '\')">+ Add</button>';
    }
    out += '</div>';
    if (!rows.length) {
        out += '<div class="empty-state">&nbsp;</div></div>';
        return out;
    }
    out += '<table class="data-table program-table"><colgroup><col style="width:20%"><col>' +
        '<col style="width:100px"><col style="width:40px"></colgroup><thead><tr><th>Name</th><th>Value / path</th><th></th><th></th></tr></thead><tbody>';
    var i, row, check;
    for (i = 0; i < rows.length; i++) {
        row = rows[i];
        check = kind === "paths" ? 'data-pathcheck="1"' : 'data-smartcheck="1"';
        out += '<tr>';
        if (state.mode === "Config") {
            out += fieldInput("dynamic", kind, i, "name", row.name, 'data-tab="' + tabIndex + '"');
            out += fieldInput("dynamic", kind, i, "val", row.val, 'data-tab="' + tabIndex + '" ' + check);
            out += '<td class="row-action-pair"><button class="button button-small" onclick="browseDynamic(' + tabIndex + ',\'' + kind + '\',' + i + ',false)" oncontextmenu="return showBrowseContextMenu(this)">D</button>' +
                '<button class="button button-small" onclick="browseDynamic(' + tabIndex + ',\'' + kind + '\',' + i + ',true)" oncontextmenu="return showBrowseContextMenu(this)">F</button></td>';
            out += '<td>' + ((!keepFirst || i > 0) ? '<button class="button button-small button-danger" onclick="deleteDynamicRow(' +
                tabIndex + ',\'' + kind + '\',' + i + ')">X</button>' : '') + '</td>';
        } else {
            out += readonlyCell(row.name, kind === "envs" ? "envcheck" : "");
            out += readonlyCell(row.val, kind === "paths" ? "pathcheck" : "smartcheck");
            out += '<td></td><td></td>';
        }
        out += '</tr>';
    }
    out += '</tbody></table></div>';
    return out;
}

function renderExecSection(tabIndex, rows) {
    var out = '<div class="section"><div class="section-head"><span class="section-title">Executables</span>';
    if (state.mode === "Config") {
        out += '<button class="section-action" onclick="addDynamicRow(' + tabIndex + ',\'execs\')">+ Add</button>';
    }
    out += '</div>';
    if (!rows.length) {
        return out + '<div class="empty-state">&nbsp;</div></div>';
    }
    out += '<table class="data-table program-table"><colgroup><col><col style="width:100px"><col style="width:40px"></colgroup><tbody>';
    var i;
    for (i = 0; i < rows.length; i++) {
        out += '<tr>';
        if (state.mode === "Config") {
            out += '<td><input class="field" data-scope="dynamic" data-kind="execs" data-index="' + i +
                '" data-tab="' + tabIndex + '" data-field="value" data-pathcheck="1" value="' + html(rows[i]) + '"></td>';
            out += '<td class="row-action-pair"><button class="button button-small" onclick="browseDynamic(' + tabIndex + ',\'execs\',' + i + ',false)" oncontextmenu="return showBrowseContextMenu(this)">D</button>' +
                '<button class="button button-small" onclick="browseDynamic(' + tabIndex + ',\'execs\',' + i + ',true)" oncontextmenu="return showBrowseContextMenu(this)">F</button></td>';
            out += '<td><button class="button button-small button-danger" onclick="deleteDynamicRow(' + tabIndex + ',\'execs\',' + i + ')">X</button></td>';
        } else {
            out += readonlyCell(rows[i], "pathcheck") + '<td></td><td></td>';
        }
        out += '</tr>';
    }
    return out + '</tbody></table></div>';
}

function renderLinksSection(tabIndex, rows) {
    var out = '<div class="section"><div class="section-head"><span class="section-title">Links</span>';
    if (state.mode === "Config") {
        out += '<button class="section-action" onclick="addDynamicRow(' + tabIndex + ',\'links\')">+ Add</button>';
    }
    out += '</div>';
    if (!rows.length) {
        return out + '<div class="empty-state">&nbsp;</div></div>';
    }
    if (state.mode === "Config") {
        out += '<table class="data-table program-table"><colgroup><col><col style="width:100px"><col>' +
            '<col style="width:50px"><col style="width:15%"><col style="width:130px"><col style="width:40px"><col style="width:40px"></colgroup>' +
            '<thead><tr><th>Source</th><th></th><th>Link folder</th><th></th><th>Link name</th><th>Type</th><th></th><th></th></tr></thead><tbody>';
    } else {
        out += '<table class="data-table program-table links-apply-table"><colgroup><col><col><col style="width:130px"></colgroup>' +
            '<thead><tr><th>Source</th><th>Link path</th><th>Type</th></tr></thead><tbody>';
    }
    var i, row, target, sameDirectory;
    for (i = 0; i < rows.length; i++) {
        row = rows[i];
        out += '<tr>';
        if (state.mode === "Config") {
            out += fieldInput("dynamic", "links", i, "src", row.src, 'data-tab="' + tabIndex + '" data-pathcheck="1" data-linkdirectorycheck="1"');
            out += '<td class="row-action-pair"><button class="button button-small" onclick="browseLinkSource(' + tabIndex + ',' + i + ',false)" oncontextmenu="return showBrowseContextMenu(this)">D</button>' +
                '<button class="button button-small" onclick="browseLinkSource(' + tabIndex + ',' + i + ',true)" oncontextmenu="return showBrowseContextMenu(this)">F</button></td>';
            out += fieldInput("dynamic", "links", i, "tgt_dir", row.tgt_dir, 'data-tab="' + tabIndex + '" data-pathcheck="1" data-linkdirectorycheck="1"');
            out += '<td><button class="button button-small" onclick="browseLinkTarget(' + tabIndex + ',' + i + ')" oncontextmenu="return showBrowseContextMenu(this)">D</button></td>';
            out += fieldInput("dynamic", "links", i, "tgt_name", row.tgt_name, 'data-tab="' + tabIndex + '"');
            out += '<td><select class="field" data-scope="dynamic" data-kind="links" data-index="' + i +
                '" data-tab="' + tabIndex + '" data-field="type">' +
                option("Shortcut", row.type) + option("Symlink", row.type) + option("Hardlink", row.type) + '</select></td>';
            out += '<td><button class="button button-small button-danger" onclick="deleteDynamicRow(' + tabIndex + ',\'links\',' + i + ')">X</button></td>';
            out += '<td class="move-cell"><button class="button button-small" id="linkMove_' + tabIndex + '_' + i +
                '" title="Left click: move down; right click: move up" onclick="moveDynamicLink(' + tabIndex + ',' + i +
                ',1)" oncontextmenu="return moveDynamicLinkUp(' + tabIndex + ',' + i + ')">&#8597;</button></td>';
        } else {
            target = joinPath(row.tgt_dir, row.tgt_name + (row.type === "Shortcut" && !/\.lnk$/i.test(row.tgt_name) ? ".lnk" : ""));
            sameDirectory = linkDirectoriesAreSame(row.src, row.tgt_dir);
            out += readonlyCell(row.src, sameDirectory ? "same-directory" : "pathcheck") +
                readonlyCell(target, sameDirectory ? "same-directory" : "") + readonlyCell(row.type, "");
        }
        out += '</tr>';
    }
    return out + '</tbody></table></div>';
}

function fieldInput(scope, kind, index, field, value, extra) {
    var className = field === "path" ? "field path-field" : "field";
    return '<td><input class="' + className + '" data-scope="' + scope + '" data-kind="' + kind +
        '" data-index="' + index + '" data-field="' + field + '" ' + extra + ' value="' + html(value) + '"></td>';
}

function checkboxInput(scope, kind, index, field, checked, tabIndex) {
    var tabAttribute = typeof tabIndex === "number" ? ' data-tab="' + tabIndex + '"' : "";
    var tooltip = checkboxTooltip(field);
    return '<td><label class="check-wrap" title="' + html(tooltip) + '"><input type="checkbox" title="' +
        html(tooltip) + '" data-scope="' + scope + '" data-kind="' + kind + '" data-index="' + index +
        '" data-field="' + field + '"' + tabAttribute + (checked ? ' checked="checked"' : '') +
        '></label></td>';
}

function checkboxTooltip(field) {
    if (field === "run_as_admin") {
        return "Run this executable as administrator";
    }
    if (field === "run_on_startup") {
        return "Run this executable when you sign in";
    }
    if (field === "menu") {
        return "Create or verify this executable or shortcut in the Start11 menu";
    }
    return "";
}

function readonlyCell(value, checkType) {
    var className = "readonly";
    if (checkType === "same-directory") {
        className += " same-directory";
    } else if (checkType === "pathcheck" && trimText(value)) {
        className += pathExists(value) ? " valid" : " invalid";
    } else if (checkType === "smartcheck" && looksLikePath(value)) {
        className += pathExists(value) ? " valid" : " invalid";
    } else if (checkType === "envcheck" && trimText(value)) {
        className += environmentExists(value) ? " valid" : " invalid";
    }
    return '<td><div class="' + className + '" title="' + html(value) + '">' + (html(value) || '&nbsp;') + '</div></td>';
}

function yesNoCell(value) {
    return booleanStatusCell(value, value ? "yes" : "no", "");
}

function startupCommandTarget(command) {
    command = trimText(wsh.ExpandEnvironmentStrings(String(command || "")));
    if (!command) {
        return "";
    }
    var elevated = /Start-Process\s+-FilePath\s+'((?:''|[^'])*)'/i.exec(command);
    if (elevated) {
        return elevated[1].replace(/''/g, "'");
    }
    if (command.charAt(0) === '"') {
        var closingQuote = command.indexOf('"', 1);
        return closingQuote > 1 ? command.substring(1, closingQuote) : "";
    }
    var executable = /^(.+?\.(?:exe|com|bat|cmd|lnk))(?=\s|$)/i.exec(command);
    return executable ? trimText(executable[1]) : "";
}

function startupTargetKey(path) {
    path = expandPathVariables(path);
    if (!path) {
        return "";
    }
    if (lower(fso.GetExtensionName(path)) === "lnk") {
        var details = start11ShortcutDetails(path);
        if (details) {
            path = details.target_path;
        }
    }
    return normalizedStart11Path(path);
}

function startupCommandTargetKey(command) {
    return startupTargetKey(startupCommandTarget(command));
}

function readUserRunEntries() {
    if (startupStateCache === null) {
        startupStateCache = {run_entries: null, approvals: {}};
    }
    if (startupStateCache.run_entries !== null) {
        return startupStateCache.run_entries;
    }
    var regExe = wsh.ExpandEnvironmentStrings("%SystemRoot%") + "\\System32\\reg.exe";
    var output = runCapture(quoteArg(regExe) + " query " +
        quoteArg("HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Run"));
    var lines = output.split(/\r?\n/);
    var entries = [];
    var i, match;
    for (i = 0; i < lines.length; i++) {
        match = /^\s*(.*?)\s+REG_(SZ|EXPAND_SZ)\s+(.+)$/i.exec(lines[i]);
        if (match && trimText(match[1]) && trimText(match[3])) {
            entries.push({
                name: trimText(match[1]),
                type: "REG_" + String(match[2]).toUpperCase(),
                command: trimText(match[3])
            });
        }
    }
    startupStateCache.run_entries = entries;
    return entries;
}

function matchingStartupEntries(path, excludeOwned) {
    var targetKey = startupTargetKey(path);
    var entries = readUserRunEntries();
    var matches = [];
    var i;
    if (!targetKey) {
        return matches;
    }
    for (i = 0; i < entries.length; i++) {
        if ((!excludeOwned || !isOwnedStartupName(entries[i].name)) &&
                startupCommandTargetKey(entries[i].command) === targetKey) {
            matches.push(entries[i]);
        }
    }
    return matches;
}

function readStartupApprovalState(name) {
    if (startupStateCache === null) {
        startupStateCache = {run_entries: null, approvals: {}};
    }
    var key = lower(name);
    if (Object.prototype.hasOwnProperty.call(startupStateCache.approvals, key)) {
        return startupStateCache.approvals[key];
    }
    var regExe = wsh.ExpandEnvironmentStrings("%SystemRoot%") + "\\System32\\reg.exe";
    var output = runCapture(quoteArg(regExe) + " query " + quoteArg(STARTUP_APPROVED_KEY) +
        " /v " + quoteArg(name));
    var match = /REG_BINARY\s+([0-9a-f]+)/i.exec(output);
    var stateInfo;
    if (!match) {
        stateInfo = {exists: false, enabled: true, data: ""};
    } else {
        var data = String(match[1]).toUpperCase();
        stateInfo = {exists: true, enabled: data.substr(0, 2) !== "03", data: data};
    }
    startupStateCache.approvals[key] = stateInfo;
    return stateInfo;
}

function startupStateForPath(path) {
    var matches = matchingStartupEntries(path, true);
    if (!matches.length) {
        matches = matchingStartupEntries(path, false);
    }
    if (matches.length > 1) {
        return {found: true, ambiguous: true, enabled: false, name: ""};
    }
    if (!matches.length) {
        return {found: false, ambiguous: false, enabled: false, name: ""};
    }
    var approval = readStartupApprovalState(matches[0].name);
    return {
        found: true,
        ambiguous: false,
        enabled: approval.enabled,
        name: matches[0].name
    };
}

function findExistingStartupEntry(path) {
    var matches = matchingStartupEntries(path, true);
    return {
        found: matches.length === 1,
        ambiguous: matches.length > 1,
        entry: matches.length === 1 ? matches[0] : null,
        count: matches.length
    };
}

function startupMatchCell(path, expected) {
    if (!trimText(path)) {
        return booleanStatusCell(false, "no", "No path configured");
    }
    var actual = startupStateForPath(path);
    if (actual.ambiguous) {
        return booleanStatusCell(false, "mismatch",
            "Multiple Windows Startup Apps entries match this executable");
    }
    var matches = actual.enabled === (expected ? true : false);
    var detail = "Configured: " + (expected ? "On" : "Off") +
        "; Windows Startup Apps: " + (actual.enabled ? "On" : "Off") +
        (actual.name ? " (" + actual.name + ")" : " (entry not found)");
    return booleanStatusCell(expected ? true : false, matches ? "yes" : "mismatch", detail);
}
function booleanStatusCell(value, statusClass, title) {
    var symbol = value ? (statusClass === "mismatch" ? "&#10008;" : "&#10004;") : "&nbsp;";
    var titleAttribute = title ? ' title="' + html(title) + '"' : "";
    return '<td><div class="readonly boolean-status ' + statusClass + '"' + titleAttribute + '>' + symbol + '</div></td>';
}

function adminPropertyMatchCell(path, expected) {
    if (!trimText(path)) {
        return booleanStatusCell(false, "no", "No path configured");
    }
    var actual = hasRunAsAdminProperty(path);
    var matches = actual === (expected ? true : false);
    var detail = "Configured: " + (expected ? "Yes" : "No") +
        "; Windows property: " + (actual ? "Yes" : "No");
    return booleanStatusCell(expected, matches ? "yes" : "mismatch", detail);
}

function start11ShortcutDetails(path) {
    path = expandPathVariables(path);
    if (!path || !fso.FileExists(path) || lower(fso.GetExtensionName(path)) !== "lnk") {
        return null;
    }
    try {
        var shortcut = wsh.CreateShortcut(path);
        var targetPath = expandPathVariables(shortcut.TargetPath);
        if (!targetPath || !pathExists(targetPath)) {
            return null;
        }
        var arguments = trimText(shortcut.Arguments);
        return {
            shortcut_path: path,
            target_path: targetPath,
            arguments: arguments,
            signature: normalizedStart11Path(targetPath) + "\n" + arguments
        };
    } catch (ignoreShortcutDetails) {
        return null;
    }
}

function start11MenuSourceInfo(path) {
    path = expandPathVariables(path);
    if (!path || !pathExists(path)) {
        return null;
    }
    var extension = lower(fso.GetExtensionName(path));
    if (extension === "exe") {
        return {
            shortcut_path: "",
            target_path: path,
            arguments: "",
            signature: normalizedStart11Path(path) + "\n"
        };
    }
    if (extension === "lnk") {
        return start11ShortcutDetails(path);
    }
    return null;
}

function resolveRunAsAdminPath(path) {
    path = expandPathVariables(path);
    if (lower(fso.GetExtensionName(path)) === "lnk") {
        var sourceInfo = start11MenuSourceInfo(path);
        if (sourceInfo && lower(fso.GetExtensionName(sourceInfo.target_path)) === "exe") {
            return sourceInfo.target_path;
        }
    }
    return path;
}

function hasRunAsAdminProperty(path) {
    path = resolveRunAsAdminPath(path);
    if (!path) {
        return false;
    }
    var current = readRunAsAdminFlags(path);
    if (!current.exists) {
        return false;
    }
    var tokens = trimText(current.value) ? trimText(current.value).split(/\s+/) : [];
    var i;
    for (i = 0; i < tokens.length; i++) {
        if (lower(trimText(tokens[i])) === "runasadmin") {
            return true;
        }
    }
    return false;
}

function menuPinMatchCell(path, expected) {
    var sourceInfo = start11MenuSourceInfo(path);
    if (!sourceInfo) {
        return booleanStatusCell(false, "mismatch", "Menu requires an existing .exe or .lnk with an existing target");
    }
    var pinned = isStart11MenuSourcePinned(path);
    var detail = "Configured: " + (expected ? "Yes" : "No") + "; actual Start11 pin: " +
        (pinned ? "Yes" : "No");
    return booleanStatusCell(pinned, pinned ? "yes" : "mismatch", detail);
}

function normalizedStart11Path(path) {
    path = trimText(expandPathVariables(path)).replace(/^"|"$/g, "").replace(/\//g, "\\");
    if (!path) {
        return "";
    }
    try {
        path = fso.GetAbsolutePathName(path);
    } catch (ignoreAbsolutePath) {}
    return lower(path.replace(/\\+$/, ""));
}

function readStart11PinValues(registryKey) {
    var regExe = wsh.ExpandEnvironmentStrings("%SystemRoot%") + "\\System32\\reg.exe";
    var output = runCapture(quoteArg(regExe) + " query " + quoteArg(registryKey));
    var lines = output.split(/\r?\n/);
    var values = [];
    var i, match, data, separator;
    for (i = 0; i < lines.length; i++) {
        match = /^\s*(\d+)\s+REG_(?:SZ|EXPAND_SZ)\s+(.+)$/i.exec(lines[i]);
        if (match) {
            data = trimText(match[2]);
            separator = data.indexOf("|");
            values.push({
                name: match[1],
                data: data,
                shortcut_path: trimText(separator >= 0 ? data.substr(0, separator) : data)
            });
        }
    }
    return values;
}

function readStart11PinTreeValues(registryRoot) {
    var regExe = wsh.ExpandEnvironmentStrings("%SystemRoot%") + "\\System32\\reg.exe";
    var output = runCapture(quoteArg(regExe) + " query " + quoteArg(registryRoot) + " /s");
    var lines = output.split(/\r?\n/);
    var values = [];
    var currentKey = "";
    var i, line, match, data, separator;
    for (i = 0; i < lines.length; i++) {
        line = trimText(lines[i]);
        if (/^HKEY_CURRENT_USER\\/i.test(line)) {
            currentKey = "HKCU\\" + line.substr(18);
            continue;
        }
        match = /^\s*(\d+)\s+REG_(?:SZ|EXPAND_SZ)\s+(.+)$/i.exec(lines[i]);
        if (currentKey && match) {
            data = trimText(match[2]);
            separator = data.indexOf("|");
            values.push({
                registry_key: currentKey,
                name: match[1],
                data: data,
                shortcut_path: trimText(separator >= 0 ? data.substr(0, separator) : data)
            });
        }
    }
    return values;
}

function getStart11PinRecords() {
    if (start11PinCache !== null) {
        return start11PinCache;
    }
    start11PinCache = {targets: {}, signatures: {}, shortcuts: {}};
    var i, j, values, shortcutPath, details, shortcutKey, targetKey;
    for (i = 0; i < START11_PIN_ROOTS.length; i++) {
        values = readStart11PinTreeValues(START11_PIN_ROOTS[i]);
        for (j = 0; j < values.length; j++) {
            shortcutPath = values[j].shortcut_path;
            shortcutKey = normalizedStart11Path(shortcutPath);
            if (shortcutKey) {
                start11PinCache.shortcuts[shortcutKey] = shortcutPath;
            }
            details = start11ShortcutDetails(shortcutPath);
            if (!details) {
                continue;
            }
            targetKey = normalizedStart11Path(details.target_path);
            if (targetKey) {
                start11PinCache.targets[targetKey] = shortcutPath;
            }
            if (details.signature) {
                start11PinCache.signatures[details.signature] = shortcutPath;
            }
        }
    }
    return start11PinCache;
}

function isStart11TargetPinned(path) {
    var targetKey = normalizedStart11Path(path);
    return targetKey && getStart11PinRecords().targets[targetKey] ? true : false;
}

function isStart11MenuSourcePinned(path) {
    var sourceInfo = start11MenuSourceInfo(path);
    return sourceInfo && getStart11PinRecords().signatures[sourceInfo.signature] ? true : false;
}

function ensureStart11Folder(path) {
    if (fso.FolderExists(path)) {
        return true;
    }
    var parent = fso.GetParentFolderName(path);
    if (parent && parent !== path && !fso.FolderExists(parent) && !ensureStart11Folder(parent)) {
        return false;
    }
    try {
        fso.CreateFolder(path);
        return true;
    } catch (ignoreFolderCreate) {
        return fso.FolderExists(path);
    }
}

function start11ShortcutTarget(path) {
    var details = start11ShortcutDetails(path);
    return details ? details.target_path : "";
}

function start11ShortcutSignature(path) {
    var details = start11ShortcutDetails(path);
    return details ? details.signature : "";
}

function canonicalStart11ShortcutPath(sourceInfo) {
    var directory = wsh.ExpandEnvironmentStrings(START11_PIN_DIRECTORY);
    if (!ensureStart11Folder(directory)) {
        return "";
    }
    var namingPath = sourceInfo.shortcut_path || sourceInfo.target_path;
    var baseName = fso.GetBaseName(namingPath).replace(/[\\\/:*?"<>|]/g, "_") || "Path-Config";
    return fso.BuildPath(directory, baseName + ".lnk");
}

function cleanupStart11ShortcutConflicts(sourceInfo, shortcutPath, result, rowLabel) {
    var directory = wsh.ExpandEnvironmentStrings(START11_PIN_DIRECTORY);
    var canonicalKey = normalizedStart11Path(shortcutPath);
    var deletePaths = [];
    var deleteKeys = {};
    var i, j, file, filePath, fileKey, fileSignature, files, values, valueKey;

    if (fso.FolderExists(directory)) {
        files = new Enumerator(fso.GetFolder(directory).Files);
        for (; !files.atEnd(); files.moveNext()) {
            file = files.item();
            filePath = String(file.Path);
            if (lower(fso.GetExtensionName(filePath)) !== "lnk") {
                continue;
            }
            fileKey = normalizedStart11Path(filePath);
            fileSignature = start11ShortcutSignature(filePath);
            if ((fileKey === canonicalKey && fileSignature !== sourceInfo.signature) ||
                    (fileKey !== canonicalKey && fileSignature === sourceInfo.signature)) {
                deletePaths.push(filePath);
                deleteKeys[fileKey] = true;
            }
        }
    }
    if (!fso.FileExists(shortcutPath)) {
        deleteKeys[canonicalKey] = true;
    }

    var removedRegistrations = 0;
    var registryDeleteFailed = false;
    for (i = 0; i < START11_PIN_ROOTS.length; i++) {
        values = readStart11PinTreeValues(START11_PIN_ROOTS[i]);
        for (j = 0; j < values.length; j++) {
            valueKey = normalizedStart11Path(values[j].shortcut_path);
            if (!deleteKeys[valueKey]) {
                continue;
            }
            try {
                wsh.RegDelete(values[j].registry_key + "\\" + values[j].name);
                removedRegistrations++;
            } catch (errorConflictRegistration) {
                registryDeleteFailed = true;
                persistentError(result, rowLabel + " could not remove a conflicting Start11 registration: " +
                    errorConflictRegistration.message);
            }
        }
    }
    if (registryDeleteFailed) {
        start11PinCache = null;
        return false;
    }

    var deletedShortcuts = 0;
    for (i = 0; i < deletePaths.length; i++) {
        try {
            fso.DeleteFile(deletePaths[i], false);
            deletedShortcuts++;
        } catch (errorConflictShortcut) {
            persistentError(result, rowLabel + " could not delete the conflicting Start11 shortcut: " +
                deletePaths[i] + ": " + errorConflictShortcut.message);
            start11PinCache = null;
            return false;
        }
    }

    start11PinCache = null;
    if (removedRegistrations || deletedShortcuts) {
        result.menu_removed_count++;
        appendLog("Removed conflicting or duplicate Start11 shortcut state for " + shortcutPath +
            " (registry=" + removedRegistrations + ", shortcuts=" + deletedShortcuts + ")", false);
    }
    return true;
}

function createStart11Shortcut(shortcutPath, targetPath) {
    try {
        var shortcut = wsh.CreateShortcut(shortcutPath);
        shortcut.TargetPath = targetPath;
        shortcut.WorkingDirectory = fso.GetParentFolderName(targetPath);
        shortcut.IconLocation = targetPath + ",0";
        shortcut.Description = "Pinned by Path-Config";
        shortcut.WindowStyle = 1;
        shortcut.Save();
        return fso.FileExists(shortcutPath);
    } catch (ignoreShortcutCreate) {
        return false;
    }
}

function copyStart11Shortcut(sourcePath, shortcutPath) {
    if (normalizedStart11Path(sourcePath) === normalizedStart11Path(shortcutPath)) {
        return true;
    }
    try {
        fso.CopyFile(sourcePath, shortcutPath, false);
        return fso.FileExists(shortcutPath);
    } catch (ignoreShortcutCopy) {
        return false;
    }
}

function start11GroupContainsSignature(values, signature) {
    var i, shortcutPath;
    for (i = 0; i < values.length; i++) {
        shortcutPath = values[i].shortcut_path;
        if (lower(fso.GetExtensionName(shortcutPath)) === "lnk" && pathExists(shortcutPath) &&
                start11ShortcutSignature(shortcutPath) === signature) {
            return true;
        }
    }
    return false;
}

function start11GroupContainsTarget(values, targetPath) {
    return start11GroupContainsSignature(values, normalizedStart11Path(targetPath) + "\n");
}

function start11TreeContainsSignature(registryRoot, signature, excludedKey) {
    var values = readStart11PinTreeValues(registryRoot);
    var i;
    for (i = 0; i < values.length; i++) {
        if (excludedKey && lower(values[i].registry_key) === lower(excludedKey)) {
            continue;
        }
        if (start11ShortcutSignature(values[i].shortcut_path) === signature) {
            return true;
        }
    }
    return false;
}

function removeStart11MenuPin(path, result, rowLabel) {
    path = expandPathVariables(path);
    var sourceInfo = start11MenuSourceInfo(path);
    if (!sourceInfo) {
        return;
    }
    start11PinCache = null;
    var i, j, values, removed = 0;
    var removalFailed = false;
    for (i = 0; i < START11_PIN_ROOTS.length; i++) {
        values = readStart11PinTreeValues(START11_PIN_ROOTS[i]);
        for (j = 0; j < values.length; j++) {
            if (start11ShortcutSignature(values[j].shortcut_path) !== sourceInfo.signature) {
                continue;
            }
            try {
                wsh.RegDelete(values[j].registry_key + "\\" + values[j].name);
                removed++;
            } catch (errorPinDelete) {
                removalFailed = true;
                persistentError(result, rowLabel + " could not remove a Start11 registration: " + errorPinDelete.message);
            }
        }
    }

    var directory = wsh.ExpandEnvironmentStrings(START11_PIN_DIRECTORY);
    var deletedShortcuts = 0;
    var matchingShortcuts = [];
    if (fso.FolderExists(directory)) {
        var files = new Enumerator(fso.GetFolder(directory).Files);
        var file, shortcutPath;
        for (; !files.atEnd(); files.moveNext()) {
            file = files.item();
            shortcutPath = String(file.Path);
            if (lower(fso.GetExtensionName(shortcutPath)) === "lnk" &&
                    start11ShortcutSignature(shortcutPath) === sourceInfo.signature) {
                matchingShortcuts.push(shortcutPath);
            }
        }
        for (i = 0; i < matchingShortcuts.length; i++) {
            try {
                fso.DeleteFile(matchingShortcuts[i], false);
                deletedShortcuts++;
            } catch (errorShortcutDelete) {
                removalFailed = true;
                persistentError(result, rowLabel + " could not delete the Start11 shortcut: " + errorShortcutDelete.message);
            }
        }
    }

    start11PinCache = null;
    if (isStart11MenuSourcePinned(path)) {
        persistentError(result, rowLabel + " Start11 removal verification failed: " + path);
        return;
    }
    if (removalFailed) {
        return;
    }
    result.menu_removed_count++;
    persistentSuccess(result, removed || deletedShortcuts ?
        "Start11 menu shortcut removed: " + path + " (registry=" + removed + ", shortcuts=" + deletedShortcuts + ")" :
        "Start11 menu shortcut already absent: " + path);
}

function nextStart11ValueName(values) {
    var maximum = -1;
    var i, value;
    for (i = 0; i < values.length; i++) {
        value = parseInt(values[i].name, 10);
        if (!isNaN(value) && value > maximum) {
            maximum = value;
        }
    }
    return String(maximum + 1);
}

function ensureStart11MenuPin(path, runAsAdmin, result, rowLabel) {
    path = expandPathVariables(path);
    start11PinCache = null;
    var sourceInfo = start11MenuSourceInfo(path);
    if (!sourceInfo) {
        persistentError(result, rowLabel + " Menu requires an existing .exe or .lnk with an existing target: " + path);
        return;
    }
    if (runAsAdmin && lower(fso.GetExtensionName(sourceInfo.target_path)) !== "exe") {
        persistentError(result, rowLabel + " Menu administrator launch requires the shortcut to target an .exe file: " + path);
        return;
    }
    if (runAsAdmin && !hasRunAsAdminProperty(sourceInfo.target_path)) {
        persistentError(result, rowLabel + " Menu shortcut cannot run as administrator because the administrator property was not set: " + sourceInfo.target_path);
        return;
    }

    var shortcutPath = canonicalStart11ShortcutPath(sourceInfo);
    if (!shortcutPath) {
        persistentError(result, rowLabel + " could not select a Start11 shortcut path: " + path);
        return;
    }
    if (!cleanupStart11ShortcutConflicts(sourceInfo, shortcutPath, result, rowLabel)) {
        return;
    }

    var shortcutCreated = false;
    if (!fso.FileExists(shortcutPath) || start11ShortcutSignature(shortcutPath) !== sourceInfo.signature) {
        if (sourceInfo.shortcut_path) {
            if (!copyStart11Shortcut(sourceInfo.shortcut_path, shortcutPath)) {
                persistentError(result, rowLabel + " could not copy the Start11 shortcut: " + path);
                return;
            }
        } else if (!createStart11Shortcut(shortcutPath, sourceInfo.target_path)) {
            persistentError(result, rowLabel + " could not create the Start11 shortcut: " + path);
            return;
        }
        shortcutCreated = true;
    }

    var pinnedTreeHasShortcut = start11TreeContainsSignature(START11_PIN_ROOTS[0], sourceInfo.signature, "") ||
        start11TreeContainsSignature(START11_PIN_ROOTS[1], sourceInfo.signature, START11_PIN_GROUPS[1].key);
    var i, values, valueName, registryWrites = 0;
    for (i = 0; i < START11_PIN_GROUPS.length; i++) {
        values = readStart11PinValues(START11_PIN_GROUPS[i].key);
        if (!(i === 0 && pinnedTreeHasShortcut) && !start11GroupContainsSignature(values, sourceInfo.signature)) {
            valueName = nextStart11ValueName(values);
            try {
                wsh.RegWrite(START11_PIN_GROUPS[i].key + "\\" + valueName,
                    shortcutPath + START11_PIN_GROUPS[i].suffix, "REG_SZ");
                registryWrites++;
            } catch (errorPinWrite) {
                persistentError(result, rowLabel + " could not register the Start11 shortcut: " + errorPinWrite.message);
                return;
            }
        }
    }

    start11PinCache = null;
    if (!isStart11MenuSourcePinned(path)) {
        persistentError(result, rowLabel + " Start11 shortcut verification failed: " + path);
        return;
    }
    result.menu_pin_count++;
    if (shortcutCreated) {
        result.menu_created_count++;
    }
    persistentSuccess(result, "Start11 menu shortcut ready" +
        (runAsAdmin ? " with administrator launch" : "") + ": " + shortcutPath +
        (registryWrites ? " (" + registryWrites + " registry entr" + (registryWrites === 1 ? "y" : "ies") + " added)" : ""));
}
function option(value, selected) {
    return '<option value="' + value + '"' + (value === selected ? ' selected="selected"' : '') + '>' + value + '</option>';
}

function looksLikePath(value) {
    value = expandPathVariables(value);
    return /^[A-Za-z]:\\/.test(value) || /^\\\\/.test(value);
}

function environmentExists(name) {
    name = trimText(name);
    if (!name) {
        return false;
    }
    var configured = configuredEnvironmentVariables();
    if (Object.prototype.hasOwnProperty.call(configured, environmentVariableKey(name))) {
        return true;
    }
    try {
        return wsh.ExpandEnvironmentStrings("%" + name + "%") !== "%" + name + "%";
    } catch (ignore) {
        return false;
    }
}

function normalizedDirectoryPath(path) {
    path = expandPathVariables(path);
    if (!path) {
        return "";
    }
    try {
        path = fso.GetAbsolutePathName(path);
    } catch (ignoreAbsolutePath) {}
    path = path.replace(/\//g, "\\");
    while (/\\$/.test(path) && !/^[A-Za-z]:\\$/.test(path)) {
        path = path.substr(0, path.length - 1);
    }
    return lower(path);
}

function linkDirectoriesAreSame(source, linkDirectory) {
    source = expandPathVariables(source);
    linkDirectory = expandPathVariables(linkDirectory);
    if (!source || !linkDirectory) {
        return false;
    }
    try {
        return normalizedDirectoryPath(fso.GetParentFolderName(source)) ===
            normalizedDirectoryPath(linkDirectory);
    } catch (ignoreLinkDirectoryComparison) {
        return false;
    }
}

function linkInputDirectoriesAreSame(input) {
    if (input.getAttribute("data-kind") !== "links") {
        return false;
    }
    var tabIndex = asNumber(input.getAttribute("data-tab"), -1);
    var index = asNumber(input.getAttribute("data-index"), -1);
    if (tabIndex < 0 || !state.tabs[tabIndex]) {
        return false;
    }
    var rows = state.data[state.tabs[tabIndex]].links;
    if (!rows[index]) {
        return false;
    }
    var field = input.getAttribute("data-field");
    var source = field === "src" ? input.value : rows[index].src;
    var linkDirectory = field === "tgt_dir" ? input.value : rows[index].tgt_dir;
    return linkDirectoriesAreSame(source, linkDirectory);
}
function validateInputs() {
    var inputs = document.getElementsByTagName("input");
    var i, value, className;
    for (i = 0; i < inputs.length; i++) {
        value = trimText(inputs[i].value);
        className = inputs[i].className.indexOf("path-field") >= 0 ? "field path-field" : "field";
        if (inputs[i].getAttribute("data-pathcheck") === "1" && value) {
            className += pathExists(value) ? " valid" : " invalid";
        } else if (inputs[i].getAttribute("data-smartcheck") === "1" && looksLikePath(value)) {
            className += pathExists(value) ? " valid" : " invalid";
        }
        if (inputs[i].getAttribute("data-linkdirectorycheck") === "1" &&
                linkInputDirectoriesAreSame(inputs[i])) {
            className += " same-directory";
        }
        if (inputs[i].className.indexOf("field") >= 0) {
            inputs[i].className = className;
        }
    }
}

function setStatus(message) {
    var target = document.getElementById("status");
    if (target) {
        target.innerText = message;
    }
}

function selectTab(index) {
    captureState();
    state.activeUiTab = index;
    if (index > 0) {
        state.activeProgramTab = index - 1;
    }
    render(true);
}

function toggleMode() {
    captureState();
    if (state.mode === "Config") {
        if (hasUnsavedChanges && !saveState(false, true)) {
            setStatus("Could not enter Apply mode because state could not be saved.");
            return;
        }
        state.mode = "Apply";
    } else {
        state.mode = "Config";
    }
    render();
}

function addPersistent() {
    captureState();
    state.persistent.push({path: "", env_var: "", run_as_admin: 0, run_on_startup: 0, menu: 0});
    state.activeUiTab = 0;
    markDirty();
    render();
}

function deletePersistent(index) {
    if (index <= 0) {
        return;
    }
    captureState();
    state.persistent.splice(index, 1);
    markDirty();
    render();
}

function movePersistent(index, direction) {
    var cursorState = null;
    var eventObject = typeof window !== "undefined" ? window.event : null;
    var source = eventObject ? eventObject.srcElement : null;
    if (source && source.getBoundingClientRect && typeof eventObject.screenX === "number") {
        var sourceRect = source.getBoundingClientRect();
        cursorState = {
            screen_x: eventObject.screenX,
            screen_y: eventObject.screenY,
            control_left: sourceRect.left,
            control_top: sourceRect.top,
            window_left: typeof window.screenLeft === "number" ? window.screenLeft : 0,
            window_top: typeof window.screenTop === "number" ? window.screenTop : 0
        };
    }
    captureState();
    var targetIndex = index + direction;
    if (index < 0 || index >= state.persistent.length ||
            targetIndex < 0 || targetIndex >= state.persistent.length) {
        return;
    }
    var row = state.persistent[index];
    state.persistent[index] = state.persistent[targetIndex];
    state.persistent[targetIndex] = row;
    markDirty();
    render();
    queuePersistentMoveCursor(targetIndex, cursorState);
}

function movePersistentUp(index) {
    var eventObject = typeof window !== "undefined" ? window.event : null;
    movePersistent(index, -1);
    if (eventObject) {
        eventObject.returnValue = false;
    }
    return false;
}

function queuePersistentMoveCursor(index, cursorState) {
    if (!cursorState || typeof window === "undefined") {
        return;
    }
    window.setTimeout(function() {
        var target = document.getElementById("persistentMove_" + index);
        if (!target || !target.getBoundingClientRect) {
            return;
        }
        var targetRect = target.getBoundingClientRect();
        var currentWindowLeft = typeof window.screenLeft === "number" ? window.screenLeft : 0;
        var currentWindowTop = typeof window.screenTop === "number" ? window.screenTop : 0;
        var x = Math.round(cursorState.screen_x + currentWindowLeft - cursorState.window_left +
            targetRect.left - cursorState.control_left);
        var y = Math.round(cursorState.screen_y + currentWindowTop - cursorState.window_top +
            targetRect.top - cursorState.control_top);
        var command = 'powershell.exe -NoProfile -WindowStyle Hidden -Command "' +
            'Add-Type -AssemblyName System.Windows.Forms;' +
            '[System.Windows.Forms.Cursor]::Position=(New-Object System.Drawing.Point -ArgumentList ' +
            x + ',' + y + ')"';
        try {
            wsh.Run(command, 0, false);
        } catch (ignoreCursorMove) {}
    }, 60);
}

function persistentTabName(row) {
    var baseName = "";
    var path = expandPathVariables(row.path);
    if (path) {
        try {
            baseName = trimText(fso.GetBaseName(path));
        } catch (ignoreBaseName) {}
    }
    if (!baseName) {
        baseName = trimText(row.env_var) || "PROGRAM";
    }
    baseName = baseName.replace(/[\|\[\]\r\n]/g, "_");
    if (lower(baseName) === "paths" || lower(baseName) === "common") {
        baseName += "_Program";
    }
    var candidate = baseName;
    var suffix = 2;
    while (tabNameExists(candidate, -1)) {
        candidate = baseName + "_" + suffix;
        suffix++;
    }
    return candidate;
}

function movePersistentToNewTab(index) {
    captureState();
    if (index < 0 || index >= state.persistent.length) {
        return;
    }
    var row = state.persistent[index];
    var tabName = persistentTabName(row);
    state.tabs.push(tabName);
    state.data[tabName] = {
        paths: [{
            path: row.path,
            env_var: row.env_var,
            run_as_admin: row.run_as_admin ? 1 : 0,
            run_on_startup: row.run_on_startup ? 1 : 0,
            menu: row.menu ? 1 : 0
        }],
        envs: [],
        execs: [],
        links: []
    };
    state.persistent.splice(index, 1);
    if (!state.persistent.length) {
        state.persistent.push({path: "", env_var: "", run_as_admin: 0, run_on_startup: 0, menu: 0});
    }
    state.activeProgramTab = state.tabs.length - 1;
    state.activeUiTab = state.activeProgramTab + 1;
    markDirty();
    render();
}

function browsePersistent(index) {
    captureState();
    var initialPath = state.persistent[index].path;
    browseFile(function(path) {
        captureState();
        state.persistent[index].path = path;
        markDirty();
        render();
    }, "", initialPath);
}

function addDynamicRow(tabIndex, kind) {
    captureState();
    var rows = state.data[state.tabs[tabIndex]][kind];
    if (kind === "paths" || kind === "envs") {
        rows.push(kind === "paths" ? emptyPathRow() : {name: "", val: ""});
    } else if (kind === "execs") {
        rows.push("");
    } else {
        var previousLinkFolder = rows.length ? trimText(rows[rows.length - 1].tgt_dir) : "";
        rows.push({src: "", tgt_dir: previousLinkFolder, tgt_name: "", type: "Symlink"});
    }
    markDirty();
    render();
}

function deleteDynamicRow(tabIndex, kind, index) {
    captureState();
    var rows = state.data[state.tabs[tabIndex]][kind];
    if (kind === "paths" && index === 0) {
        return;
    }
    rows.splice(index, 1);
    markDirty();
    render();
}

function moveDynamicLink(tabIndex, index, direction) {
    var cursorState = null;
    var eventObject = typeof window !== "undefined" ? window.event : null;
    var source = eventObject ? eventObject.srcElement : null;
    if (source && source.getBoundingClientRect && typeof eventObject.screenX === "number") {
        var sourceRect = source.getBoundingClientRect();
        cursorState = {
            screen_x: eventObject.screenX,
            screen_y: eventObject.screenY,
            control_left: sourceRect.left,
            control_top: sourceRect.top,
            window_left: typeof window.screenLeft === "number" ? window.screenLeft : 0,
            window_top: typeof window.screenTop === "number" ? window.screenTop : 0
        };
    }
    captureState();
    var rows = state.data[state.tabs[tabIndex]].links;
    var targetIndex = index + direction;
    if (index < 0 || index >= rows.length || targetIndex < 0 || targetIndex >= rows.length) {
        return;
    }
    var row = rows[index];
    rows[index] = rows[targetIndex];
    rows[targetIndex] = row;
    markDirty();
    render();
    queueDynamicLinkMoveCursor(tabIndex, targetIndex, cursorState);
}

function moveDynamicLinkUp(tabIndex, index) {
    var eventObject = typeof window !== "undefined" ? window.event : null;
    moveDynamicLink(tabIndex, index, -1);
    if (eventObject) {
        eventObject.returnValue = false;
    }
    return false;
}

function queueDynamicLinkMoveCursor(tabIndex, index, cursorState) {
    if (!cursorState || typeof window === "undefined") {
        return;
    }
    window.setTimeout(function() {
        var target = document.getElementById("linkMove_" + tabIndex + "_" + index);
        if (!target || !target.getBoundingClientRect) {
            return;
        }
        var targetRect = target.getBoundingClientRect();
        var currentWindowLeft = typeof window.screenLeft === "number" ? window.screenLeft : 0;
        var currentWindowTop = typeof window.screenTop === "number" ? window.screenTop : 0;
        var x = Math.round(cursorState.screen_x + currentWindowLeft - cursorState.window_left +
            targetRect.left - cursorState.control_left);
        var y = Math.round(cursorState.screen_y + currentWindowTop - cursorState.window_top +
            targetRect.top - cursorState.control_top);
        var command = 'powershell.exe -NoProfile -WindowStyle Hidden -Command "' +
            'Add-Type -AssemblyName System.Windows.Forms;' +
            '[System.Windows.Forms.Cursor]::Position=(New-Object System.Drawing.Point -ArgumentList ' +
            x + ',' + y + ')"';
        try {
            wsh.Run(command, 0, false);
        } catch (ignoreCursorMove) {}
    }, 60);
}
function browseDynamicPath(tabIndex, index) {
    captureState();
    var initialPath = state.data[state.tabs[tabIndex]].paths[index].path;
    browseFile(function(path) {
        captureState();
        state.data[state.tabs[tabIndex]].paths[index].path = path;
        markDirty();
        render();
    }, "", initialPath);
}

function browseDynamic(tabIndex, kind, index, chooseFile) {
    captureState();
    var currentRow = state.data[state.tabs[tabIndex]][kind][index];
    var initialPath = kind === "execs" ? currentRow : currentRow.val;
    var done = function(path) {
        captureState();
        var rows = state.data[state.tabs[tabIndex]][kind];
        if (kind === "execs") {
            rows[index] = path;
        } else {
            rows[index].val = path;
        }
        markDirty();
        render();
    };
    if (chooseFile) {
        browseFile(done, kind === "execs" ? ".exe" : "", initialPath);
    } else {
        browseFolder(done, "Select folder", initialPath);
    }
}

function browseLinkSource(tabIndex, index, chooseFile) {
    captureState();
    var initialPath = state.data[state.tabs[tabIndex]].links[index].src;
    var done = function(path) {
        captureState();
        var row = state.data[state.tabs[tabIndex]].links[index];
        var oldSource = row.src;
        row.src = path;
        var oldDefault = linkNameFromSource(oldSource);
        if (!trimText(row.tgt_name) || trimText(row.tgt_name) === oldDefault) {
            row.tgt_name = linkNameFromSource(path);
        }
        markDirty();
        render();
    };
    if (chooseFile) {
        browseFile(done, "", initialPath);
    } else {
        browseFolder(done, "Select source folder", initialPath);
    }
}

function browseLinkTarget(tabIndex, index) {
    captureState();
    var initialPath = state.data[state.tabs[tabIndex]].links[index].tgt_dir;
    browseFolder(function(path) {
        captureState();
        state.data[state.tabs[tabIndex]].links[index].tgt_dir = path;
        markDirty();
        render();
    }, "Select link folder", initialPath);
}

function powerShellLiteral(value) {
    return "'" + String(value).replace(/'/g, "''") + "'";
}

function sanitizeBrowsedPath(path, isFolder) {
    path = trimText(path).replace(/\//g, "\\");
    if (/^[a-z]:\\/i.test(path)) {
        path = path.charAt(0).toUpperCase() + path.substr(1);
    }
    if (isFolder) {
        while (/\\$/.test(path)) {
            path = path.substr(0, path.length - 1);
        }
        if (path) {
            path += "\\";
        }
    }
    return path;
}

function currentBrowseDirectory(preferredPath) {
    preferredPath = trimText(preferredPath);
    if (preferredPath) {
        try {
            if (fso.FolderExists(preferredPath)) {
                return preferredPath;
            }
            var preferredDirectory = fso.GetParentFolderName(preferredPath);
            if (preferredDirectory && fso.FolderExists(preferredDirectory)) {
                return preferredDirectory;
            }
        } catch (ignorePreferredBrowseDirectory) {}
    }
    try {
        if (lastBrowseDirectory && fso.FolderExists(lastBrowseDirectory)) {
            return lastBrowseDirectory;
        }
    } catch (ignoreBrowseDirectory) {}
    lastBrowseDirectory = "C:\\";
    return lastBrowseDirectory;
}

function rememberBrowseDirectory(path) {
    path = trimText(path);
    if (!path) {
        return;
    }
    try {
        var directory = fso.FolderExists(path) ? path : fso.GetParentFolderName(path);
        if (directory && fso.FolderExists(directory)) {
            lastBrowseDirectory = directory;
        }
    } catch (ignoreRememberBrowse) {}
}

function runPickerScript(script) {
    var errorMarker = "PATHCONFIG_PICKER_ERROR:";
    var pathMarker = "PATHCONFIG_PICKER:";
    var wrapped = "$ErrorActionPreference='Stop';try{" + script +
        "}catch{[Console]::Out.Write('" + errorMarker + "'+$_.Exception.Message)}";
    var command = 'powershell.exe -NoProfile -STA -WindowStyle Hidden -Command "' + wrapped + '"';
    var output = runCapture(command);
    var errorAt = output.indexOf(errorMarker);
    if (errorAt >= 0) {
        alert("Path picker could not be opened.\n\n" + trimText(output.substr(errorAt + errorMarker.length)));
        return "";
    }
    var pathAt = output.indexOf(pathMarker);
    return pathAt >= 0 ? trimText(output.substr(pathAt + pathMarker.length)) : "";
}

function browseFolder(callback, title, initialPath) {
    var script = "$code=[System.Text.Encoding]::UTF8.GetString([Convert]::FromBase64String('" +
        NATIVE_FOLDER_DIALOG_CSHARP + "'));" +
        "Add-Type -TypeDefinition $code -Language CSharp -ErrorAction Stop;" +
        "$selected=[PathConfig.NativeFolderDialog]::Show(" +
        powerShellLiteral(title || "Select folder") + "," +
        powerShellLiteral(currentBrowseDirectory(initialPath)) + ");" +
        "if($selected){[Console]::Out.Write('PATHCONFIG_PICKER:'+$selected)}";
    var path = sanitizeBrowsedPath(runPickerScript(script), true);
    if (path) {
        rememberBrowseDirectory(path);
        callback(path);
    }
}

function browseFile(callback, accept, initialPath) {
    var filter = lower(accept) === ".exe" ?
        "Executable files (*.exe)|*.exe|All files (*.*)|*.*" : "All files (*.*)|*.*";
    var script = "Add-Type -AssemblyName System.Windows.Forms;" +
        "$dialog=New-Object System.Windows.Forms.OpenFileDialog;" +
        "$dialog.InitialDirectory=" + powerShellLiteral(currentBrowseDirectory(initialPath)) + ";" +
        "$dialog.Filter=" + powerShellLiteral(filter) + ";" +
        "$dialog.CheckFileExists=$true;" +
        "$dialog.Multiselect=$false;" +
        "$dialog.RestoreDirectory=$true;" +
        "if($dialog.ShowDialog() -eq [System.Windows.Forms.DialogResult]::OK){" +
        "[Console]::Out.Write('PATHCONFIG_PICKER:'+$dialog.FileName)}";
    var path = sanitizeBrowsedPath(runPickerScript(script), false);
    if (path) {
        rememberBrowseDirectory(path);
        callback(path);
    }
}

function addProgram() {
    browseFile(function(exePath) {
        captureState();
        var fileName = fso.GetFileName(exePath);
        var baseName = fso.GetBaseName(exePath);
        var parent = fso.GetParentFolderName(exePath);
        var tabName = fso.GetFileName(parent) || baseName;
        if (lower(tabName) === "paths" || lower(tabName) === "common") {
            tabName += "_Program";
        }
        var candidate = tabName;
        var suffix = 2;
        while (tabNameExists(candidate, -1)) {
            candidate = tabName + "_" + suffix;
            suffix++;
        }
        tabName = candidate;
        state.tabs.push(tabName);
        state.data[tabName] = {
            paths: [emptyPathRow(exePath, baseName)],
            envs: [],
            execs: [],
            links: []
        };
        state.activeProgramTab = state.tabs.length - 1;
        state.activeUiTab = state.activeProgramTab + 1;
        markDirty();
        render();
    }, ".exe");
}

function moveProgramTab(direction) {
    if (state.mode !== "Config" || state.activeUiTab <= 0) {
        return false;
    }
    captureState();
    var index = state.activeUiTab - 1;
    var targetIndex = index + direction;
    if (targetIndex < 0 || targetIndex >= state.tabs.length) {
        return false;
    }
    var tabName = state.tabs[index];
    state.tabs[index] = state.tabs[targetIndex];
    state.tabs[targetIndex] = tabName;
    state.activeProgramTab = targetIndex;
    state.activeUiTab = targetIndex + 1;
    markDirty();
    render(true);
    return false;
}

function renameProgram() {
    if (state.activeUiTab === 0) {
        return;
    }
    captureState();
    var index = state.activeUiTab - 1;
    var oldName = state.tabs[index];
    var newName = prompt("Enter a new program-tab name:", oldName);
    if (newName === null) {
        return;
    }
    newName = trimText(newName);
    if (!newName || newName === oldName) {
        return;
    }
    if (lower(newName) === "paths" || lower(newName) === "common" || /[\|\[\]\r\n]/.test(newName)) {
        alert("Common and Paths are reserved, and tab names cannot contain |, [, ], or line breaks.");
        return;
    }
    if (tabNameExists(newName, index)) {
        alert("A program tab with that name already exists.");
        return;
    }
    state.tabs[index] = newName;
    state.data[newName] = state.data[oldName];
    delete state.data[oldName];
    markDirty();
    render();
}

function tabNameExists(name, exceptIndex) {
    var i;
    for (i = 0; i < state.tabs.length; i++) {
        if (i !== exceptIndex && lower(state.tabs[i]) === lower(name)) {
            return true;
        }
    }
    return false;
}

function deleteProgram() {
    if (state.activeUiTab === 0) {
        return;
    }
    if (state.tabs.length <= 1) {
        alert("At least one program tab must remain.");
        return;
    }
    var index = state.activeUiTab - 1;
    var name = state.tabs[index];
    if (!confirm('Delete the program tab "' + name + '"?')) {
        return;
    }
    captureState();
    delete state.data[name];
    state.tabs.splice(index, 1);
    state.activeProgramTab = 0;
    state.activeUiTab = 1;
    markDirty();
    render();
}

function browseButtonPath(button) {
    var cell = button ? button.parentNode : null;
    var valueCell = cell ? cell.previousSibling : null;
    while (valueCell && valueCell.nodeType !== 1) {
        valueCell = valueCell.previousSibling;
    }
    if (!valueCell) {
        return "";
    }
    var inputs = valueCell.getElementsByTagName("input");
    return inputs.length ? trimText(inputs[0].value) : "";
}

function showBrowseContextMenu(button) {
    var path = browseButtonPath(button);
    hideContextMenu();
    hidePersistentRowMenu();
    hideBrowseContextMenu();
    browseMenuPath = path;
    var menu = document.getElementById("browseContextMenu");
    var findButton = document.getElementById("browseFindExplorer");
    findButton.disabled = !path;
    menu.style.display = "block";
    var eventObject = window.event;
    var rect = button.getBoundingClientRect();
    var left = eventObject && typeof eventObject.clientX === "number" ?
        eventObject.clientX + document.body.scrollLeft : rect.left + document.body.scrollLeft;
    var top = eventObject && typeof eventObject.clientY === "number" ?
        eventObject.clientY + document.body.scrollTop : rect.bottom + document.body.scrollTop;
    menu.style.left = Math.max(0, left) + "px";
    menu.style.top = Math.max(0, top) + "px";
    if (eventObject) {
        eventObject.cancelBubble = true;
        eventObject.returnValue = false;
    }
    return false;
}

function hideBrowseContextMenu() {
    var menu = document.getElementById("browseContextMenu");
    if (menu) {
        menu.style.display = "none";
    }
    browseMenuPath = "";
}

function findBrowsePathInExplorer() {
    var path = expandPathVariables(browseMenuPath);
    hideBrowseContextMenu();
    if (!path) {
        return;
    }
    try {
        if (!fso.FileExists(path) && !fso.FolderExists(path)) {
            alert("Path does not exist.\n\n" + path);
            return;
        }
        var explorer = wsh.ExpandEnvironmentStrings("%SystemRoot%") + "\\explorer.exe";
        wsh.Run(quoteArg(explorer) + " /select," + quoteArg(path), 1, false);
    } catch (error) {
        alert("Could not find the path in Explorer.\n\n" + error.message);
    }
}

function showPersistentRowMenu(index, button) {
    captureState();
    hideBrowseContextMenu();
    persistentMenuIndex = index;
    hideContextMenu();
    var menu = document.getElementById("persistentRowMenu");
    var deleteButton = document.getElementById("persistentRowDelete");
    deleteButton.disabled = index <= 0;
    menu.style.display = "block";
    var rect = button.getBoundingClientRect();
    menu.style.left = Math.max(0, rect.right + document.body.scrollLeft - menu.offsetWidth) + "px";
    menu.style.top = rect.bottom + document.body.scrollTop + "px";
    var eventObject = window.event;
    if (eventObject) {
        eventObject.cancelBubble = true;
        eventObject.returnValue = false;
    }
    return false;
}

function hidePersistentRowMenu() {
    var menu = document.getElementById("persistentRowMenu");
    if (menu) {
        menu.style.display = "none";
    }
    persistentMenuIndex = -1;
}

function movePersistentToNewTabFromMenu() {
    var index = persistentMenuIndex;
    hidePersistentRowMenu();
    if (index >= 0) {
        movePersistentToNewTab(index);
    }
}

function deletePersistentFromMenu() {
    var index = persistentMenuIndex;
    hidePersistentRowMenu();
    if (index > 0) {
        deletePersistent(index);
    }
}

function hideMenus() {
    hideContextMenu();
    hidePersistentRowMenu();
    hideBrowseContextMenu();
}

function tabContextMenu() {
    hidePersistentRowMenu();
    hideBrowseContextMenu();
    var eventObject = window.event;
    var target = eventObject.srcElement;
    var index = asNumber(target.getAttribute("data-tab-index"), -1);
    if (index <= 0 || state.mode !== "Config") {
        hideContextMenu();
        return false;
    }
    selectTab(index);
    var menu = document.getElementById("contextMenu");
    document.getElementById("tabMoveLeft").disabled = state.activeProgramTab <= 0;
    document.getElementById("tabMoveRight").disabled = state.activeProgramTab >= state.tabs.length - 1;
    menu.style.left = eventObject.clientX + document.body.scrollLeft + "px";
    menu.style.top = eventObject.clientY + document.body.scrollTop + "px";
    menu.style.display = "block";
    eventObject.returnValue = false;
    return false;
}

function hideContextMenu() {
    var menu = document.getElementById("contextMenu");
    if (menu) {
        menu.style.display = "none";
    }
}

function joinPath(dir, name) {
    if (!dir) {
        return name || "";
    }
    return dir.replace(/[\\\/]+$/, "") + "\\" + (name || "");
}

function resetLog() {
    var now = new Date();
    writeText(logPath, "# Apply Execution Log - " + now.toLocaleString() + "\r\n\r\n");
}

function appendLog(message, failed) {
    var stream = fso.OpenTextFile(logPath, 8, true, 0);
    stream.Write((failed ? "- FAILED: " : "- OK: ") + message + "\r\n\r\n");
    stream.Close();
}

function applyPaths() {
    captureState();
    resetLog();
    var result = applyPersistentPaths();
    if (result.env_changed) {
        broadcastEnvironmentChange();
    }
    if (result.error_count === 0) {
        render(true);
    } else {
        render();
    }
    alert(persistentSummary("Apply Paths", result));
}

function applyAll() {
    captureState();
    resetLog();
    var persistentResult = applyPersistentPaths();
    var envChanged = persistentResult.env_changed;
    var dynamicErrors = 0;
    var dynamicMenuPins = 0;
    var dynamicMenuCreated = 0;
    var dynamicMenuRemoved = 0;
    var programCleanup = {errors: 0, error_count: 0};
    cleanupProgramStartup(PROGRAM_STARTUP_PREFIX, programCleanup);
    dynamicErrors += programCleanup.errors + programCleanup.error_count;
    var i, result;
    for (i = 0; i < state.tabs.length; i++) {
        result = applyTabConfig(state.tabs[i], i, true);
        envChanged = envChanged || result.env_changed;
        dynamicErrors += result.errors;
        dynamicMenuPins += result.menu_pin_count;
        dynamicMenuCreated += result.menu_created_count;
        dynamicMenuRemoved += result.menu_removed_count;
    }
    if (envChanged) {
        broadcastEnvironmentChange();
    }
    if (persistentResult.error_count === 0 && dynamicErrors === 0) {
        render(true);
    } else {
        render();
    }
    alert("Apply All\n\nPersistent actions completed: " + persistentResult.success_count +
        "\nPersistent errors: " + persistentResult.error_count +
        "\nDynamic program tabs applied: " + state.tabs.length +
        "\nStart11 menu pins ready: " + (persistentResult.menu_pin_count + dynamicMenuPins) +
        "\nStart11 shortcuts created: " + (persistentResult.menu_created_count + dynamicMenuCreated) +
        "\nStart11 shortcuts removed: " + (persistentResult.menu_removed_count + dynamicMenuRemoved) +
        "\nDynamic errors: " + dynamicErrors);
}

function applyCurrentProgram() {
    if (state.activeUiTab === 0) {
        applyPaths();
        return;
    }
    captureState();
    resetLog();
    var name = state.tabs[state.activeUiTab - 1];
    var result = applyTabConfig(name, state.activeUiTab - 1, false);
    if (result.env_changed) {
        broadcastEnvironmentChange();
    }
    if (result.errors === 0) {
        render(true);
    }
    alert("Apply " + name + "\n\nStart11 menu pins ready: " + result.menu_pin_count +
        "\nStart11 shortcuts removed: " + result.menu_removed_count +
        "\nCompleted with " + result.errors + " error(s).");
}

function persistentSummary(title, result) {
    return title + "\n\nCompleted: " + result.success_count +
        "\nEnvironment updates: " + (result.env_changed ? "Yes" : "No") +
        "\nAdministrator properties set: " + result.admin_property_count +
        "\nAdministrator properties removed: " + result.admin_removed_count +
        "\nStartup entries: " + result.startup_count +
        "\nStart11 menu pins ready: " + result.menu_pin_count +
        "\nStart11 shortcuts created: " + result.menu_created_count +
        "\nStart11 shortcuts removed: " + result.menu_removed_count +
        "\nErrors: " + result.error_count;
}

function applyPersistentPaths() {
    var result = {
        env_changed: false,
        admin_property_count: 0,
        admin_removed_count: 0,
        startup_count: 0,
        menu_pin_count: 0,
        menu_created_count: 0,
        menu_removed_count: 0,
        success_count: 0,
        error_count: 0
    };
    appendLog("Persistent Paths", false);
    cleanupOwnedStartup(result);
    var variables = configuredEnvironmentVariables();
    var i, row, rawPath, path, envName, startupName;
    for (i = 0; i < state.persistent.length; i++) {
        row = state.persistent[i];
        rawPath = trimText(row.path);
        path = expandPathVariables(rawPath, variables);
        envName = trimText(row.env_var);
        if (envName && rawPath) {
            try {
                wsh.RegWrite(REG_ENV + envName, rawPath, environmentRegistryType(rawPath));
                result.env_changed = true;
                persistentSuccess(result, "Environment variable " + envName + " = " + rawPath);
            } catch (errorEnv) {
                persistentError(result, "Row " + (i + 1) + " environment write failed: " + errorEnv.message);
            }
        }
        startupName = STARTUP_PREFIX + (i + 1);
        syncStartupState(path, row.run_on_startup ? true : false,
            row.run_as_admin ? true : false, startupName, result, "Row " + (i + 1));
        if (path) {
            setRunAsAdminProperty(path, row.run_as_admin ? true : false, result, i + 1);
        } else if (row.run_as_admin) {
            persistentError(result, "Row " + (i + 1) + " administrator-property target is empty.");
        }
        if (row.menu) {
            ensureStart11MenuPin(path, row.run_as_admin ? true : false, result, "Row " + (i + 1));
        } else if (path) {
            removeStart11MenuPin(path, result, "Row " + (i + 1));
        }
    }
    return result;
}

function setRunAsAdminProperty(path, enabled, result, rowNumber) {
    path = resolveRunAsAdminPath(path);
    var extension = lower(fso.GetExtensionName(path));
    if (enabled && (!pathExists(path) || extension !== "exe")) {
        persistentError(result, "Row " + rowNumber + " administrator property requires an existing .exe file: " + path);
        return;
    }

    var current = readRunAsAdminFlags(path);
    var rawTokens = trimText(current.value) ? trimText(current.value).split(/\s+/) : [];
    var tokens = [];
    var hadRunAsAdmin = false;
    var i, token;
    for (i = 0; i < rawTokens.length; i++) {
        token = trimText(rawTokens[i]);
        if (lower(token) === "runasadmin") {
            hadRunAsAdmin = true;
        } else if (token) {
            tokens.push(token);
        }
    }

    if (enabled) {
        if (!tokens.length) {
            tokens.push("~");
        }
        tokens.push("RUNASADMIN");
        if (writeRunAsAdminFlags(path, tokens.join(" "))) {
            result.admin_property_count++;
            persistentSuccess(result, 'Enabled "Run this program as an administrator": ' + path);
        } else {
            persistentError(result, "Row " + rowNumber + " could not set the administrator property: " + path);
        }
        return;
    }

    if (!current.exists || !hadRunAsAdmin) {
        return;
    }
    if (tokens.length === 1 && tokens[0] === "~") {
        tokens = [];
    }
    if (tokens.length ? writeRunAsAdminFlags(path, tokens.join(" ")) : deleteRunAsAdminFlags(path)) {
        result.admin_removed_count++;
        persistentSuccess(result, 'Disabled "Run this program as an administrator": ' + path);
    } else {
        persistentError(result, "Row " + rowNumber + " could not remove the administrator property: " + path);
    }
}

function readRunAsAdminFlags(path) {
    var regExe = wsh.ExpandEnvironmentStrings("%SystemRoot%") + "\\System32\\reg.exe";
    var command = quoteArg(regExe) + " query " + quoteArg(APP_COMPAT_KEY) + " /v " + quoteArg(path);
    var output = runCapture(command);
    var lines = output.split(/\r?\n/);
    var i, match;
    for (i = 0; i < lines.length; i++) {
        match = /^\s*.+?\s+REG_SZ\s+(.*)$/i.exec(lines[i]);
        if (match) {
            return {exists: true, value: trimText(match[1])};
        }
    }
    return {exists: false, value: ""};
}

function writeRunAsAdminFlags(path, flags) {
    var regExe = wsh.ExpandEnvironmentStrings("%SystemRoot%") + "\\System32\\reg.exe";
    var command = quoteArg(regExe) + " add " + quoteArg(APP_COMPAT_KEY) +
        " /v " + quoteArg(path) + " /t REG_SZ /d " + quoteArg(flags) + " /f";
    try {
        return wsh.Run(command, 0, true) === 0;
    } catch (ignoreWrite) {
        return false;
    }
}

function deleteRunAsAdminFlags(path) {
    var regExe = wsh.ExpandEnvironmentStrings("%SystemRoot%") + "\\System32\\reg.exe";
    var command = quoteArg(regExe) + " delete " + quoteArg(APP_COMPAT_KEY) +
        " /v " + quoteArg(path) + " /f";
    try {
        return wsh.Run(command, 0, true) === 0;
    } catch (ignoreDelete) {
        return false;
    }
}

function persistentError(result, message) {
    result.error_count++;
    appendLog(message, true);
}

function persistentSuccess(result, message) {
    result.success_count++;
    appendLog(message, false);
}

function isOwnedStartupName(name) {
    name = lower(trimText(name));
    return name.substr(0, lower(STARTUP_PREFIX).length) === lower(STARTUP_PREFIX) ||
        name.substr(0, lower(PROGRAM_STARTUP_PREFIX).length) === lower(PROGRAM_STARTUP_PREFIX);
}

function uint32LittleEndianHex(value) {
    value = Math.floor(value);
    var output = "";
    var i, current;
    for (i = 0; i < 4; i++) {
        current = value % 256;
        output += ("0" + current.toString(16)).slice(-2);
        value = Math.floor(value / 256);
    }
    return output.toUpperCase();
}

function startupApprovedDisabledData() {
    var fileTimeMilliseconds = new Date().valueOf() + 11644473600000;
    var uint32Base = 4294967296;
    var millisecondsHigh = Math.floor(fileTimeMilliseconds / uint32Base);
    var millisecondsLow = fileTimeMilliseconds - millisecondsHigh * uint32Base;
    var lowProduct = millisecondsLow * 10000;
    var low = lowProduct % uint32Base;
    var high = (millisecondsHigh * 10000 + Math.floor(lowProduct / uint32Base)) % uint32Base;
    return "03000000" + uint32LittleEndianHex(low) + uint32LittleEndianHex(high);
}

function writeStartupApprovalValue(name, enabled, result, rowLabel) {
    var data = enabled ? STARTUP_APPROVED_ENABLED : startupApprovedDisabledData();
    var regExe = wsh.ExpandEnvironmentStrings("%SystemRoot%") + "\\System32\\reg.exe";
    var command = quoteArg(regExe) + " add " + quoteArg(STARTUP_APPROVED_KEY) +
        " /v " + quoteArg(name) + " /t REG_BINARY /d " + data + " /f";
    try {
        if (wsh.Run(command, 0, true) === 0) {
            startupStateCache = null;
            return true;
        }
    } catch (ignoreApprovalWrite) {}
    persistentError(result, rowLabel + " could not set Windows Startup Apps status for: " + name);
    return false;
}

function writeStartupApproval(name, result, rowLabel) {
    if (!isOwnedStartupName(name)) {
        persistentError(result, rowLabel + " refused an unowned Windows Startup Apps value: " + name);
        return false;
    }
    return writeStartupApprovalValue(name, true, result, rowLabel);
}

function writeExistingStartupApproval(name, enabled, result, rowLabel) {
    if (!trimText(name) || isOwnedStartupName(name)) {
        persistentError(result, rowLabel + " refused an invalid existing Windows Startup Apps value: " + name);
        return false;
    }
    return writeStartupApprovalValue(name, enabled, result, rowLabel);
}

function syncStartupState(path, enabled, elevate, ownedName, result, rowLabel) {
    path = expandPathVariables(path);
    if (!path) {
        if (enabled) {
            persistentError(result, rowLabel + " startup target is empty.");
        }
        return;
    }
    if (enabled && !pathExists(path)) {
        persistentError(result, rowLabel + " startup target is missing: " + path);
        return;
    }

    var existing = findExistingStartupEntry(path);
    if (existing.ambiguous) {
        persistentError(result, rowLabel + " matches multiple existing Windows Startup Apps entries; no state was changed.");
        return;
    }
    if (existing.found) {
        if (writeExistingStartupApproval(existing.entry.name, enabled, result, rowLabel)) {
            if (enabled) {
                result.startup_count++;
            }
            persistentSuccess(result, "Existing Windows Startup Apps entry " + existing.entry.name +
                " set to " + (enabled ? "On" : "Off") + ": " + path);
        }
        return;
    }
    if (!enabled) {
        return;
    }

    var command = buildStartupCommand(path, elevate);
    try {
        wsh.RegWrite(REG_RUN + ownedName, command, "REG_SZ");
        startupStateCache = null;
        if (writeStartupApproval(ownedName, result, rowLabel)) {
            result.startup_count++;
            persistentSuccess(result, "Startup entry " + ownedName +
                " configured and enabled in Windows Startup Apps.");
        }
    } catch (errorStartup) {
        persistentError(result, rowLabel + " startup entry failed: " + errorStartup.message);
    }
}
function cleanupStartupApprovals(prefix, result) {
    startupStateCache = null;
    var regExe = wsh.ExpandEnvironmentStrings("%SystemRoot%") + "\\System32\\reg.exe";
    var output = runCapture(quoteArg(regExe) + " query " + quoteArg(STARTUP_APPROVED_KEY));
    var lines = output.split(/\r?\n/);
    var normalizedPrefix = lower(prefix);
    var i, match, name;
    for (i = 0; i < lines.length; i++) {
        match = /^\s*(PathConfig_[^\s]+)\s+REG_BINARY/i.exec(lines[i]);
        if (!match) {
            continue;
        }
        name = match[1];
        if (isOwnedStartupName(name) && lower(name).substr(0, normalizedPrefix.length) === normalizedPrefix) {
            try {
                wsh.RegDelete(REG_STARTUP_APPROVED + name);
            } catch (errorApprovalDelete) {
                persistentError(result, "Could not remove owned Windows Startup Apps status " + name +
                    ": " + errorApprovalDelete.message);
            }
        }
    }
}

function cleanupOwnedStartup(result) {
    startupStateCache = null;
    var regExe = wsh.ExpandEnvironmentStrings("%SystemRoot%") + "\\System32\\reg.exe";
    var command = quoteArg(regExe) + ' query "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Run"';
    var output = runCapture(command);
    var lines = output.split(/\r?\n/);
    var i, match, name;
    for (i = 0; i < lines.length; i++) {
        match = /^\s*(PathConfig_Path_[^\s]+)\s+REG_/i.exec(lines[i]);
        if (match) {
            name = match[1];
            try {
                wsh.RegDelete(REG_RUN + name);
            } catch (error) {
                persistentError(result, "Could not remove owned startup entry " + name + ": " + error.message);
            }
        }
    }
    cleanupStartupApprovals(STARTUP_PREFIX, result);
}

function cleanupProgramStartup(prefix, result) {
    startupStateCache = null;
    var regExe = wsh.ExpandEnvironmentStrings("%SystemRoot%") + "\\System32\\reg.exe";
    var command = quoteArg(regExe) + ' query "HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Run"';
    var output = runCapture(command);
    var lines = output.split(/\r?\n/);
    var i, match, name;
    for (i = 0; i < lines.length; i++) {
        match = /^\s*(PathConfig_Program_[^\s]+)\s+REG_/i.exec(lines[i]);
        if (match) {
            name = match[1];
            if (name.substr(0, prefix.length) === prefix) {
                try {
                    wsh.RegDelete(REG_RUN + name);
                } catch (error) {
                    result.errors++;
                    appendLog("Could not remove program startup entry " + name + ": " + error.message, true);
                }
            }
        }
    }
    cleanupStartupApprovals(prefix, result);
}

function runCapture(command) {
    var tempName = "PathConfig-Capture-" + new Date().valueOf() + "-" +
        Math.floor(Math.random() * 1000000) + ".tmp";
    var tempPath = fso.BuildPath(wsh.ExpandEnvironmentStrings("%TEMP%"), tempName);
    var commandShell = wsh.ExpandEnvironmentStrings("%ComSpec%");
    var hiddenCommand = quoteArg(commandShell) + ' /d /q /c "' + command +
        " > " + quoteArg(tempPath) + ' 2>&1"';
    try {
        wsh.Run(hiddenCommand, 0, true);
        return fso.FileExists(tempPath) ? readText(tempPath) : "";
    } catch (ignore) {
        return "";
    } finally {
        try {
            if (fso.FileExists(tempPath)) {
                fso.DeleteFile(tempPath, true);
            }
        } catch (ignoreCleanup) {}
    }
}

function buildStartupCommand(path, elevate) {
    path = expandPathVariables(path);
    if (!elevate) {
        return quoteArg(path);
    }
    var escaped = String(path).replace(/'/g, "''");
    return 'powershell.exe -NoProfile -WindowStyle Hidden -Command "Start-Process -FilePath \'' +
        escaped + '\' -Verb RunAs"';
}

function broadcastEnvironmentChange() {
    var ps = "$sig='[DllImport(\\\"user32.dll\\\",SetLastError=true,CharSet=CharSet.Auto)]" +
        "public static extern IntPtr SendMessageTimeout(IntPtr hWnd,uint Msg,UIntPtr wParam,string lParam," +
        "uint flags,uint timeout,out UIntPtr result);';" +
        "Add-Type -MemberDefinition $sig -Name NativeMethods -Namespace PathConfig;" +
        "$r=[UIntPtr]::Zero;" +
        "[PathConfig.NativeMethods]::SendMessageTimeout([IntPtr]0xffff,0x1a,[UIntPtr]::Zero," +
        "'Environment',2,5000,[ref]$r)|Out-Null";
    try {
        wsh.Run('powershell.exe -NoProfile -WindowStyle Hidden -Command "' + ps + '"', 0, true);
    } catch (error) {
        appendLog("Environment notification failed: " + error.message, true);
    }
}

function programStartupPrefix(tabIndex) {
    return PROGRAM_STARTUP_PREFIX + (tabIndex + 1) + "_";
}

function applyTabConfig(tabName, tabIndex, startupAlreadyCleaned) {
    var data = state.data[tabName];
    var result = {
        env_changed: false,
        errors: 0,
        error_count: 0,
        success_count: 0,
        admin_property_count: 0,
        admin_removed_count: 0,
        startup_count: 0,
        menu_pin_count: 0,
        menu_created_count: 0,
        menu_removed_count: 0
    };
    var variables = configuredEnvironmentVariables();
    var i, item, rawPath, path, envName, startupName;
    appendLog("Program tab: " + tabName, false);
    if (!startupAlreadyCleaned) {
        cleanupProgramStartup(programStartupPrefix(tabIndex), result);
    }
    for (i = 0; i < data.paths.length; i++) {
        item = data.paths[i];
        rawPath = trimText(item.path);
        path = expandPathVariables(rawPath, variables);
        envName = trimText(item.env_var);
        if (envName && rawPath) {
            writeUserEnvironment(envName, rawPath, result);
        }
        startupName = programStartupPrefix(tabIndex) + (i + 1);
        syncStartupState(path, item.run_on_startup ? true : false,
            item.run_as_admin ? true : false, startupName, result, tabName + " row " + (i + 1));
        if (path) {
            setRunAsAdminProperty(path, item.run_as_admin ? true : false, result, tabName + " row " + (i + 1));
        } else if (item.run_as_admin) {
            persistentError(result, tabName + " row " + (i + 1) + " administrator-property target is empty.");
        }
        if (item.menu) {
            ensureStart11MenuPin(path, item.run_as_admin ? true : false, result,
                tabName + " row " + (i + 1));
        } else if (path) {
            removeStart11MenuPin(path, result, tabName + " row " + (i + 1));
        }
    }
    for (i = 0; i < data.envs.length; i++) {
        item = data.envs[i];
        if (trimText(item.name) && trimText(item.val)) {
            writeUserEnvironment(item.name, item.val, result);
        }
    }
    for (i = 0; i < data.execs.length; i++) {
        if (trimText(data.execs[i])) {
            runConfiguredTarget(data.execs[i], result);
        }
    }
    for (i = 0; i < data.links.length; i++) {
        createConfiguredLink(data.links[i], result);
    }
    result.errors += result.error_count;
    return result;
}

function writeUserEnvironment(name, value, result) {
    try {
        wsh.RegWrite(REG_ENV + trimText(name), trimText(value), environmentRegistryType(value));
        result.env_changed = true;
        appendLog("Environment variable " + trimText(name) + " = " + trimText(value), false);
    } catch (error) {
        result.errors++;
        appendLog("Environment variable " + trimText(name) + " failed: " + error.message, true);
    }
}

function runConfiguredTarget(path, result) {
    path = expandPathVariables(path);
    try {
        if (fso.FolderExists(path)) {
            var folder = fso.GetFolder(path);
            var files = new Enumerator(folder.Files);
            var oldDirectory = wsh.CurrentDirectory;
            wsh.CurrentDirectory = path;
            for (; !files.atEnd(); files.moveNext()) {
                var file = files.item();
                var extension = lower(fso.GetExtensionName(file.Name));
                if (extension === "exe" || extension === "bat") {
                    wsh.Run(quoteArg(file.Path), 1, false);
                }
            }
            wsh.CurrentDirectory = oldDirectory;
        } else if (fso.FileExists(path)) {
            var oldDir = wsh.CurrentDirectory;
            wsh.CurrentDirectory = fso.GetParentFolderName(path);
            wsh.Run(quoteArg(path), 1, false);
            wsh.CurrentDirectory = oldDir;
        } else {
            throw new Error("Target does not exist");
        }
        appendLog("Executed " + path, false);
    } catch (error) {
        result.errors++;
        appendLog("Execution failed for " + path + ": " + error.message, true);
    }
}

function createConfiguredLink(link, result) {
    var variables = configuredEnvironmentVariables();
    var src = expandPathVariables(link.src, variables);
    var targetDir = expandPathVariables(link.tgt_dir, variables);
    var targetName = expandPathVariables(link.tgt_name, variables);
    if (!src || !targetDir || !targetName) {
        return;
    }
    try {
        if (link.type === "Shortcut") {
            if (!/\.lnk$/i.test(targetName)) {
                targetName += ".lnk";
            }
            var shortcutPath = joinPath(targetDir, targetName);
            if (fso.FileExists(shortcutPath)) {
                fso.DeleteFile(shortcutPath, true);
            }
            var shortcut = wsh.CreateShortcut(shortcutPath);
            shortcut.TargetPath = src;
            shortcut.WorkingDirectory = fso.FolderExists(src) ? src : fso.GetParentFolderName(src);
            shortcut.Save();
            appendLog("Shortcut created: " + shortcutPath, false);
            return;
        }
        var targetPath = joinPath(targetDir, targetName);
        prepareLinkTarget(targetPath);
        var isDirectory = fso.FolderExists(src);
        var command;
        if (link.type === "Symlink") {
            command = 'cmd.exe /d /c mklink ' + (isDirectory ? "/D " : "") + quoteArg(targetPath) + " " + quoteArg(src);
        } else {
            if (isDirectory) {
                throw new Error("Hard links can only target files");
            }
            command = 'cmd.exe /d /c mklink /H ' + quoteArg(targetPath) + " " + quoteArg(src);
        }
        var exitCode = wsh.Run(command, 0, true);
        if (exitCode !== 0) {
            throw new Error("mklink returned exit code " + exitCode);
        }
        appendLog(link.type + " created: " + targetPath, false);
    } catch (error) {
        result.errors++;
        appendLog(link.type + " failed for " + src + ": " + error.message, true);
    }
}

function availableLinkBackupPath(path) {
    var base = path + ".default";
    var candidate = base;
    var suffix = 2;
    while (fso.FileExists(candidate) || fso.FolderExists(candidate)) {
        candidate = base + "." + suffix;
        suffix++;
    }
    return candidate;
}

function prepareLinkTarget(path) {
    if (fso.FileExists(path)) {
        var file = fso.GetFile(path);
        if ((file.Attributes & 1024) === 1024) {
            fso.DeleteFile(path, true);
        } else {
            fso.MoveFile(path, availableLinkBackupPath(path));
        }
    } else if (fso.FolderExists(path)) {
        var folder = fso.GetFolder(path);
        if ((folder.Attributes & 1024) === 1024) {
            fso.DeleteFolder(path, true);
        } else {
            fso.MoveFolder(path, availableLinkBackupPath(path));
        }
    }
}

function handleBeforeUnload() {
    try {
        if (isRestarting) {
            return;
        }
        captureState();
        if (!hasUnsavedChanges) {
            return;
        }
        var choice = wsh.Popup(
            "Save changes before exiting Path-Config?\n\nYes: Save and exit\nNo: Exit without saving\nCancel: Keep Path-Config open",
            0,
            "Path-Config - Unsaved Changes",
            35
        );
        if (choice === 6) {
            if (!saveState(false, true)) {
                window.event.returnValue = "Save failed.";
                return "Save failed.";
            }
        } else if (choice === 2 || choice === -1) {
            window.event.returnValue = "Exit cancelled.";
            return "Exit cancelled.";
        }
    } catch (error) {
        window.event.returnValue = "Unsaved changes could not be checked.";
        return "Unsaved changes could not be checked.";
    }
}

function initialize() {
    try {
        fso = new ActiveXObject("Scripting.FileSystemObject");
        wsh = new ActiveXObject("WScript.Shell");

        sourcePath = getApplicationPath();
        sourceSignature = getSourceSignature();
        appDir = getAppDirectory();
        iniPath = fso.BuildPath(appDir, "Path-Config.ini");
        legacyIniPath = fso.BuildPath(appDir, "System-Config.ini");
        logPath = fso.BuildPath(appDir, "Path-Config-Apply-Log.md");
        heartbeatPath = fso.BuildPath(appDir, "Path-Config.heartbeat");
        relaunchRequestPath = fso.BuildPath(appDir, "Path-Config.relaunch");
        loadState();
        try {
            var initialWidth = Math.max(1, Math.floor(screen.availWidth / 2));
            var initialHeight = Math.min(720, screen.availHeight);
            window.resizeTo(initialWidth, initialHeight);
            window.moveTo(
                Math.max(0, (screen.availWidth - initialWidth) / 2),
                Math.max(0, (screen.availHeight - initialHeight) / 2)
            );
        } catch (ignoreInitialSize) {}
        render();
        maintainLauncherBridge();
        window.setInterval(validateInputs, 700);
        window.setInterval(watchForSourceUpdate, 500);
        window.setInterval(maintainLauncherBridge, 1000);
        document.attachEvent("onclick", function() { hideMenus(); });
        document.attachEvent("oninput", trackInputChange);
        document.attachEvent("onkeyup", trackInputChange);
        document.attachEvent("onpropertychange", trackInputChange);
        document.attachEvent("onchange", trackInputChange);
        window.attachEvent("onbeforeunload", handleBeforeUnload);
        window.attachEvent("onunload", cleanupLauncherBridge);
    } catch (error) {
        document.getElementById("app").innerHTML =
            '<div style="padding:30px;color:#ff9aa7">Path-Config could not start.<br><br>' + html(error.message) + '</div>';
    }
}
</script>
</head>
<body onload="initialize()">
<div class="app" id="app"></div>
<div class="context-menu" id="contextMenu">
    <button id="tabMoveLeft" onclick="moveProgramTab(-1)">Move tab left</button>
    <button id="tabMoveRight" onclick="moveProgramTab(1)">Move tab right</button>
    <button onclick="renameProgram()">Rename current tab</button>
    <button onclick="deleteProgram()">Delete current tab</button>
</div>
<div class="context-menu" id="persistentRowMenu">
    <button onclick="movePersistentToNewTabFromMenu()">Move to New Tab</button>
    <button id="persistentRowDelete" onclick="deletePersistentFromMenu()">Delete Row</button>
</div>
<div class="context-menu" id="browseContextMenu">
    <button id="browseFindExplorer" onclick="findBrowsePathInExplorer()">Find in Explorer</button>
</div>
</body>
</html>
