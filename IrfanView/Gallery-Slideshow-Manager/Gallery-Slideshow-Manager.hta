<!DOCTYPE html>
<html>
<head>
<meta http-equiv="X-UA-Compatible" content="IE=edge" />
<meta charset="utf-8" />
<title>Gallery Slideshow Manager 0.56</title>
<hta:application
    id="galleryApp"
    applicationname="Gallery Slideshow Manager"
    border="thin"
    borderstyle="normal"
    caption="yes"
    contextmenu="no"
    icon="Gallery-Slideshow-Manager.ico"
    maximizebutton="yes"
    minimizebutton="yes"
    navigable="no"
    scroll="yes"
    selection="yes"
    showintaskbar="yes"
    singleinstance="yes"
    sysmenu="yes"
    windowstate="normal"
/>
<style>
html, body {
    margin: 0;
    padding: 0;
    width: 100%;
    height: 100%;
    min-height: 100%;
    overflow: hidden;
    background: #101216;
    color: #edf2f8;
    font-family: "Segoe UI", Arial, sans-serif;
}
body {
    overflow: hidden;
}
* {
    box-sizing: border-box;
}
button, input {
    font-family: "Segoe UI", Arial, sans-serif;
}
button {
    border: 1px solid #3d4654;
    border-radius: 7px;
    background: #252b34;
    color: #edf2f8;
    padding: 8px 13px;
    cursor: pointer;
}
button:hover {
    background: #303846;
    border-color: #587099;
}
button.primary {
    background: #2f6fda;
    border-color: #4382ec;
}
button.primary:hover {
    background: #397be8;
}
button.danger {
    background: #5b2930;
    border-color: #8c424d;
}
input[type=text] {
    border: 1px solid #343c48;
    border-radius: 7px;
    background: #171a20;
    color: #edf2f8;
    padding: 9px 11px;
    outline: none;
}
input[type=text]:focus {
    border-color: #4d88e6;
}
#appShell {
    position: relative;
    min-width: 880px;
    width: 100%;
    height: 100%;
    overflow: hidden;
}
#fixedControls {
    position: fixed;
    z-index: 40;
    left: 0;
    top: 0;
    right: 0;
    background: #171a20;
    box-shadow: 0 4px 14px rgba(0,0,0,0.30);
}
#topBar {
    padding: 16px 18px 10px 18px;
    background: #171a20;
    border-bottom: 1px solid #2b313b;
}
.row {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 9px;
}
.row:last-child {
    margin-bottom: 0;
}
.grow {
    flex: 1 1 auto;
}
#rootPath {
    width: 100%;
}
#keywordName {
    width: 250px;
}
#searchInput {
    width: 220px;
}
#filterPresetSelect {
    width: 230px;
    border: 1px solid #343c48;
    border-radius: 7px;
    background: #171a20;
    color: #edf2f8;
    padding: 8px 9px;
}
#filterPresetName {
    width: 210px;
}
#filterPresetHint {
    color: #8e9aaa;
    font-size: 11px;
}
button:disabled,
input:disabled {
    opacity: 0.45;
    cursor: default;
}
.label {
    color: #9ea9b8;
    font-size: 12px;
    margin-right: 4px;
}
#keywordFilters {
    display: block;
    width: 100%;
    min-width: 0;
}
.keywordFilterGroup {
    display: flex;
    align-items: flex-start;
    width: 100%;
    margin: 0;
}
.keywordFilterGroup + .keywordFilterGroup {
    margin-top: 8px;
    padding-top: 8px;
    border-top: 1px solid #2c3440;
}
.keywordFilterButtons {
    display: flex;
    flex: 1 1 auto;
    flex-wrap: wrap;
    gap: 7px;
    min-width: 0;
}
.keywordFilterButton {
    display: inline-flex;
    align-items: center;
    min-height: 38px;
    box-sizing: border-box;
    padding: 7px 12px 7px 8px;
    border: 1px solid #3a4350;
    border-radius: 8px;
    background: #20252d;
    color: #d2dae5;
    cursor: pointer;
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 14px;
    font-weight: 600;
    line-height: 18px;
    text-align: left;
}
.keywordFilterButton:hover {
    border-color: #60738d;
    background: #29313c;
}
.keywordFilterButton.active {
    border-color: #4d8fe9;
    background: #255a9f;
    color: #ffffff;
    box-shadow: 0 0 0 1px rgba(77,143,233,0.18);
}
.keywordFilterMark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 19px;
    height: 19px;
    min-width: 19px;
    margin-right: 8px;
    border: 2px solid #657183;
    border-radius: 5px;
    color: transparent;
    font-size: 14px;
    font-weight: 800;
    line-height: 15px;
}
.keywordFilterButton.active .keywordFilterMark {
    border-color: #dcecff;
    background: #eaf4ff;
    color: #24599b;
}
.keywordFilterWord {
    white-space: nowrap;
}
#ratingFilters {
    display: flex;
    align-items: center;
    gap: 3px;
    min-height: 38px;
}
.ratingFilterStar {
    position: relative;
    width: 34px;
    height: 36px;
    min-width: 34px;
    padding: 0;
    border: 1px solid transparent;
    border-radius: 8px;
    background: transparent;
    color: #566171;
    cursor: pointer;
    font-family: "Segoe UI Symbol", "Segoe UI", sans-serif;
    font-size: 25px;
    line-height: 31px;
    text-align: center;
}
.ratingFilterStar:hover {
    border-color: #596577;
    background: #20262f;
    color: #f1c94a;
}
.ratingFilterStar.active {
    color: #ffd34d;
    text-shadow: 0 0 8px rgba(255, 211, 77, 0.28);
}
.ratingFilterStar.selected {
    border-color: #d7aa25;
    background: #332b16;
}
.ratingFilterStar.exact {
    border-color: #65a8ff;
    background: #18385f;
    color: #ffe063;
    box-shadow: 0 0 0 1px rgba(101,168,255,0.25);
}
#ratingFilters.unratedOnly .ratingFilterStar {
    border-color: transparent;
    background: transparent;
    color: #566171;
    box-shadow: none;
    text-shadow: none;
}
#ratingFilters.unratedOnly .ratingFilterStar:hover {
    border-color: #596577;
    background: #20262f;
    color: #f1c94a;
}
.ratingFilterNumber {
    position: absolute;
    right: 2px;
    bottom: 0;
    min-width: 11px;
    color: #aeb9c8;
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 9px;
    font-weight: 700;
    line-height: 11px;
}
#ratingFilterHint {
    margin-left: 8px;
    color: #8e9aaa;
    font-size: 11px;
}
#toolbar {
    display: grid;
    grid-template-columns:
        minmax(0, 1fr)
        auto
        minmax(0, 1fr);
    align-items: center;
    column-gap: 14px;
    min-height: 62px;
    padding: 10px 18px;
    background: #14171c;
    border-bottom: 1px solid #292f38;
}
.toolbarZone {
    display: flex;
    align-items: center;
    align-self: center;
    gap: 9px;
    min-width: 0;
    height: 42px;
    min-height: 42px;
}
.toolbarZone.left {
    grid-column: 1;
    justify-self: start;
    justify-content: flex-start;
}
.toolbarZone.right {
    grid-column: 3;
    justify-self: end;
    justify-content: flex-end;
}
#slideshowActions {
    display: flex;
    grid-column: 2;
    justify-self: center;
    align-self: center;
    align-items: center;
    justify-content: center;
    gap: 12px;
    height: 42px;
    min-height: 42px;
}
.toolbarControl {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    height: 42px;
    min-height: 42px;
    margin: 0;
    line-height: 1.1;
    vertical-align: middle;
    white-space: nowrap;
    flex: 0 0 auto;
}
.toolbarCheckButton {
    padding: 8px 13px;
    border: 1px solid #3d4654;
    border-radius: 8px;
    background: #20252d;
    color: #aeb8c6;
    font-size: 13px;
    font-weight: 650;
    box-shadow:
        inset 0 1px 0 rgba(255,255,255,0.04),
        0 2px 7px rgba(0,0,0,0.18);
}
.toolbarCheckButton:hover {
    border-color: #587099;
    background: #2a313c;
    color: #edf2f8;
}
.toolbarCheckButton.active {
    border-color: #4f95e8;
    background: #1f4f82;
    color: #ffffff;
    box-shadow:
        inset 0 0 0 1px rgba(145,196,255,0.16),
        0 0 0 1px rgba(79,149,232,0.14),
        0 3px 9px rgba(0,0,0,0.24);
}
.toolbarCheckButton .checkbuttonMark {
    display: inline-block;
    width: 17px;
    margin-right: 4px;
    color: #697687;
    font-weight: 900;
    text-align: center;
}
.toolbarCheckButton.active .checkbuttonMark {
    color: #bfe0ff;
}
.slideshowActionButton {
    min-width: 162px;
    padding: 9px 17px;
    font-size: 14px;
    font-weight: 850;
    letter-spacing: 0.6px;
    text-transform: uppercase;
}

.toggle {
    color: #cbd3dd;
    font-size: 13px;
}
#content {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 42px;
    overflow-y: auto;
    overflow-x: hidden;
    padding: 16px 18px 48px 18px;
}
#summaryBar {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 13px;
}
#summaryTitle {
    font-size: 22px;
    font-weight: 600;
}
#summaryText {
    color: #98a4b4;
    font-size: 13px;
}
#parentGrid {
    display: block;
    margin: 0;
}
#parentGrid.tileView {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    margin: -7px;
}
#parentGrid.sectionView {
    display: block;
    margin: 0;
}
.letterRollout {
    margin: 0 0 10px 0;
    border: 1px solid #303844;
    border-radius: 10px;
    overflow: hidden;
    background: #171b21;
}
.letterRolloutHeader {
    display: flex;
    align-items: center;
    min-height: 42px;
    padding: 0 13px;
    background: #202630;
    border-bottom: 1px solid transparent;
    cursor: pointer;
    user-select: none;
}
.letterRolloutHeader:hover {
    background: #272e39;
}
.letterRollout.open .letterRolloutHeader {
    border-bottom-color: #303844;
}
.letterRolloutArrow {
    width: 18px;
    margin-right: 7px;
    color: #78a9ef;
    font-size: 15px;
    font-weight: 700;
}
.letterRolloutName {
    font-size: 17px;
    font-weight: 700;
}
.letterRolloutCount {
    margin-left: 9px;
    color: #98a4b4;
    font-size: 12px;
}
.letterRolloutHint {
    margin-left: auto;
    color: #697585;
    font-size: 11px;
}
.letterRolloutBody {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    padding: 7px;
}
.parentTile {
    width: 250px;
    margin: 7px;
    border: 1px solid #2e3540;
    border-radius: 11px;
    overflow: hidden;
    background: #1a1e25;
    box-shadow: 0 5px 14px rgba(0,0,0,0.22);
    cursor: pointer;
    position: relative;
}
.parentTile:hover {
    border-color: #5076aa;
    transform: translateY(-1px);
}
.parentTile.selected {
    border-color: #4b90f2;
    box-shadow: 0 0 0 2px rgba(75,144,242,0.22), 0 7px 17px rgba(0,0,0,0.28);
}
.parentTile:focus {
    outline: none;
    border-color: #7eb6ff;
    box-shadow:
        0 0 0 3px rgba(83,154,247,0.34),
        0 8px 20px rgba(0,0,0,0.34);
}
.parentTile.running:after {
    content: "RUNNING";
    position: absolute;
    top: 9px;
    right: 9px;
    background: #277b4c;
    color: white;
    border-radius: 10px;
    padding: 3px 7px;
    font-size: 10px;
    font-weight: 700;
}
.parentCover {
    height: 160px;
    background-color: #252c36;
    background-position: center top;
    background-repeat: no-repeat;
    background-size: cover;
    position: relative;
    overflow: hidden;
}
.parentCover .placeholder {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #243451, #19202a);
    color: #7faaf0;
    font-size: 54px;
    font-weight: 700;
}
.letterBadge {
    position: absolute;
    left: 9px;
    top: 9px;
    padding: 3px 7px;
    border-radius: 10px;
    background: rgba(8,10,13,0.78);
    color: #f1f4f8;
    font-size: 11px;
    font-weight: 700;
}
.parentBody {
    padding: 11px 12px 12px 12px;
}
.parentName {
    font-size: 15px;
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
.parentMeta {
    display: flex;
    align-items: center;
    margin-top: 5px;
    color: #98a4b4;
    font-size: 12px;
}
.ratingBadge {
    display: inline-block;
    margin-left: auto;
    padding: 2px 7px;
    border-radius: 10px;
    background: rgba(255, 193, 7, 0.16);
    color: #ffd34d;
    font-size: 11px;
    font-weight: 700;
    white-space: nowrap;
}
.ratingBadge.zero {
    background: rgba(148, 163, 184, 0.10);
    color: #8491a2;
}
.keywordBadges {
    margin-top: 8px;
    min-height: 22px;
}
.keywordBadge {
    display: inline-block;
    margin: 0 5px 5px 0;
    padding: 3px 7px;
    border-radius: 10px;
    background: #2a3443;
    color: #c7d6ea;
    font-size: 10px;
}
#emptyState {
    display: none;
    padding: 60px 20px;
    text-align: center;
    color: #8f9aaa;
}
#statusBar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    min-height: 42px;
    padding: 10px 18px;
    background: #171a20;
    border-top: 1px solid #303742;
    color: #aeb8c6;
    font-size: 12px;
    z-index: 20;
}
#galleryOverlay {
    display: none;
    position: fixed;
    z-index: 100;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background: rgba(4,6,9,0.76);
}
#galleryDialog {
    position: absolute;
    box-sizing: border-box;
    width: 560px;
    height: 300px;
    border: 1px solid #3a4452;
    border-radius: 12px;
    background: #161a20;
    box-shadow: 0 18px 50px rgba(0,0,0,0.55);
    overflow: hidden;
}
#galleryHeader {
    min-height: 76px;
    box-sizing: border-box;
    padding: 10px 12px;
    border-bottom: 1px solid #2c333e;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
}
#galleryHeader button {
    flex: 0 0 auto;
    padding-left: 10px;
    padding-right: 10px;
}
#galleryHeaderText {
    flex: 1 1 auto;
    min-width: 0;
}
#galleryTitle {
    font-size: 20px;
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
#galleryKeywords {
    margin-top: 4px;
    color: #9ba7b7;
    font-size: 12px;
}
#galleryGrid {
    position: absolute;
    left: 0;
    right: 0;
    top: 92px;
    bottom: 0;
    overflow-y: auto;
    padding: 12px;
    display: flex;
    flex-wrap: wrap;
    align-content: flex-start;
    align-items: flex-start;
}
.galleryCard {
    flex: 0 0 210px;
    width: 210px;
    height: 184px;
    box-sizing: border-box;
    align-self: flex-start;
    margin: 7px;
    background: #1d222a;
    border: 2px solid #4e8dd9;
    border-radius: 9px;
    overflow: hidden;
    cursor: pointer;
}
.galleryCard.video {
    border-color: #62b779;
}
.galleryCard:hover {
    background: #252c36;
}
.galleryCard.selected {
    border-color: #ffd34d;
    background: #2e2a1e;
    box-shadow:
        0 0 0 2px rgba(255,211,77,0.28),
        0 0 18px rgba(255,211,77,0.16);
}
.galleryCard:focus {
    outline: none;
    border-color: #7eb6ff;
    box-shadow:
        0 0 0 3px rgba(83,154,247,0.34),
        0 8px 20px rgba(0,0,0,0.32);
}
.galleryCard.selected.video {
    border-color: #ffd34d;
}
#startSelectedRandomButton[disabled] {
    border-color: #343b45;
    background: #242930;
    color: #6f7986;
    cursor: default;
    opacity: 0.72;
}
.galleryImage {
    flex: 0 0 125px;
    width: 100%;
    height: 125px;
    min-height: 125px;
    max-height: 125px;
    background-color: #252b34;
    background-position: center top;
    background-repeat: no-repeat;
    background-size: cover;
    overflow: hidden;
}
.galleryImage .placeholder {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #7f8a99;
}
.galleryInfo {
    height: 55px;
    box-sizing: border-box;
    overflow: hidden;
    padding: 9px 10px 8px 10px;
}
.galleryName {
    font-size: 13px;
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
.galleryFlags {
    margin-top: 4px;
    color: #8f9baa;
    font-size: 11px;
}
#contextMenu {
    display: none;
    position: fixed;
    z-index: 200;
    min-width: 300px;
    max-width: 460px;
    max-height: 520px;
    overflow-y: auto;
    box-sizing: border-box;
    padding: 9px;
    border: 1px solid #46505f;
    border-radius: 9px;
    background: #1c2128;
    box-shadow: 0 12px 28px rgba(0,0,0,0.48);
}
.contextTitle {
    padding: 6px 8px 10px 8px;
    color: #aeb9c8;
    font-size: 12px;
    font-weight: 700;
    border-bottom: 1px solid #313844;
    margin-bottom: 7px;
}
.contextKeywordGroup {
    margin: 0;
}
.contextKeywordGroup + .contextKeywordGroup {
    margin-top: 8px;
    padding-top: 8px;
    border-top: 1px solid #303946;
}
.contextKeywordButtons {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
}
.contextKeywordButton {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    box-sizing: border-box;
    padding: 6px 10px 6px 7px;
    border: 1px solid #394452;
    border-radius: 7px;
    background: #222830;
    color: #d9e0e8;
    cursor: pointer;
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 13px;
    font-weight: 600;
}
.contextKeywordButton:hover {
    border-color: #66788f;
    background: #2b333e;
}
.contextKeywordButton.active {
    border-color: #4d8fe9;
    background: #255a9f;
    color: #ffffff;
}
.contextKeywordMark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    min-width: 18px;
    margin-right: 7px;
    border: 2px solid #687486;
    border-radius: 5px;
    color: transparent;
    font-size: 13px;
    font-weight: 800;
    line-height: 14px;
}
.contextKeywordButton.active .contextKeywordMark {
    border-color: #dcecff;
    background: #eaf4ff;
    color: #24599b;
}
.smallMuted {
    color: #7f8998;
    font-size: 11px;
}
</style>
<script type="text/javascript">
var fso = new ActiveXObject("Scripting.FileSystemObject");
var shell = new ActiveXObject("WScript.Shell");
var shellApp = new ActiveXObject("Shell.Application");

var APP_VERSION = "0.56";
var APP_NAME = "Gallery-Slideshow-Manager";
var appDir = getApplicationDirectory();
var tempDir = shell.ExpandEnvironmentStrings("%TEMP%");
var sharedDataDir = tempDir + "\\" + APP_NAME;
var settingsPath = sharedDataDir + "\\" + APP_NAME + ".ini";
var cachePath = sharedDataDir + "\\" + APP_NAME + ".cache";
var CACHE_VERSION = "2";
var thumbnailDir = sharedDataDir + "\\thumbnails";
var thumbnailQueuePath = sharedDataDir + "\\" + APP_NAME + "-thumbnail-queue.txt";
var thumbnailDonePath = sharedDataDir + "\\" + APP_NAME + "-thumbnail-done.ini";
var bridgePath = appDir + "\\Gallery-Slideshow-Manager-Bridge.ahk";
var keywordIniName = "gallery-keywords.ini";
var ratingIniName = "gallery-ratings.ini";
var commandPath = sharedDataDir + "\\" + APP_NAME + "-command.ini";
var sessionPath = sharedDataDir + "\\" + APP_NAME + "-session.ini";
var filteredNavigationPath =
    sharedDataDir + "\\" + APP_NAME + "-filtered-navigation.ini";

var managerInstanceToken = "";

var state = {
    root: "",
    autoVlc: true,
    uniqueRandom: false,
    parents: [],
    keywords: [],
    activeFilters: {},
    filterPresets: [],
    matchedFilterPresetId: "",
    searchText: "",
    ratingFilterValue: -1,
    ratingFilterMode: "all",
    ratingFilterClickTimer: 0,
    parentClickTimer: 0,
    displayMode: "section",
    expandedLetter: "",
    selectedParent: null,
    selectedGallery: null,
    activeSlideshowType: "",
    filteredQueueSignature: null,
    navigationOrderMode: "normal",
    randomMembershipSignature: "",
    randomParentOrder: [],
    randomGalleryOrders: {},
    currentParentPath: "",
    currentGalleryPath: "",
    keywordRevision: "",
    ratingRevision: "",
    thumbnailQueue: [],
    thumbnailQueueMap: {},
    thumbnailBuildRunning: false,
    thumbnailBatchSize: 250,
    thumbnailCompletedCount: 0,
    thumbnailFailedCount: 0,
    thumbnailQueueScope: "",
    thumbnailRefreshTimer: 0
};

var sharedFileTextCache = {};
var deferredFileWrites = {};

function getApplicationDirectory() {
    var path = unescape(window.location.pathname).replace(/\//g, "\\");
    if (/^\\[A-Za-z]:/.test(path)) {
        path = path.substr(1);
    }
    return fso.GetParentFolderName(path);
}

function ensureSharedDataDirectory() {
    if (!fso.FolderExists(sharedDataDir)) {
        fso.CreateFolder(sharedDataDir);
    }

    if (fso.FolderExists(sharedDataDir) && !fso.FolderExists(thumbnailDir)) {
        fso.CreateFolder(thumbnailDir);
    }

    return fso.FolderExists(sharedDataDir)
        && fso.FolderExists(thumbnailDir);
}

function getNewestLegacyDataFile(fileName) {
    var candidates = [];
    var directPath = appDir + "\\" + fileName;

    if (fso.FileExists(directPath)) {
        candidates.push(directPath);
    }

    var parentDir = fso.GetParentFolderName(appDir);

    if (parentDir && fso.FolderExists(parentDir)) {
        var parentFolder = fso.GetFolder(parentDir);
        var folders = new Enumerator(parentFolder.SubFolders);

        for (; !folders.atEnd(); folders.moveNext()) {
            var folder = folders.item();
            var folderName = lower(folder.Name);

            if (folderName.indexOf("gallery-slideshow-manager-html_") !== 0
                && folderName.indexOf("gallery-slideshow-manager-html-") !== 0) {
                continue;
            }

            var candidatePath = folder.Path + "\\" + fileName;

            if (fso.FileExists(candidatePath)) {
                candidates.push(candidatePath);
            }
        }
    }

    var newestPath = "";
    var newestTime = 0;
    var i;

    for (i = 0; i < candidates.length; i++) {
        try {
            var file = fso.GetFile(candidates[i]);
            var modifiedTime = new Date(file.DateLastModified).getTime();

            if (!newestPath || modifiedTime > newestTime) {
                newestPath = candidates[i];
                newestTime = modifiedTime;
            }
        } catch (error) {
        }
    }

    return newestPath;
}

function migrateLegacyDataToSharedTemp() {
    if (!ensureSharedDataDirectory()) {
        alert("Could not create shared data directory:\n\n" + sharedDataDir);
        return false;
    }

    var migrations = [
        { name: APP_NAME + ".ini", destination: settingsPath },
        { name: APP_NAME + ".cache", destination: cachePath }
    ];

    var i;

    for (i = 0; i < migrations.length; i++) {
        if (fso.FileExists(migrations[i].destination)) {
            continue;
        }

        var sourcePath = getNewestLegacyDataFile(migrations[i].name);

        if (!sourcePath) {
            continue;
        }

        try {
            fso.CopyFile(sourcePath, migrations[i].destination, false);
        } catch (error) {
        }
    }

    return true;
}

function normalizePath(path) {
    if (!path) {
        return "";
    }
    path = String(path).replace(/^["\s]+|["\s]+$/g, "");
    if (/^[A-Za-z]:\\$/.test(path)) {
        return path;
    }
    return path.replace(/[\\\/]+$/, "");
}

function lower(text) {
    return String(text || "").toLowerCase();
}

function escapeHtml(text) {
    return String(text || "")
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;");
}

function fileUrl(path) {
    var url = normalizePath(path).replace(/\\/g, "/");
    var encoded = encodeURI("file:///" + url);

    // In local filenames, # and ? are characters rather than URL syntax.
    encoded = encoded.replace(/#/g, "%23");
    encoded = encoded.replace(/\?/g, "%3F");
    return encoded;
}

function removeCoverPlaceholder(element) {
    var children = element.childNodes;
    var removeList = [];
    var i;

    for (i = 0; i < children.length; i++) {
        var child = children[i];
        var className = child.className || "";

        if ((" " + className + " ").indexOf(" coverPlaceholder ") >= 0) {
            removeList.push(child);
        }
    }

    for (i = 0; i < removeList.length; i++) {
        element.removeChild(removeList[i]);
    }
}

function showCoverPlaceholder(element, fallbackText) {
    removeCoverPlaceholder(element);

    var placeholder = document.createElement("div");
    placeholder.className = "placeholder coverPlaceholder";
    placeholder.innerText = fallbackText || "No preview";
    element.appendChild(placeholder);
}

function applyCoverBackground(element, imagePath, fallbackText, forceRepaint) {
    removeCoverPlaceholder(element);

    if (imagePath && fso.FileExists(imagePath)) {
        var imageUrl =
            'url("'
            + fileUrl(imagePath).replace(/"/g, "%22")
            + '")';

        if (forceRepaint) {
            element.style.backgroundImage = "none";

            // Reading offsetHeight forces the HTA browser to complete the
            // previous style change before the local background is reapplied.
            var repaintHeight = element.offsetHeight;
        }

        element.style.backgroundImage = imageUrl;
        element._appliedCoverPath = lower(imagePath);
        return true;
    }

    element.style.backgroundImage = "none";
    element._appliedCoverPath = "";
    showCoverPlaceholder(element, fallbackText);
    return false;
}

function configureLazyCover(
    element,
    thumbnailPath,
    sourcePath,
    fallbackText
) {
    if ((" " + element.className + " ").indexOf(" lazyCover ") < 0) {
        element.className += " lazyCover";
    }

    element._thumbnailPath = thumbnailPath || "";
    element._sourcePath = sourcePath || "";
    element._coverFallbackText = fallbackText || "No preview";
    element._appliedCoverPath = "";
    element._wasNearViewport = false;
    element.style.backgroundImage = "none";
    showCoverPlaceholder(
        element,
        element._coverFallbackText
    );
}

function isElementNearVisibleArea(element) {
    if (!element || element.offsetWidth < 1 || element.offsetHeight < 1) {
        return false;
    }

    var rectangle = element.getBoundingClientRect();
    var viewportHeight =
        document.documentElement.clientHeight
        || document.body.clientHeight
        || 0;
    var viewportWidth =
        document.documentElement.clientWidth
        || document.body.clientWidth
        || 0;
    var preloadMargin = 360;

    return rectangle.bottom >= -preloadMargin
        && rectangle.top <= viewportHeight + preloadMargin
        && rectangle.right >= -preloadMargin
        && rectangle.left <= viewportWidth + preloadMargin;
}

function refreshVisibleThumbnails() {
    state.thumbnailRefreshTimer = 0;

    var covers = document.getElementsByTagName("div");
    var i;

    for (i = 0; i < covers.length; i++) {
        var element = covers[i];
        var className = element.className || "";

        if ((" " + className + " ").indexOf(" lazyCover ") < 0) {
            continue;
        }

        var isNear = isElementNearVisibleArea(element);

        if (!isNear) {
            element._wasNearViewport = false;
            continue;
        }

        var displayPath = getDisplayThumbnail(
            element._thumbnailPath,
            element._sourcePath
        );
        var normalizedDisplayPath = lower(displayPath);
        var enteredVisibleArea = !element._wasNearViewport;
        var pathChanged =
            normalizedDisplayPath !== (element._appliedCoverPath || "");

        if (enteredVisibleArea || pathChanged) {
            applyCoverBackground(
                element,
                displayPath,
                element._coverFallbackText,
                true
            );
        }

        element._wasNearViewport = true;
    }
}

function updateFixedControlsLayout() {
    var fixedControls = document.getElementById("fixedControls");
    var content = document.getElementById("content");

    if (!fixedControls || !content) {
        return false;
    }

    var controlsHeight = fixedControls.offsetHeight;

    if (controlsHeight < 1) {
        controlsHeight = 1;
    }

    content.style.top = controlsHeight + "px";
    scheduleVisibleThumbnailRefresh();
    return true;
}

function scheduleVisibleThumbnailRefresh() {
    if (state.thumbnailRefreshTimer) {
        window.clearTimeout(state.thumbnailRefreshTimer);
    }

    state.thumbnailRefreshTimer = window.setTimeout(
        refreshVisibleThumbnails,
        45
    );
}

function sharedFileKey(path) {
    return String(path || "")
        .replace(/\//g, "\\")
        .toLowerCase();
}

function waitForSharedFile(milliseconds) {
    var until = new Date().getTime() + milliseconds;

    while (new Date().getTime() < until) {
    }
}

function closeTextFileQuietly(file) {
    if (!file) {
        return;
    }

    try {
        file.Close();
    } catch (error) {
    }
}

function readText(path) {
    var key = sharedFileKey(path);
    var attempt;
    var file = null;

    for (attempt = 0; attempt < 10; attempt++) {
        try {
            if (!fso.FileExists(path)) {
                return "";
            }

            file = fso.OpenTextFile(path, 1, false, -2);
            var text = file.ReadAll();
            file.Close();
            file = null;

            sharedFileTextCache[key] = text;
            return text;
        } catch (error) {
            closeTextFileQuietly(file);
            file = null;

            if (attempt < 9) {
                waitForSharedFile(15 + (attempt * 10));
            }
        }
    }

    if (sharedFileTextCache.hasOwnProperty(key)) {
        return sharedFileTextCache[key];
    }

    return "";
}

function tryWriteTextNow(path, text) {
    var attempt;
    var file = null;

    for (attempt = 0; attempt < 10; attempt++) {
        try {
            file = fso.OpenTextFile(path, 2, true, -2);
            file.Write(text);
            file.Close();
            file = null;
            return true;
        } catch (error) {
            closeTextFileQuietly(file);
            file = null;

            if (attempt < 9) {
                waitForSharedFile(15 + (attempt * 10));
            }
        }
    }

    return false;
}

function scheduleDeferredFileWrite(key, path, text) {
    var entry = deferredFileWrites[key];

    if (!entry) {
        entry = {
            path: path,
            text: text,
            attempts: 0,
            timer: 0
        };
        deferredFileWrites[key] = entry;
    } else {
        entry.path = path;
        entry.text = text;
    }

    if (entry.timer) {
        return;
    }

    entry.timer = window.setTimeout(function() {
        flushDeferredFileWrite(key);
    }, 200);
}

function flushDeferredFileWrite(key) {
    var entry = deferredFileWrites[key];

    if (!entry) {
        return true;
    }

    entry.timer = 0;

    if (tryWriteTextNow(entry.path, entry.text)) {
        delete deferredFileWrites[key];
        return true;
    }

    entry.attempts++;

    if (entry.attempts >= 30) {
        delete deferredFileWrites[key];

        try {
            setStatus(
                "A shared settings file remained locked and could not be updated."
            );
        } catch (error) {
        }

        return false;
    }

    entry.timer = window.setTimeout(function() {
        flushDeferredFileWrite(key);
    }, Math.min(1500, 200 + (entry.attempts * 75)));

    return false;
}

function writeText(path, text, allowDeferredWrite) {
    var key = sharedFileKey(path);
    var output = String(text == null ? "" : text);

    sharedFileTextCache[key] = output;

    if (tryWriteTextNow(path, output)) {
        if (deferredFileWrites[key]) {
            delete deferredFileWrites[key];
        }

        return true;
    }

    if (allowDeferredWrite !== false) {
        scheduleDeferredFileWrite(key, path, output);
    }

    return false;
}

function parseIni(text) {
    var result = {};
    var section = "";
    var lines = String(text || "").replace(/\r/g, "").split("\n");
    var i;
    for (i = 0; i < lines.length; i++) {
        var line = lines[i];
        var trimmed = line.replace(/^\s+|\s+$/g, "");
        if (!trimmed || trimmed.charAt(0) === ";" || trimmed.charAt(0) === "#") {
            continue;
        }
        if (trimmed.charAt(0) === "[" && trimmed.charAt(trimmed.length - 1) === "]") {
            section = trimmed.substring(1, trimmed.length - 1);
            if (!result[section]) {
                result[section] = {};
            }
            continue;
        }
        var equals = line.indexOf("=");
        if (equals < 0 || !section) {
            continue;
        }
        var key = line.substring(0, equals).replace(/^\s+|\s+$/g, "");
        var value = line.substring(equals + 1);
        result[section][key] = value;
    }
    return result;
}

function serializeIni(data) {
    var sections = [];
    var sectionName;
    for (sectionName in data) {
        if (data.hasOwnProperty(sectionName)) {
            sections.push(sectionName);
        }
    }
    sections.sort(function(a, b) {
        if (a === "Keywords") { return -1; }
        if (b === "Keywords") { return 1; }
        return lower(a) < lower(b) ? -1 : 1;
    });

    var output = [];
    var i;
    for (i = 0; i < sections.length; i++) {
        sectionName = sections[i];
        output.push("[" + sectionName + "]");
        var keys = [];
        var key;
        for (key in data[sectionName]) {
            if (data[sectionName].hasOwnProperty(key)) {
                keys.push(key);
            }
        }
        keys.sort();
        var j;
        for (j = 0; j < keys.length; j++) {
            key = keys[j];
            output.push(key + "=" + data[sectionName][key]);
        }
        output.push("");
    }
    return output.join("\r\n");
}

function readIni(path) {
    return parseIni(readText(path));
}

function writeIni(path, data) {
    return writeText(path, serializeIni(data));
}

function setIniValue(path, section, key, value) {
    var data = readIni(path);
    if (!data[section]) {
        data[section] = {};
    }
    data[section][key] = value;
    return writeIni(path, data);
}

function getIniValue(data, section, key, fallback) {
    if (data[section] && typeof data[section][key] !== "undefined") {
        return data[section][key];
    }
    return fallback;
}

function parseKeywordList(text) {
    var parts = String(text || "").split("|");
    var result = [];
    var seen = {};
    var i;
    for (i = 0; i < parts.length; i++) {
        var word = parts[i].replace(/^\s+|\s+$/g, "");
        var key = lower(word);
        if (word && !seen[key]) {
            seen[key] = true;
            result.push(word);
        }
    }
    return result;
}

function joinKeywords(words) {
    return words.join("|");
}

function getActiveFilterWords() {
    var words = [];
    var i;

    for (i = 0; i < state.keywords.length; i++) {
        if (state.activeFilters[lower(state.keywords[i])]) {
            words.push(state.keywords[i]);
        }
    }

    return words;
}

function filterSignature(words) {
    var normalized = [];
    var seen = {};
    var i;

    for (i = 0; i < words.length; i++) {
        var key = lower(words[i]).replace(/^\s+|\s+$/g, "");

        if (key && !seen[key]) {
            seen[key] = true;
            normalized.push(key);
        }
    }

    normalized.sort();
    return normalized.join("|");
}

function presetIniKey(presetName) {
    return "Preset." + encodeURIComponent(presetName);
}

function presetNameFromIniKey(keyName) {
    if (keyName.indexOf("Preset.") !== 0) {
        return "";
    }

    try {
        return decodeURIComponent(keyName.substr(7));
    } catch (error) {
        return "";
    }
}

function loadFilterPresets() {
    var data = readIni(settingsPath);
    var section = data.KeywordFilterPresets || {};
    var presets = [];
    var key;

    for (key in section) {
        if (!section.hasOwnProperty(key) || key.indexOf("Preset.") !== 0) {
            continue;
        }

        var name = presetNameFromIniKey(key);

        if (!name) {
            continue;
        }

        var words = parseKeywordList(section[key]);
        presets.push({
            id: key,
            name: name,
            keywords: words,
            signature: filterSignature(words)
        });
    }

    presets.sort(function(a, b) {
        return lower(a.name) < lower(b.name) ? -1 :
            (lower(a.name) > lower(b.name) ? 1 : 0);
    });

    state.filterPresets = presets;
    updateFilterPresetControls();
}

function findMatchingFilterPreset() {
    var signature = filterSignature(getActiveFilterWords());
    var i;

    for (i = 0; i < state.filterPresets.length; i++) {
        if (state.filterPresets[i].signature === signature) {
            return state.filterPresets[i];
        }
    }

    return null;
}

function findFilterPresetById(presetId) {
    var i;

    for (i = 0; i < state.filterPresets.length; i++) {
        if (state.filterPresets[i].id === presetId) {
            return state.filterPresets[i];
        }
    }

    return null;
}

function updateFilterPresetControls() {
    var select = document.getElementById("filterPresetSelect");
    var nameInput = document.getElementById("filterPresetName");
    var saveButton = document.getElementById("saveFilterPresetButton");
    var hint = document.getElementById("filterPresetHint");

    if (!select || !nameInput || !saveButton || !hint) {
        return;
    }

    var currentValue = select.value;
    select.innerHTML = "";

    var customOption = document.createElement("option");
    customOption.value = "__custom__";
    customOption.innerText = "Current custom combination";
    select.appendChild(customOption);

    var noneOption = document.createElement("option");
    noneOption.value = "__none__";
    noneOption.innerText = "No keyword filter";
    select.appendChild(noneOption);

    var i;
    for (i = 0; i < state.filterPresets.length; i++) {
        var option = document.createElement("option");
        option.value = state.filterPresets[i].id;
        option.innerText = state.filterPresets[i].name;
        select.appendChild(option);
    }

    var activeWords = getActiveFilterWords();
    var matchedPreset = findMatchingFilterPreset();
    state.matchedFilterPresetId = matchedPreset ? matchedPreset.id : "";

    if (matchedPreset) {
        select.value = matchedPreset.id;
        hint.innerText = "Matches saved preset: " + matchedPreset.name;
    } else if (!activeWords.length) {
        select.value = "__none__";
        hint.innerText = "Select keywords to create a named preset.";
    } else {
        select.value = "__custom__";
        hint.innerText = "This keyword combination is not saved.";
    }

    var canSave = activeWords.length > 0 && !matchedPreset;
    nameInput.disabled = !canSave;
    saveButton.disabled = !canSave;

    if (!canSave && matchedPreset) {
        nameInput.value = "";
    }
}

function loadSelectedFilterPreset() {
    var presetId = document.getElementById("filterPresetSelect").value;

    if (presetId === "__custom__") {
        updateFilterPresetControls();
        return;
    }

    state.activeFilters = {};

    if (presetId !== "__none__") {
        var preset = findFilterPresetById(presetId);

        if (preset) {
            var available = {};
            var i;

            for (i = 0; i < state.keywords.length; i++) {
                available[lower(state.keywords[i])] = state.keywords[i];
            }

            for (i = 0; i < preset.keywords.length; i++) {
                var key = lower(preset.keywords[i]);

                if (available[key]) {
                    state.activeFilters[key] = true;
                }
            }
        }
    }

    renderKeywordFilters();
    renderParents();
    updateFilterPresetControls();
}

function saveCurrentFilterPreset() {
    var activeWords = getActiveFilterWords();
    var matchedPreset = findMatchingFilterPreset();

    if (!activeWords.length) {
        alert("Select at least one keyword before creating a preset.");
        return false;
    }

    if (matchedPreset) {
        alert("This keyword combination already matches preset: " + matchedPreset.name);
        updateFilterPresetControls();
        return false;
    }

    var input = document.getElementById("filterPresetName");
    var presetName = input.value.replace(/^\s+|\s+$/g, "");

    if (!presetName) {
        alert("Enter a preset name.");
        input.focus();
        return false;
    }

    var i;
    for (i = 0; i < state.filterPresets.length; i++) {
        if (lower(state.filterPresets[i].name) === lower(presetName)) {
            alert("A preset with this name already exists.");
            return false;
        }
    }

    var data = readIni(settingsPath);

    if (!data.KeywordFilterPresets) {
        data.KeywordFilterPresets = {};
    }

    var key = presetIniKey(presetName);
    data.KeywordFilterPresets[key] = joinKeywords(activeWords);
    writeIni(settingsPath, data);

    input.value = "";
    loadFilterPresets();
    document.getElementById("filterPresetSelect").value = key;
    updateFilterPresetControls();
    setStatus("Keyword filter preset saved: " + presetName);
    return true;
}

function encodeParentSection(parentPath) {
    var root = normalizePath(state.root);
    var parent = normalizePath(parentPath);
    var relative = parent;
    if (lower(parent).indexOf(lower(root + "\\")) === 0) {
        relative = parent.substr(root.length + 1);
    }
    relative = relative.replace(/%/g, "%25");
    relative = relative.replace(/\\/g, "%5C");
    relative = relative.replace(/\//g, "%2F");
    relative = relative.replace(/\[/g, "%5B");
    relative = relative.replace(/\]/g, "%5D");
    return "Parent." + relative;
}

function keywordIniPath() {
    return state.root ? state.root + "\\" + keywordIniName : "";
}

function ratingIniPath() {
    return state.root ? state.root + "\\" + ratingIniName : "";
}

function getParentRating(parentPath) {
    if (!state.root || !parentPath) {
        return 0;
    }

    var data = readIni(ratingIniPath());
    var section = encodeParentSection(parentPath);
    var rating = parseInt(
        getIniValue(data, section, "Rating", "0"),
        10
    );

    if (isNaN(rating) || rating < 0 || rating > 9) {
        return 0;
    }

    return rating;
}

function refreshParentRatings() {
    var i;

    for (i = 0; i < state.parents.length; i++) {
        state.parents[i].rating = getParentRating(state.parents[i].path);
    }

    renderParents();
}

function ratingStarsText(rating) {
    var value = parseInt(rating, 10) || 0;
    var result = "";
    var i;

    if (value < 1) {
        return "0★";
    }

    if (value > 9) {
        value = 9;
    }

    for (i = 0; i < value; i++) {
        result += "★";
    }

    return result;
}

function ratingText(rating) {
    var value = parseInt(rating, 10) || 0;

    if (value === 1) {
        return "1 star";
    }

    return value + " stars";
}

function loadSettings() {
    var data = readIni(settingsPath);
    state.root = normalizePath(getIniValue(data, "Galleries", "RootPath", ""));
    state.autoVlc = String(getIniValue(data, "Options", "AutoVlc", "1")) !== "0";
    state.uniqueRandom = String(getIniValue(data, "Options", "UniqueRandom", "0")) !== "0";
    state.displayMode = lower(
        getIniValue(data, "Options", "DisplayMode", "section")
    );
    state.ratingFilterValue = parseInt(
        getIniValue(data, "Options", "RatingFilter", "-1"),
        10
    );
    state.ratingFilterMode = lower(
        getIniValue(
            data,
            "Options",
            "RatingFilterMode",
            state.ratingFilterValue >= 0 ? "upto" : "all"
        )
    );

    if (isNaN(state.ratingFilterValue)
        || state.ratingFilterValue < -1
        || state.ratingFilterValue > 9) {
        state.ratingFilterValue = -1;
    }

    if (state.ratingFilterValue < 0) {
        state.ratingFilterMode = "all";
    } else if (
        state.ratingFilterMode !== "upto"
        && state.ratingFilterMode !== "exact"
    ) {
        state.ratingFilterMode = "upto";
    }

    if (state.displayMode !== "tile" && state.displayMode !== "section") {
        state.displayMode = "section";
    }

    document.getElementById("rootPath").value = state.root;
    updateAutoVlcButton();
    updateUniqueRandomButton();
    updateDisplayModeButton();
    updateSlideshowModeButtons();
    loadFilterPresets();
}

function saveRoot() {
    var value = normalizePath(document.getElementById("rootPath").value);
    if (!value || !fso.FolderExists(value)) {
        alert("Select an existing galleries root folder.");
        return false;
    }
    state.root = value;
    setIniValue(settingsPath, "Galleries", "RootPath", state.root);
    scanLibrary();
    return true;
}

function browseRoot() {
    var startFolder = state.root || 0;
    var folder = shellApp.BrowseForFolder(0, "Select galleries root folder", 0x11, startFolder);
    if (!folder) {
        return;
    }
    var path = normalizePath(folder.Self.Path);
    document.getElementById("rootPath").value = path;
    saveRoot();
}

function updateSlideshowModeButtons() {
    var normalButton = document.getElementById(
        "mainSlideshowButton"
    );
    var randomButton = document.getElementById(
        "mainRandomSlideshowButton"
    );

    if (normalButton) {
        normalButton.className =
            "toolbarControl toolbarCheckButton slideshowActionButton"
            + (
                state.activeSlideshowType === "normal"
                ? " active"
                : ""
            );
        normalButton.setAttribute(
            "aria-pressed",
            state.activeSlideshowType === "normal"
                ? "true"
                : "false"
        );
    }

    if (randomButton) {
        randomButton.className =
            "toolbarControl toolbarCheckButton slideshowActionButton"
            + (
                state.activeSlideshowType === "random"
                ? " active"
                : ""
            );
        randomButton.setAttribute(
            "aria-pressed",
            state.activeSlideshowType === "random"
                ? "true"
                : "false"
        );
    }

    return true;
}

function setActiveSlideshowType(slideshowType) {
    state.activeSlideshowType =
        slideshowType === "random"
        ? "random"
        : (
            slideshowType === "normal"
            ? "normal"
            : ""
        );
    updateSlideshowModeButtons();
    return true;
}

function restoreActiveSlideshowType() {
    var sessionData = readIni(sessionPath);
    var currentGallery = normalizePath(
        getIniValue(
            sessionData,
            "Session",
            "CurrentGallery",
            ""
        )
    );

    if (!currentGallery) {
        setActiveSlideshowType("");
        return false;
    }

    var navigationData = readIni(
        filteredNavigationPath
    );
    var runningMode = lower(
        getIniValue(
            navigationData,
            "Queue",
            "Mode",
            "normal"
        )
    );

    setActiveSlideshowType(
        runningMode === "random"
            ? "random"
            : "normal"
    );
    return true;
}

function updateAutoVlcButton() {
    var button = document.getElementById(
        "autoVlcButton"
    );

    if (!button) {
        return false;
    }

    button.className =
        "toolbarControl toolbarCheckButton"
        + (state.autoVlc ? " active" : "");
    button.setAttribute(
        "aria-pressed",
        state.autoVlc ? "true" : "false"
    );
    button.title = state.autoVlc
        ? "Automatic paired VLC video is enabled."
        : "Automatic paired VLC video is disabled.";
    return true;
}

function updateUniqueRandomButton() {
    var button = document.getElementById(
        "uniqueRandomButton"
    );

    if (!button) {
        return false;
    }

    button.className =
        "toolbarControl toolbarCheckButton"
        + (state.uniqueRandom ? " active" : "");
    button.setAttribute(
        "aria-pressed",
        state.uniqueRandom ? "true" : "false"
    );
    button.title = state.uniqueRandom
        ? "Each eligible gallery is shown once before the random cycle resets."
        : "Random galleries may repeat before every gallery has been shown.";
    return true;
}

function toggleUniqueRandom() {
    state.uniqueRandom = !state.uniqueRandom;
    updateUniqueRandomButton();
    setIniValue(
        settingsPath,
        "Options",
        "UniqueRandom",
        state.uniqueRandom ? "1" : "0"
    );

    if (state.activeSlideshowType === "random") {
        ensureBridge();
        sendCommand(
            state.uniqueRandom
            ? "uniqueon"
            : "uniqueoff",
            ""
        );
    }

    setStatus(
        "Unique random "
        + (state.uniqueRandom ? "enabled." : "disabled.")
    );
    return true;
}

function toggleAutoVlc() {
    state.autoVlc = !state.autoVlc;
    updateAutoVlcButton();
    setIniValue(
        settingsPath,
        "Options",
        "AutoVlc",
        state.autoVlc ? "1" : "0"
    );
    setStatus(
        "Automatic VLC "
        + (state.autoVlc ? "enabled." : "disabled.")
    );
}

function updateDisplayModeButton() {
    var button = document.getElementById(
        "displayModeButton"
    );

    if (!button) {
        return false;
    }

    button.className =
        "toolbarControl toolbarCheckButton"
        + (
            state.displayMode === "tile"
            ? " active"
            : ""
        );
    button.setAttribute(
        "aria-pressed",
        state.displayMode === "tile"
            ? "true"
            : "false"
    );
    button.title =
        state.displayMode === "tile"
        ? "Tile view is active. Click for section view."
        : "Section view is active. Click for tile view.";
    return true;
}

function displayModeChanged() {
    state.displayMode =
        state.displayMode === "tile"
        ? "section"
        : "tile";

    updateDisplayModeButton();

    setIniValue(
        settingsPath,
        "Options",
        "DisplayMode",
        state.displayMode
    );

    renderParents();
    setStatus(
        state.displayMode === "tile"
        ? "Main list changed to Tile view."
        : "Main list changed to By section view."
    );
}

function saveRatingFilter() {
    setIniValue(
        settingsPath,
        "Options",
        "RatingFilter",
        String(state.ratingFilterValue)
    );
    setIniValue(
        settingsPath,
        "Options",
        "RatingFilterMode",
        state.ratingFilterMode
    );
}

function applyRatingFilter(mode, value) {
    state.ratingFilterValue = value;
    state.ratingFilterMode = mode;

    saveRatingFilter();
    renderRatingFilters();
    renderParents();
    updateFixedControlsLayout();

    if (mode === "exact" && value === 0) {
        setStatus(
            "Showing only non-starred parent galleries."
        );
    } else if (mode === "exact") {
        setStatus(
            "Showing only parent galleries rated "
            + value
            + (value === 1 ? " star." : " stars.")
        );
    } else {
        setStatus(
            value >= 9
            ? "Showing parent galleries of every rating."
            : "Showing non-starred through "
                + value
                + "-star parent galleries."
        );
    }
}

function scheduleUpToRatingFilter(value) {
    if (state.ratingFilterClickTimer) {
        window.clearTimeout(state.ratingFilterClickTimer);
    }

    state.ratingFilterClickTimer = window.setTimeout(function() {
        state.ratingFilterClickTimer = 0;

        if (
            value === 1
            && state.ratingFilterValue === 1
            && (
                state.ratingFilterMode === "upto"
                || state.ratingFilterMode === "exact"
            )
        ) {
            applyRatingFilter("exact", 0);
        } else {
            applyRatingFilter("upto", value);
        }
    }, 260);
}

function applyExactRatingFilter(value) {
    if (state.ratingFilterClickTimer) {
        window.clearTimeout(state.ratingFilterClickTimer);
        state.ratingFilterClickTimer = 0;
    }

    applyRatingFilter("exact", value);
}

function renderRatingFilters() {
    var container = document.getElementById("ratingFilters");
    var hint = document.getElementById("ratingFilterHint");

    if (!container) {
        return;
    }

    container.innerHTML = "";

    var unratedOnly =
        state.ratingFilterMode === "exact"
        && state.ratingFilterValue === 0;

    container.className =
        unratedOnly
        ? "unratedOnly"
        : "";

    var rating;

    for (rating = 1; rating <= 9; rating++) {
        (function(value) {
            var star = document.createElement("button");
            var isExact =
                state.ratingFilterMode === "exact"
                && value === state.ratingFilterValue;
            var isActive =
                state.ratingFilterMode === "upto"
                ? (
                    state.ratingFilterValue >= 1
                    && value <= state.ratingFilterValue
                )
                : isExact;
            var isSelected =
                !unratedOnly
                && value === state.ratingFilterValue;

            star.type = "button";
            star.className =
                "ratingFilterStar"
                + (isActive ? " active" : "")
                + (isSelected ? " selected" : "")
                + (isExact ? " exact" : "");
            star.title =
                value === 1
                ? (
                    "Single click: show non-starred through 1★. "
                    + "Click active 1★ again: show only non-starred. "
                    + "Double click: show only 1★."
                )
                : (
                    "Single click: show non-starred through "
                    + value
                    + "★. Double click: show only "
                    + value
                    + "★."
                );
            star.innerHTML =
                '<span class="ratingFilterGlyph">★</span>'
                + '<span class="ratingFilterNumber">'
                + value
                + '</span>';

            star.onclick = function() {
                scheduleUpToRatingFilter(value);

                window.event.cancelBubble = true;
                window.event.returnValue = false;
                return false;
            };

            star.ondblclick = function() {
                applyExactRatingFilter(value);

                window.event.cancelBubble = true;
                window.event.returnValue = false;
                return false;
            };

            container.appendChild(star);
        })(rating);
    }

    if (hint) {
        if (unratedOnly) {
            hint.innerText = "Non-starred only";
        } else if (state.ratingFilterMode === "exact") {
            hint.innerText =
                "Only rating: "
                + state.ratingFilterValue
                + "★";
        } else if (state.ratingFilterMode === "upto") {
            hint.innerText =
                state.ratingFilterValue >= 9
                ? "All ratings"
                : "Non-starred through "
                    + state.ratingFilterValue
                    + "★";
        } else {
            hint.innerText = "All ratings";
        }
    }

    updateFixedControlsLayout();
}

function loadKeywords() {
    state.keywords = [];
    if (!state.root) {
        renderKeywordFilters();
        return;
    }
    var path = keywordIniPath();
    var data = readIni(path);
    if (!data.Keywords) {
        data.Keywords = { List: "" };
        writeIni(path, data);
    }
    state.keywords = parseKeywordList(getIniValue(data, "Keywords", "List", ""));
    data.Keywords.List = joinKeywords(state.keywords);
    writeIni(path, data);
    pruneActiveFilters();
    renderKeywordFilters();
}

function getParentKeywords(parentPath) {
    var data = readIni(keywordIniPath());
    var section = encodeParentSection(parentPath);
    return parseKeywordList(getIniValue(data, section, "Keywords", ""));
}

function saveParentKeywords(parentPath, words) {
    var path = keywordIniPath();
    var data = readIni(path);
    var section = encodeParentSection(parentPath);
    if (!words.length) {
        delete data[section];
    } else {
        if (!data[section]) {
            data[section] = {};
        }
        data[section].Keywords = joinKeywords(words);
    }
    writeIni(path, data);
}

function addKeyword() {
    var input = document.getElementById("keywordName");
    var word = input.value.replace(/^\s+|\s+$/g, "");
    if (!state.root) {
        alert("Select a galleries root first.");
        return;
    }
    if (!word) {
        alert("Enter a keyword.");
        return;
    }
    if (word.indexOf("|") >= 0) {
        alert("A keyword cannot contain |.");
        return;
    }
    var i;
    for (i = 0; i < state.keywords.length; i++) {
        if (lower(state.keywords[i]) === lower(word)) {
            alert("This keyword already exists.");
            return;
        }
    }
    state.keywords.push(word);
    var data = readIni(keywordIniPath());
    if (!data.Keywords) {
        data.Keywords = {};
    }
    data.Keywords.List = joinKeywords(state.keywords);
    writeIni(keywordIniPath(), data);

    if (state.selectedParent) {
        var assigned = getParentKeywords(state.selectedParent.path);
        assigned.push(word);
        saveParentKeywords(state.selectedParent.path, parseKeywordList(joinKeywords(assigned)));
        state.selectedParent.keywords = getParentKeywords(state.selectedParent.path);
    }

    input.value = "";
    renderKeywordFilters();
    renderParents();
    saveLibraryCache();
    setStatus("Keyword added" + (state.selectedParent ? " and assigned to " + state.selectedParent.name : "") + ": " + word);
}

function clearUnusedKeywords() {
    if (!state.root) {
        return;
    }
    var data = readIni(keywordIniPath());
    var used = {};
    var section;
    for (section in data) {
        if (data.hasOwnProperty(section) && section.indexOf("Parent.") === 0) {
            var words = parseKeywordList(getIniValue(data, section, "Keywords", ""));
            var i;
            for (i = 0; i < words.length; i++) {
                used[lower(words[i])] = true;
            }
        }
    }
    var retained = [];
    var removed = [];
    var j;
    for (j = 0; j < state.keywords.length; j++) {
        if (used[lower(state.keywords[j])]) {
            retained.push(state.keywords[j]);
        } else {
            removed.push(state.keywords[j]);
        }
    }
    state.keywords = retained;
    if (!data.Keywords) {
        data.Keywords = {};
    }
    data.Keywords.List = joinKeywords(retained);
    writeIni(keywordIniPath(), data);
    pruneActiveFilters();
    renderKeywordFilters();
    renderParents();
    setStatus(removed.length ? removed.length + " unused keyword(s) removed." : "All keywords are assigned.");
}

function pruneActiveFilters() {
    var available = {};
    var i;
    for (i = 0; i < state.keywords.length; i++) {
        available[lower(state.keywords[i])] = true;
    }
    var clean = {};
    var key;
    for (key in state.activeFilters) {
        if (state.activeFilters.hasOwnProperty(key) && available[key]) {
            clean[key] = true;
        }
    }
    state.activeFilters = clean;
}

function isCasedKeywordCharacter(character) {
    if (!character) {
        return false;
    }

    return character.toUpperCase() !== character.toLowerCase();
}

function keywordHasCasedCharacter(word) {
    var text = String(word || "");
    var i;

    for (i = 0; i < text.length; i++) {
        if (isCasedKeywordCharacter(text.charAt(i))) {
            return true;
        }
    }

    return false;
}

function firstCasedKeywordCharacter(word) {
    var text = String(word || "");
    var i;

    for (i = 0; i < text.length; i++) {
        if (isCasedKeywordCharacter(text.charAt(i))) {
            return text.charAt(i);
        }
    }

    return "";
}

function keywordCasePattern(word) {
    var text = String(word || "");

    if (keywordHasCasedCharacter(text)
        && text === text.toUpperCase()) {
        return "uppercase";
    }

    if (keywordHasCasedCharacter(text)
        && text === text.toLowerCase()) {
        return "lowercase";
    }

    var firstLetter = firstCasedKeywordCharacter(text);

    if (firstLetter
        && firstLetter === firstLetter.toUpperCase()) {
        return "capital";
    }

    return "other";
}

function keywordFormattingType(word) {
    var text = String(word || "");
    var firstCharacter = text.charAt(0);
    var hasSpecialPrefix =
        firstCharacter
        && !isCasedKeywordCharacter(firstCharacter)
        && !/[0-9]/.test(firstCharacter);
    var caseText =
        hasSpecialPrefix
        ? text.substring(1)
        : text;

    return {
        isSpecial: !!hasSpecialPrefix,
        specialCharacter:
            hasSpecialPrefix
            ? firstCharacter
            : "",
        casePattern: keywordCasePattern(caseText)
    };
}

function sortKeywordWordsCaseInsensitive(words) {
    words.sort(function(leftWord, rightWord) {
        var leftKey = lower(leftWord);
        var rightKey = lower(rightWord);

        if (leftKey < rightKey) {
            return -1;
        }

        if (leftKey > rightKey) {
            return 1;
        }

        if (leftWord < rightWord) {
            return -1;
        }

        if (leftWord > rightWord) {
            return 1;
        }

        return 0;
    });

    return words;
}

function groupedKeywords(words) {
    var patternOrder = [
        "uppercase",
        "capital",
        "lowercase",
        "other"
    ];
    var specialGroups = {};
    var specialCharacterOrder = {};
    var plainGroups = {};
    var i;

    for (i = 0; i < patternOrder.length; i++) {
        var patternName = patternOrder[i];

        specialGroups[patternName] = {};
        specialCharacterOrder[patternName] = [];
        plainGroups[patternName] = {
            key: "plain:" + patternName,
            words: []
        };
    }

    for (i = 0; i < words.length; i++) {
        var word = words[i];
        var formatting = keywordFormattingType(word);
        var casePattern = formatting.casePattern;

        if (formatting.isSpecial) {
            var specialCharacter =
                formatting.specialCharacter;
            var patternGroups =
                specialGroups[casePattern];
            var characterOrder =
                specialCharacterOrder[casePattern];

            if (!patternGroups[specialCharacter]) {
                patternGroups[specialCharacter] = {
                    key:
                        "special:"
                        + casePattern
                        + ":"
                        + specialCharacter,
                    words: []
                };
                characterOrder.push(specialCharacter);
            }

            patternGroups[specialCharacter].words.push(word);
        } else {
            plainGroups[casePattern].words.push(word);
        }
    }

    var result = [];

    // First special-prefix patterns:
    // @UPPERCASE, !Capital, #lowercase, then special Other.
    for (i = 0; i < patternOrder.length; i++) {
        var specialPattern = patternOrder[i];
        var orderedCharacters =
            specialCharacterOrder[specialPattern];
        var characterIndex;

        for (
            characterIndex = 0;
            characterIndex < orderedCharacters.length;
            characterIndex++
        ) {
            var specialGroup =
                specialGroups[specialPattern][
                    orderedCharacters[characterIndex]
                ];
            sortKeywordWordsCaseInsensitive(
                specialGroup.words
            );
            result.push(specialGroup);
        }
    }

    // Then plain patterns:
    // UPPERCASE, Capital, lowercase, then Other.
    for (i = 0; i < patternOrder.length; i++) {
        var plainPattern = patternOrder[i];

        if (plainGroups[plainPattern].words.length) {
            sortKeywordWordsCaseInsensitive(
                plainGroups[plainPattern].words
            );
            result.push(plainGroups[plainPattern]);
        }
    }

    return result;
}

function setKeywordFilterState(word, enabled) {
    if (enabled) {
        state.activeFilters[lower(word)] = true;
    } else {
        delete state.activeFilters[lower(word)];
    }

    renderKeywordFilters();
    renderParents();
}

function createKeywordFilterButton(word) {
    var active = !!state.activeFilters[lower(word)];
    var button = document.createElement("button");

    button.type = "button";
    button.className =
        "keywordFilterButton"
        + (active ? " active" : "");
    button.title =
        active
        ? "Disable keyword filter: " + word
        : "Enable keyword filter: " + word;
    button.innerHTML =
        '<span class="keywordFilterMark">'
        + (active ? "✓" : "")
        + '</span>'
        + '<span class="keywordFilterWord">'
        + escapeHtml(word)
        + '</span>';

    button.onclick = function() {
        setKeywordFilterState(word, !active);
        window.event.cancelBubble = true;
        window.event.returnValue = false;
        return false;
    };

    return button;
}

function renderKeywordFilters() {
    var container = document.getElementById("keywordFilters");
    container.innerHTML = "";

    if (!state.keywords.length) {
        container.innerHTML =
            '<span class="smallMuted">No keywords defined.</span>';
        updateFilterPresetControls();
        updateFixedControlsLayout();
        return;
    }

    var groups = groupedKeywords(state.keywords);
    var groupIndex;

    for (groupIndex = 0; groupIndex < groups.length; groupIndex++) {
        var group = groups[groupIndex];
        var groupElement = document.createElement("div");
        groupElement.className = "keywordFilterGroup";

        var buttons = document.createElement("div");
        buttons.className = "keywordFilterButtons";

        var wordIndex;

        for (wordIndex = 0; wordIndex < group.words.length; wordIndex++) {
            buttons.appendChild(
                createKeywordFilterButton(group.words[wordIndex])
            );
        }

        groupElement.appendChild(buttons);
        container.appendChild(groupElement);
    }

    updateFilterPresetControls();
    updateFixedControlsLayout();
}

function enumerateSubfolders(folderPath) {
    var result = [];
    if (!fso.FolderExists(folderPath)) {
        return result;
    }
    var folder = fso.GetFolder(folderPath);
    var e = new Enumerator(folder.SubFolders);
    for (; !e.atEnd(); e.moveNext()) {
        result.push(e.item().Path);
    }
    result.sort(function(a, b) {
        return lower(fso.GetFileName(a)) < lower(fso.GetFileName(b)) ? -1 : 1;
    });
    return result;
}

function enumerateFiles(folderPath) {
    var result = [];
    if (!fso.FolderExists(folderPath)) {
        return result;
    }
    var folder = fso.GetFolder(folderPath);
    var e = new Enumerator(folder.Files);
    for (; !e.atEnd(); e.moveNext()) {
        result.push(e.item().Path);
    }
    result.sort(function(a, b) {
        return lower(fso.GetFileName(a)) < lower(fso.GetFileName(b)) ? -1 : 1;
    });
    return result;
}

function unsignedHex(value) {
    var unsignedValue = value < 0 ? value + 4294967296 : value;
    var hex = unsignedValue.toString(16);

    while (hex.length < 8) {
        hex = "0" + hex;
    }

    return hex;
}

function thumbnailHash(text) {
    var hashOne = 5381;
    var hashTwo = 0x45d9f3b;
    var i;

    for (i = 0; i < text.length; i++) {
        var code = text.charCodeAt(i);
        hashOne = (((hashOne << 5) + hashOne) ^ code) | 0;
        hashTwo = (
            hashTwo
            ^ ((hashTwo << 5) + (hashTwo >> 2) + code)
        ) | 0;
    }

    return unsignedHex(hashOne) + unsignedHex(hashTwo);
}

function getThumbnailPath(sourcePath) {
    if (!sourcePath || !fso.FileExists(sourcePath)) {
        return "";
    }

    try {
        var file = fso.GetFile(sourcePath);
        var identity =
            lower(normalizePath(sourcePath))
            + "|"
            + String(file.Size)
            + "|"
            + String(new Date(file.DateLastModified).getTime());

        return thumbnailDir + "\\" + thumbnailHash(identity) + ".jpg";
    } catch (error) {
        return "";
    }
}

function resetThumbnailQueue() {
    state.thumbnailQueue = [];
    state.thumbnailQueueMap = {};
    state.thumbnailCompletedCount = 0;
    state.thumbnailFailedCount = 0;
}

function queueThumbnail(sourcePath, thumbnailPath) {
    if (!sourcePath || !thumbnailPath || fso.FileExists(thumbnailPath)) {
        return false;
    }

    var key = lower(thumbnailPath);

    if (state.thumbnailQueueMap[key]) {
        return false;
    }

    state.thumbnailQueueMap[key] = true;
    state.thumbnailQueue.push({
        source: sourcePath,
        destination: thumbnailPath
    });
    return true;
}

function getDisplayThumbnail(thumbnailPath, sourcePath) {
    if (thumbnailPath && fso.FileExists(thumbnailPath)) {
        return thumbnailPath;
    }

    if (sourcePath && fso.FileExists(sourcePath) && isPreviewImage(sourcePath)) {
        return sourcePath;
    }

    return "";
}

function synchronizeParentCover(parent) {
    if (!parent || !parent.path) {
        return false;
    }

    var currentCover = normalizePath(parent.path + "\\folder.jpg");
    var coverExists = fso.FileExists(currentCover);
    var changed = false;

    if (coverExists) {
        var expectedThumbnail = getThumbnailPath(currentCover);

        if (lower(normalizePath(parent.cover || "")) !== lower(currentCover)) {
            parent.cover = currentCover;
            changed = true;
        }

        if (lower(normalizePath(parent.thumbnail || ""))
            !== lower(normalizePath(expectedThumbnail))) {
            parent.thumbnail = expectedThumbnail;
            changed = true;
        }
    } else {
        var cachedCoverName = parent.cover
            ? lower(fso.GetFileName(parent.cover))
            : "";

        if (cachedCoverName === "folder.jpg") {
            parent.cover = "";
            parent.thumbnail = "";
            changed = true;
        }
    }

    return changed;
}

function collectMissingParentThumbnails() {
    resetThumbnailQueue();
    state.thumbnailQueueScope = "main";

    var parentIndex;

    for (parentIndex = 0; parentIndex < state.parents.length; parentIndex++) {
        var parent = state.parents[parentIndex];

        synchronizeParentCover(parent);

        if (!parent.cover) {
            continue;
        }

        var expectedThumbnail = getThumbnailPath(parent.cover);

        if (lower(normalizePath(parent.thumbnail || ""))
            !== lower(normalizePath(expectedThumbnail))) {
            parent.thumbnail = expectedThumbnail;
        }

        queueThumbnail(parent.cover, parent.thumbnail);
    }

    return state.thumbnailQueue.length;
}

function collectMissingGalleryThumbnails(parent) {
    resetThumbnailQueue();
    state.thumbnailQueueScope = "detail";

    if (!parent || !parent.galleries) {
        return 0;
    }

    var galleryIndex;

    for (galleryIndex = 0; galleryIndex < parent.galleries.length; galleryIndex++) {
        var gallery = parent.galleries[galleryIndex];

        if (!gallery.cover) {
            continue;
        }

        if (!gallery.thumbnail) {
            gallery.thumbnail = getThumbnailPath(gallery.cover);
        }

        queueThumbnail(gallery.cover, gallery.thumbnail);
    }

    return state.thumbnailQueue.length;
}

function writeThumbnailQueueFile(queueItems) {
    var queueFile = null;

    try {
        // CreateTextFile(..., true) writes UTF-16LE and avoids passing one
        // enormous BSTR through TextStream.Write, which can fail in HTA.
        queueFile = fso.CreateTextFile(thumbnailQueuePath, true, true);

        var i;

        for (i = 0; i < queueItems.length; i++) {
            queueFile.WriteLine(
                queueItems[i].source
                + "|"
                + queueItems[i].destination
            );
        }

        queueFile.Close();
        queueFile = null;
        return true;
    } catch (error) {
        if (queueFile) {
            try {
                queueFile.Close();
            } catch (closeError) {
            }
        }

        throw error;
    }
}

function startThumbnailGeneration() {
    if (state.thumbnailBuildRunning || !state.thumbnailQueue.length) {
        return false;
    }

    if (!ensureSharedDataDirectory()) {
        return false;
    }

    var batchCount = Math.min(
        state.thumbnailBatchSize,
        state.thumbnailQueue.length
    );
    var batchItems = state.thumbnailQueue.slice(0, batchCount);

    try {
        writeThumbnailQueueFile(batchItems);

        if (fso.FileExists(thumbnailDonePath)) {
            fso.DeleteFile(thumbnailDonePath, true);
        }
    } catch (error) {
        setStatus(
            "Could not create thumbnail queue: "
            + error.message
            + " ["
            + (error.number || "no code")
            + "]"
        );
        return false;
    }

    var command =
        '"'
        + bridgePath
        + '" --thumbnails "'
        + thumbnailQueuePath
        + '" "'
        + thumbnailDonePath
        + '"';

    try {
        shell.Run(command, 0, false);
    } catch (error) {
        setStatus("Could not start thumbnail worker: " + error.message);
        return false;
    }

    // Remove only the batch that was successfully handed to the worker.
    state.thumbnailQueue.splice(0, batchCount);
    state.thumbnailBuildRunning = true;

    var scopeLabel = state.thumbnailQueueScope === "detail"
        ? "detail"
        : "main-list";

    setStatus(
        "Generating "
        + scopeLabel
        + " thumbnail batch of "
        + batchCount
        + "; "
        + state.thumbnailQueue.length
        + " remain queued..."
    );
    return true;
}

function pollThumbnailGeneration() {
    if (!state.thumbnailBuildRunning || !fso.FileExists(thumbnailDonePath)) {
        return false;
    }

    var data = readIni(thumbnailDonePath);
    var created = parseInt(
        getIniValue(data, "Thumbnails", "Created", "0"),
        10
    ) || 0;
    var skipped = parseInt(
        getIniValue(data, "Thumbnails", "Skipped", "0"),
        10
    ) || 0;
    var failed = parseInt(
        getIniValue(data, "Thumbnails", "Failed", "0"),
        10
    ) || 0;
    var errorText = getIniValue(data, "Thumbnails", "Error", "");

    try {
        fso.DeleteFile(thumbnailDonePath, true);

        if (fso.FileExists(thumbnailQueuePath)) {
            fso.DeleteFile(thumbnailQueuePath, true);
        }
    } catch (error) {
    }

    state.thumbnailBuildRunning = false;
    state.thumbnailCompletedCount += created + skipped;
    state.thumbnailFailedCount += failed;

    renderParents();

    if (isGalleryDialogOpen() && state.selectedParent) {
        openGalleryDialog(state.selectedParent);
    }

    scheduleVisibleThumbnailRefresh();
    saveLibraryCache();

    if (errorText) {
        setStatus("Thumbnail worker error: " + errorText);
        return true;
    }

    if (state.thumbnailQueue.length > 0) {
        setStatus(
            "Thumbnail cache: "
            + state.thumbnailCompletedCount
            + " completed, "
            + state.thumbnailFailedCount
            + " failed; starting next batch..."
        );
        startThumbnailGeneration();
    } else {
        var finishedScope = state.thumbnailQueueScope === "detail"
            ? "Detail"
            : "Main-list";

        setStatus(
            finishedScope
            + " thumbnail cache updated: "
            + state.thumbnailCompletedCount
            + " completed, "
            + state.thumbnailFailedCount
            + " failed."
        );

        state.thumbnailQueueMap = {};
        state.thumbnailQueueScope = "";
    }

    return true;
}

function imageExtension(path) {
    return lower(fso.GetExtensionName(path));
}

function isSupportedImage(path) {
    var ext = imageExtension(path);
    return /^(jpg|jpeg|png|gif|bmp|tif|tiff|webp|heic|jfif)$/.test(ext);
}

function isPreviewImage(path) {
    var ext = imageExtension(path);
    return /^(jpg|jpeg|png|gif|bmp)$/.test(ext);
}

function getGalleryImageInfo(folderPath) {
    var files = enumerateFiles(folderPath);
    var info = {
        hasImages: false,
        preview: ""
    };
    var i;

    for (i = 0; i < files.length; i++) {
        if (!isSupportedImage(files[i])) {
            continue;
        }

        info.hasImages = true;

        // The generated-thumbnail worker can convert all supported formats.
        if (!info.preview) {
            info.preview = files[i];
        }
    }

    return info;
}

function firstInteger(nameOrPath) {
    var name = fso.GetBaseName(nameOrPath);
    if (fso.FolderExists(nameOrPath)) {
        name = fso.GetFileName(nameOrPath);
    }
    var match = String(name).match(/\d+/);
    return match ? parseInt(match[0], 10) : null;
}

function findPairedVideo(parentPath, galleryPath) {
    var number = firstInteger(galleryPath);
    if (number === null) {
        return "";
    }
    var files = enumerateFiles(parentPath);
    var matches = [];
    var i;
    for (i = 0; i < files.length; i++) {
        var ext = lower(fso.GetExtensionName(files[i]));
        if ((ext === "mp4" || ext === "wmv") && firstInteger(files[i]) === number) {
            matches.push(files[i]);
        }
    }
    return matches.length ? matches[0] : "";
}

function encodeCacheField(value) {
    return encodeURIComponent(String(value || ""));
}

function decodeCacheField(value) {
    try {
        return decodeURIComponent(String(value || ""));
    } catch (error) {
        return "";
    }
}

function saveLibraryCache() {
    if (!state.root || !state.parents.length) {
        if (fso.FileExists(cachePath)) {
            try {
                fso.DeleteFile(cachePath, true);
            } catch (error) {
            }
        }
        return false;
    }

    var lines = [];
    lines.push("GallerySlideshowCache\t" + CACHE_VERSION);
    lines.push("Root\t" + encodeCacheField(state.root));

    var parentIndex;
    for (parentIndex = 0; parentIndex < state.parents.length; parentIndex++) {
        var parent = state.parents[parentIndex];

        lines.push([
            "P",
            String(parentIndex),
            encodeCacheField(parent.letter),
            encodeCacheField(parent.name),
            encodeCacheField(parent.path),
            encodeCacheField(parent.cover),
            encodeCacheField(parent.thumbnail),
            encodeCacheField(joinKeywords(parent.keywords))
        ].join("\t"));

        var galleryIndex;
        for (galleryIndex = 0; galleryIndex < parent.galleries.length; galleryIndex++) {
            var gallery = parent.galleries[galleryIndex];

            lines.push([
                "G",
                String(parentIndex),
                encodeCacheField(gallery.name),
                encodeCacheField(gallery.path),
                encodeCacheField(gallery.cover),
                encodeCacheField(gallery.thumbnail),
                encodeCacheField(gallery.video)
            ].join("\t"));
        }
    }

    try {
        writeText(cachePath, lines.join("\r\n"));
        return true;
    } catch (error) {
        setStatus("Library loaded, but cache could not be written: " + error.message);
        return false;
    }
}

function loadLibraryCache() {
    if (!state.root || !fso.FileExists(cachePath)) {
        return false;
    }

    var lines = readText(cachePath).replace(/\r/g, "").split("\n");

    if (lines.length < 2 || lines[0] !== "GallerySlideshowCache\t" + CACHE_VERSION) {
        return false;
    }

    var rootParts = lines[1].split("\t");

    if (rootParts.length < 2
        || lower(normalizePath(decodeCacheField(rootParts[1]))) !== lower(state.root)) {
        return false;
    }

    var parentsByIndex = {};
    var cachedParents = [];
    var i;

    for (i = 2; i < lines.length; i++) {
        if (!lines[i]) {
            continue;
        }

        var fields = lines[i].split("\t");

        if (fields[0] === "P" && fields.length >= 8) {
            var parentIndex = parseInt(fields[1], 10);

            if (isNaN(parentIndex)) {
                continue;
            }

            var parent = {
                letter: decodeCacheField(fields[2]),
                name: decodeCacheField(fields[3]),
                path: decodeCacheField(fields[4]),
                cover: decodeCacheField(fields[5]),
                thumbnail: decodeCacheField(fields[6]),
                keywords: parseKeywordList(decodeCacheField(fields[7])),
                galleries: []
            };

            parentsByIndex[parentIndex] = parent;
            cachedParents.push(parent);
        } else if (fields[0] === "G" && fields.length >= 7) {
            var ownerIndex = parseInt(fields[1], 10);

            if (isNaN(ownerIndex) || !parentsByIndex[ownerIndex]) {
                continue;
            }

            parentsByIndex[ownerIndex].galleries.push({
                name: decodeCacheField(fields[2]),
                path: decodeCacheField(fields[3]),
                cover: decodeCacheField(fields[4]),
                thumbnail: decodeCacheField(fields[5]),
                video: decodeCacheField(fields[6])
            });
        }
    }

    if (!cachedParents.length) {
        return false;
    }

    state.parents = cachedParents;
    state.selectedParent = null;

    var missingParentThumbnailCount = collectMissingParentThumbnails();

    refreshParentRatings();
    saveLibraryCache();

    if (missingParentThumbnailCount > 0) {
        startThumbnailGeneration();
    } else {
        setStatus(
            state.parents.length
            + " parent galleries loaded from cache. Use Refresh library after folder changes."
        );
    }

    return true;
}

function scanLibrary() {
    closeGalleryDialog();
    state.parents = [];
    state.selectedParent = null;
    resetThumbnailQueue();
    state.thumbnailQueueScope = "main";

    if (!state.root || !fso.FolderExists(state.root)) {
        renderParents();
        setStatus("Select an existing galleries root.");
        return;
    }

    setStatus("Scanning parent galleries...");
    loadKeywords();

    var letterFolders = enumerateSubfolders(state.root);
    var i;
    for (i = 0; i < letterFolders.length; i++) {
        var letter = fso.GetFileName(letterFolders[i]);
        if (!/^[A-Z]$/i.test(letter)) {
            continue;
        }
        var parentFolders = enumerateSubfolders(letterFolders[i]);
        var j;
        for (j = 0; j < parentFolders.length; j++) {
            var parentPath = parentFolders[j];
            var galleryFolders = enumerateSubfolders(parentPath);
            var galleries = [];
            var k;
            for (k = 0; k < galleryFolders.length; k++) {
                var galleryName = fso.GetFileName(galleryFolders[k]);
                if (/^(_DELETE|_CROP|_DUPLICATES|_SMALL)$/i.test(galleryName)) {
                    continue;
                }
                var imageInfo = getGalleryImageInfo(galleryFolders[k]);

                if (!imageInfo.hasImages) {
                    continue;
                }

                var galleryThumbnail = getThumbnailPath(imageInfo.preview);

                galleries.push({
                    path: galleryFolders[k],
                    name: galleryName,
                    cover: imageInfo.preview,
                    thumbnail: galleryThumbnail,
                    video: findPairedVideo(parentPath, galleryFolders[k])
                });
            }
            if (!galleries.length) {
                continue;
            }
            var parentCover = fso.FileExists(parentPath + "\\folder.jpg")
                ? parentPath + "\\folder.jpg"
                : "";
            var parentThumbnail = getThumbnailPath(parentCover);
            queueThumbnail(parentCover, parentThumbnail);

            state.parents.push({
                path: parentPath,
                name: fso.GetFileName(parentPath),
                letter: letter.toUpperCase(),
                cover: parentCover,
                thumbnail: parentThumbnail,
                rating: getParentRating(parentPath),
                keywords: getParentKeywords(parentPath),
                galleries: galleries
            });
        }
    }

    state.parents.sort(function(a, b) {
        var ak = a.letter + "\\" + lower(a.name);
        var bk = b.letter + "\\" + lower(b.name);
        return ak < bk ? -1 : (ak > bk ? 1 : 0);
    });

    renderParents();
    saveLibraryCache();

    if (!startThumbnailGeneration()) {
        setStatus(
            state.parents.length
            + " parent galleries scanned and cached. Detail thumbnails will be generated on demand."
        );
    }
}

function getVisibleParents() {
    var visibleParents = [];
    var i;

    for (i = 0; i < state.parents.length; i++) {
        if (parentMatches(state.parents[i])) {
            visibleParents.push(state.parents[i]);
        }
    }

    return visibleParents;
}

function navigationMembershipSignature(visibleParents) {
    var parts = [];
    var parentIndex;
    var galleryIndex;

    for (
        parentIndex = 0;
        parentIndex < visibleParents.length;
        parentIndex++
    ) {
        var parent = visibleParents[parentIndex];
        parts.push("P:" + lower(parent.path));

        for (
            galleryIndex = 0;
            galleryIndex < parent.galleries.length;
            galleryIndex++
        ) {
            parts.push(
                "G:"
                + lower(
                    normalizePath(
                        parent.galleries[galleryIndex].path
                    )
                )
            );
        }
    }

    return parts.join("\n");
}

function shuffledCopyDifferent(sourceItems) {
    var original = sourceItems.slice(0);
    var shuffled = sourceItems.slice(0);
    var index;

    for (
        index = shuffled.length - 1;
        index > 0;
        index--
    ) {
        var swapIndex = Math.floor(
            Math.random() * (index + 1)
        );
        var temporary = shuffled[index];
        shuffled[index] = shuffled[swapIndex];
        shuffled[swapIndex] = temporary;
    }

    if (shuffled.length > 1) {
        var unchanged = true;

        for (index = 0; index < shuffled.length; index++) {
            if (shuffled[index] !== original[index]) {
                unchanged = false;
                break;
            }
        }

        // A valid random shuffle can equal the source order.
        // Rotate once so RANDOM SLIDESHOW visibly changes the order.
        if (unchanged) {
            shuffled.push(shuffled.shift());
        }
    }

    return shuffled;
}

function findVisibleParentByPath(
    visibleParents,
    parentPath
) {
    var normalizedTarget = lower(
        normalizePath(parentPath || "")
    );
    var i;

    if (!normalizedTarget) {
        return null;
    }

    for (i = 0; i < visibleParents.length; i++) {
        if (
            lower(normalizePath(visibleParents[i].path))
            === normalizedTarget
        ) {
            return visibleParents[i];
        }
    }

    return null;
}

function establishRandomNavigationOrder(
    visibleParents,
    preferredParentPath,
    preferredGalleryPath
) {
    var preferredParent = findVisibleParentByPath(
        visibleParents,
        preferredParentPath
    );
    var remainingParents = [];
    var parentIndex;

    for (
        parentIndex = 0;
        parentIndex < visibleParents.length;
        parentIndex++
    ) {
        if (
            preferredParent
            && lower(visibleParents[parentIndex].path)
                === lower(preferredParent.path)
        ) {
            continue;
        }

        remainingParents.push(visibleParents[parentIndex]);
    }

    var orderedParents =
        shuffledCopyDifferent(remainingParents);

    if (preferredParent) {
        orderedParents.unshift(preferredParent);
    } else {
        orderedParents =
            shuffledCopyDifferent(visibleParents);
    }

    state.navigationOrderMode = "random";
    state.randomMembershipSignature =
        navigationMembershipSignature(visibleParents);
    state.randomParentOrder = [];
    state.randomGalleryOrders = {};

    var preferredGalleryKey = lower(
        normalizePath(preferredGalleryPath || "")
    );

    for (
        parentIndex = 0;
        parentIndex < orderedParents.length;
        parentIndex++
    ) {
        var parent = orderedParents[parentIndex];
        var parentKey = lower(normalizePath(parent.path));
        var preferredGallery = null;
        var remainingGalleries = [];
        var galleryIndex;

        for (
            galleryIndex = 0;
            galleryIndex < parent.galleries.length;
            galleryIndex++
        ) {
            var gallery = parent.galleries[galleryIndex];
            var galleryKey = lower(
                normalizePath(gallery.path)
            );

            if (
                preferredGalleryKey
                && galleryKey === preferredGalleryKey
            ) {
                preferredGallery = gallery;
            } else {
                remainingGalleries.push(gallery);
            }
        }

        var orderedGalleries =
            shuffledCopyDifferent(remainingGalleries);

        if (preferredGallery) {
            orderedGalleries.unshift(preferredGallery);
        } else {
            orderedGalleries = shuffledCopyDifferent(
                parent.galleries
            );
        }

        state.randomParentOrder.push(parent.path);
        state.randomGalleryOrders[parentKey] = [];

        for (
            galleryIndex = 0;
            galleryIndex < orderedGalleries.length;
            galleryIndex++
        ) {
            state.randomGalleryOrders[parentKey].push(
                normalizePath(
                    orderedGalleries[galleryIndex].path
                )
            );
        }
    }

    return buildRandomNavigationPaths(visibleParents);
}

function buildRandomNavigationPaths(visibleParents) {
    var parentLookup = {};
    var parentIndex;
    var galleryIndex;

    for (
        parentIndex = 0;
        parentIndex < visibleParents.length;
        parentIndex++
    ) {
        parentLookup[
            lower(normalizePath(visibleParents[parentIndex].path))
        ] = visibleParents[parentIndex];
    }

    var paths = [];

    for (
        parentIndex = 0;
        parentIndex < state.randomParentOrder.length;
        parentIndex++
    ) {
        var parentPath =
            state.randomParentOrder[parentIndex];
        var parentKey = lower(normalizePath(parentPath));
        var parent = parentLookup[parentKey];
        var orderedGalleryPaths =
            state.randomGalleryOrders[parentKey] || [];

        if (!parent) {
            continue;
        }

        var galleryLookup = {};

        for (
            galleryIndex = 0;
            galleryIndex < parent.galleries.length;
            galleryIndex++
        ) {
            galleryLookup[
                lower(
                    normalizePath(
                        parent.galleries[galleryIndex].path
                    )
                )
            ] = normalizePath(
                parent.galleries[galleryIndex].path
            );
        }

        for (
            galleryIndex = 0;
            galleryIndex < orderedGalleryPaths.length;
            galleryIndex++
        ) {
            var galleryKey = lower(
                normalizePath(
                    orderedGalleryPaths[galleryIndex]
                )
            );

            if (galleryLookup[galleryKey]) {
                paths.push(galleryLookup[galleryKey]);
            }
        }
    }

    return paths;
}

function resolveNavigationGalleryPaths(visibleParents) {
    if (state.navigationOrderMode !== "random") {
        return buildFilteredGalleryPaths(visibleParents);
    }

    var membership =
        navigationMembershipSignature(visibleParents);
    var currentPaths =
        buildRandomNavigationPaths(visibleParents);
    var expectedGalleryCount =
        buildFilteredGalleryPaths(visibleParents).length;

    if (
        membership !== state.randomMembershipSignature
        || currentPaths.length !== expectedGalleryCount
    ) {
        return establishRandomNavigationOrder(
            visibleParents,
            state.currentParentPath,
            state.currentGalleryPath
        );
    }

    return currentPaths;
}

function activateRandomNavigation(
    visibleParents,
    preferredParentPath,
    preferredGalleryPath
) {
    var paths = establishRandomNavigationOrder(
        visibleParents,
        preferredParentPath,
        preferredGalleryPath
    );

    state.filteredQueueSignature = null;
    updateFilteredNavigationQueue(visibleParents);
    return paths;
}

function activateNormalNavigation(visibleParents) {
    state.navigationOrderMode = "normal";
    state.randomMembershipSignature = "";
    state.randomParentOrder = [];
    state.randomGalleryOrders = {};
    state.filteredQueueSignature = null;
    updateFilteredNavigationQueue(visibleParents);
    return true;
}

function findGalleryEntryByPath(galleryPath) {
    var target = lower(normalizePath(galleryPath || ""));
    var parentIndex;
    var galleryIndex;

    for (
        parentIndex = 0;
        parentIndex < state.parents.length;
        parentIndex++
    ) {
        for (
            galleryIndex = 0;
            galleryIndex
                < state.parents[parentIndex].galleries.length;
            galleryIndex++
        ) {
            var gallery =
                state.parents[parentIndex].galleries[galleryIndex];

            if (
                lower(normalizePath(gallery.path))
                === target
            ) {
                return {
                    parent: state.parents[parentIndex],
                    gallery: gallery
                };
            }
        }
    }

    return null;
}

function buildFilteredGalleryPaths(visibleParents) {
    var paths = [];
    var parentIndex;
    var galleryIndex;

    for (
        parentIndex = 0;
        parentIndex < visibleParents.length;
        parentIndex++
    ) {
        var galleries = visibleParents[parentIndex].galleries;

        for (
            galleryIndex = 0;
            galleryIndex < galleries.length;
            galleryIndex++
        ) {
            if (galleries[galleryIndex].path) {
                paths.push(
                    normalizePath(galleries[galleryIndex].path)
                );
            }
        }
    }

    return paths;
}

function buildParentPathsFromGalleryPaths(paths) {
    var parentPaths = [];
    var seenParents = {};
    var i;

    for (i = 0; i < paths.length; i++) {
        var parentPath = normalizePath(
            fso.GetParentFolderName(paths[i])
        );
        var parentKey = lower(parentPath);

        if (parentPath && !seenParents[parentKey]) {
            seenParents[parentKey] = true;
            parentPaths.push(parentPath);
        }
    }

    return parentPaths;
}

function updateFilteredNavigationQueue(visibleParents) {
    var paths =
        resolveNavigationGalleryPaths(visibleParents);
    var parentPaths =
        buildParentPathsFromGalleryPaths(paths);
    var signatureParts = [
        state.navigationOrderMode
    ];
    var i;

    for (i = 0; i < paths.length; i++) {
        signatureParts.push(lower(paths[i]));
    }

    var signature = signatureParts.join("\n");

    if (signature === state.filteredQueueSignature) {
        return true;
    }

    var data = {
        Queue: {
            Valid: "1",
            Revision:
                String(new Date().getTime())
                + "-"
                + String(Math.floor(Math.random() * 100000)),
            Count: String(paths.length),
            ParentCount: String(parentPaths.length),
            Mode: state.navigationOrderMode
        }
    };

    for (i = 0; i < paths.length; i++) {
        data.Queue["Item" + (i + 1)] = paths[i];
    }

    for (i = 0; i < parentPaths.length; i++) {
        data.Queue["ParentItem" + (i + 1)] =
            parentPaths[i];
    }

    if (
        !writeText(
            filteredNavigationPath,
            serializeIni(data),
            false
        )
    ) {
        setStatus(
            "Could not update the filtered navigation queue."
        );
        return false;
    }

    state.filteredQueueSignature = signature;
    sendCommand("refreshnavigation", "");
    return true;
}

function parentMatches(parent) {
    var search = lower(state.searchText);
    if (search && lower(parent.name).indexOf(search) < 0) {
        return false;
    }

    var parentRating = parseInt(parent.rating, 10) || 0;

    if (state.ratingFilterMode === "exact"
        && state.ratingFilterValue >= 0
        && parentRating !== state.ratingFilterValue) {
        return false;
    }

    if (state.ratingFilterMode === "upto"
        && state.ratingFilterValue >= 0
        && parentRating > state.ratingFilterValue) {
        return false;
    }

    var hasFilter = false;
    var key;
    for (key in state.activeFilters) {
        if (state.activeFilters.hasOwnProperty(key)) {
            hasFilter = true;
            break;
        }
    }
    if (!hasFilter) {
        return true;
    }
    var i;
    for (i = 0; i < parent.keywords.length; i++) {
        if (state.activeFilters[lower(parent.keywords[i])]) {
            return true;
        }
    }
    return false;
}

function renderParents() {
    var grid = document.getElementById("parentGrid");
    grid.innerHTML = "";

    var visible = getVisibleParents();
    var groups = {};
    var letters = [];
    var i;

    for (i = 0; i < visible.length; i++) {
        var parent = visible[i];

        var letter = parent.letter
            ? String(parent.letter).toUpperCase()
            : "#";

        if (!groups[letter]) {
            groups[letter] = [];
            letters.push(letter);
        }

        groups[letter].push(parent);
    }

    updateFilteredNavigationQueue(visible);

    document.getElementById("summaryTitle").innerText = "Parent galleries";
    document.getElementById("emptyState").style.display =
        visible.length ? "none" : "block";

    if (state.displayMode === "tile") {
        grid.className = "tileView";
        document.getElementById("summaryText").innerText =
            visible.length
            + " shown / "
            + state.parents.length
            + " total · Tile view";

        for (i = 0; i < visible.length; i++) {
            grid.appendChild(createParentTile(visible[i]));
        }

        scheduleVisibleThumbnailRefresh();
        return;
    }

    grid.className = "sectionView";
    document.getElementById("summaryText").innerText =
        visible.length
        + " shown / "
        + state.parents.length
        + " total · "
        + letters.length
        + " letter groups";

    if (!visible.length) {
        state.expandedLetter = "";
        scheduleVisibleThumbnailRefresh();
        return;
    }

    if (!state.expandedLetter || !groups[state.expandedLetter]) {
        var preferredLetter = "";

        if (state.selectedParent && state.selectedParent.letter) {
            preferredLetter = String(
                state.selectedParent.letter
            ).toUpperCase();
        } else if (state.currentParentPath) {
            for (i = 0; i < visible.length; i++) {
                if (lower(visible[i].path) === lower(state.currentParentPath)) {
                    preferredLetter = String(
                        visible[i].letter || ""
                    ).toUpperCase();
                    break;
                }
            }
        }

        state.expandedLetter = groups[preferredLetter]
            ? preferredLetter
            : letters[0];
    }

    for (i = 0; i < letters.length; i++) {
        grid.appendChild(
            createLetterRollout(
                letters[i],
                groups[letters[i]]
            )
        );
    }

    scheduleVisibleThumbnailRefresh();
}

function createLetterRollout(letter, parents) {
    var rollout = document.createElement("div");
    var isOpen = state.expandedLetter === letter;

    rollout.className =
        "letterRollout"
        + (isOpen ? " open" : "");

    var header = document.createElement("div");
    header.className = "letterRolloutHeader";
    header.title = isOpen
        ? "Collapse " + letter
        : "Show galleries beginning with " + letter;

    header.innerHTML =
        '<span class="letterRolloutArrow">'
        + (isOpen ? "▼" : "▶")
        + '</span>'
        + '<span class="letterRolloutName">'
        + escapeHtml(letter)
        + '</span>'
        + '<span class="letterRolloutCount">'
        + parents.length
        + (parents.length === 1 ? " parent" : " parents")
        + '</span>'
        + '<span class="letterRolloutHint">'
        + (isOpen ? "click to collapse" : "click to expand")
        + '</span>';

    header.onclick = function() {
        toggleLetterRollout(letter);
        window.event.cancelBubble = true;
        window.event.returnValue = false;
        return false;
    };

    rollout.appendChild(header);

    if (isOpen) {
        var body = document.createElement("div");
        body.className = "letterRolloutBody";

        var i;

        for (i = 0; i < parents.length; i++) {
            body.appendChild(createParentTile(parents[i]));
        }

        rollout.appendChild(body);
    }

    return rollout;
}

function toggleLetterRollout(letter) {
    state.expandedLetter =
        state.expandedLetter === letter
        ? ""
        : letter;

    renderParents();
}

function createParentTile(parent) {
    var tile = document.createElement("div");
    var selected = state.selectedParent && lower(state.selectedParent.path) === lower(parent.path);
    var running = lower(state.currentParentPath) === lower(parent.path);
    tile.className = "parentTile" + (selected ? " selected" : "") + (running ? " running" : "");
    tile.title = parent.path;
    tile.tabIndex = -1;
    tile._parentPath = normalizePath(parent.path);

    var cover = document.createElement("div");
    cover.className = "parentCover";
    configureLazyCover(
        cover,
        parent.thumbnail,
        parent.cover,
        parent.name.charAt(0).toUpperCase()
    );
    var badge = document.createElement("span");
    badge.className = "letterBadge";
    badge.innerText = parent.letter;
    cover.appendChild(badge);

    var body = document.createElement("div");
    body.className = "parentBody";
    var videoCount = 0;
    var i;
    for (i = 0; i < parent.galleries.length; i++) {
        if (parent.galleries[i].video) {
            videoCount++;
        }
    }
    var parentRating = parseInt(parent.rating, 10) || 0;

    body.innerHTML =
        '<div class="parentName">' + escapeHtml(parent.name) + '</div>' +
        '<div class="parentMeta">' +
            '<span>' + parent.galleries.length + ' galleries · ' + videoCount + ' videos</span>' +
            '<span class="ratingBadge' + (parentRating === 0 ? ' zero' : '') + '"' +
                ' title="' + escapeHtml(ratingText(parentRating)) + '">' +
                parentRating + '★' +
            '</span>' +
        '</div>' +
        '<div class="keywordBadges">' + keywordBadgeHtml(parent.keywords) + '</div>';

    tile.appendChild(cover);
    tile.appendChild(body);

    tile.onclick = function() {
        var eventObject = window.event;

        // In legacy IE events left can be 1; in standards mode it is 0.
        if (eventObject
            && typeof eventObject.button !== "undefined"
            && eventObject.button !== 0
            && eventObject.button !== 1) {
            eventObject.returnValue = false;
            return false;
        }

        if (state.parentClickTimer) {
            window.clearTimeout(state.parentClickTimer);
        }

        state.parentClickTimer = window.setTimeout(function() {
            state.parentClickTimer = 0;
            selectParent(parent);
        }, 260);

        return true;
    };
    tile.ondblclick = function() {
        var eventObject = window.event;

        if (eventObject
            && typeof eventObject.button !== "undefined"
            && eventObject.button !== 0
            && eventObject.button !== 1) {
            eventObject.returnValue = false;
            return false;
        }

        if (state.parentClickTimer) {
            window.clearTimeout(state.parentClickTimer);
            state.parentClickTimer = 0;
        }

        state.selectedParent = parent;
        state.expandedLetter = parent.letter
            ? String(parent.letter).toUpperCase()
            : state.expandedLetter;
        renderParents();
        openGalleryDialog(parent);

        return true;
    };
    tile.oncontextmenu = function() {
        if (state.parentClickTimer) {
            window.clearTimeout(state.parentClickTimer);
            state.parentClickTimer = 0;
        }

        state.selectedParent = parent;
        state.expandedLetter = parent.letter
            ? String(parent.letter).toUpperCase()
            : state.expandedLetter;
        renderParents();
        showKeywordContext(parent, window.event.clientX, window.event.clientY);
        window.event.cancelBubble = true;
        window.event.returnValue = false;
        return false;
    };
    return tile;
}

function keywordBadgeHtml(words) {
    var html = "";
    var i;
    for (i = 0; i < words.length; i++) {
        html += '<span class="keywordBadge">' + escapeHtml(words[i]) + '</span>';
    }
    return html;
}

function selectParent(parent) {
    state.selectedParent = parent;
    state.expandedLetter = parent.letter
        ? String(parent.letter).toUpperCase()
        : state.expandedLetter;
    renderParents();

    window.setTimeout(function() {
        focusParentThumbnail(parent.path);
    }, 0);

    setStatus(
        "Selected gallery: "
        + parent.name
    );
    return true;
}

function sizeGalleryDialog(galleryCount) {
    var dialog = document.getElementById("galleryDialog");

    if (!dialog) {
        return false;
    }

    var viewportWidth = Math.max(
        320,
        document.documentElement.clientWidth
    );
    var viewportHeight = Math.max(
        240,
        document.documentElement.clientHeight
    );

    var outerMargin = 24;
    var headerHeight = 92;
    var gridPadding = 24;
    var cardOuterWidth = 224;
    var cardOuterHeight = 198;
    var count = Math.max(0, parseInt(galleryCount, 10) || 0);

    var maximumWidth = Math.max(
        320,
        viewportWidth - (outerMargin * 2)
    );
    var maximumHeight = Math.max(
        240,
        viewportHeight - (outerMargin * 2)
    );

    var maximumColumns = Math.max(
        1,
        Math.floor(
            (maximumWidth - gridPadding)
            / cardOuterWidth
        )
    );
    maximumColumns = Math.min(maximumColumns, 5);

    var preferredColumns = count > 0
        ? Math.ceil(Math.sqrt(count * 1.45))
        : 1;
    var columns = Math.max(
        1,
        Math.min(count || 1, preferredColumns, maximumColumns)
    );
    var rows = count > 0
        ? Math.ceil(count / columns)
        : 1;

    var minimumDialogWidth = Math.min(540, maximumWidth);
    var desiredWidth = Math.max(
        minimumDialogWidth,
        gridPadding + (columns * cardOuterWidth)
    );
    var desiredHeight =
        headerHeight
        + gridPadding
        + (rows * cardOuterHeight);

    var dialogWidth = Math.min(maximumWidth, desiredWidth);
    var dialogHeight = Math.min(
        maximumHeight,
        Math.max(270, desiredHeight)
    );

    var dialogLeft = Math.max(
        outerMargin,
        Math.floor((viewportWidth - dialogWidth) / 2)
    );
    var dialogTop = Math.max(
        outerMargin,
        Math.floor((viewportHeight - dialogHeight) / 2)
    );

    dialog.style.left = dialogLeft + "px";
    dialog.style.top = dialogTop + "px";
    dialog.style.right = "auto";
    dialog.style.bottom = "auto";
    dialog.style.width = dialogWidth + "px";
    dialog.style.height = dialogHeight + "px";

    return true;
}

function focusGalleryCardElement(card) {
    if (!card) {
        return false;
    }

    try {
        card.focus();
    } catch (error) {
    }

    try {
        card.scrollIntoView(false);
    } catch (scrollError) {
        var grid = document.getElementById(
            "galleryGrid"
        );

        if (grid) {
            grid.scrollTop =
                Math.max(
                    0,
                    card.offsetTop
                    - Math.floor(
                        grid.clientHeight / 2
                    )
                );
        }
    }

    scheduleVisibleThumbnailRefresh();
    return true;
}

function findParentTileByPath(parentPath) {
    var normalizedParent = lower(
        normalizePath(parentPath || "")
    );
    var grid = document.getElementById(
        "parentGrid"
    );

    if (!normalizedParent || !grid) {
        return null;
    }

    var elements = grid.getElementsByTagName(
        "div"
    );
    var i;

    for (i = 0; i < elements.length; i++) {
        var element = elements[i];
        var className =
            " " + (element.className || "") + " ";

        if (
            className.indexOf(" parentTile ") < 0
            || !element._parentPath
        ) {
            continue;
        }

        if (
            lower(element._parentPath)
            === normalizedParent
        ) {
            return element;
        }
    }

    return null;
}

function focusParentThumbnail(parentPath) {
    var tile = findParentTileByPath(parentPath);

    if (!tile) {
        return false;
    }

    try {
        tile.focus();
    } catch (error) {
    }

    try {
        tile.scrollIntoView(false);
    } catch (scrollError) {
        var content = document.getElementById(
            "content"
        );

        if (content) {
            content.scrollTop =
                Math.max(
                    0,
                    tile.offsetTop
                    - Math.floor(
                        content.clientHeight / 2
                    )
                );
        }
    }

    scheduleVisibleThumbnailRefresh();
    return true;
}

function focusRunningGalleryThumbnail(galleryPath) {
    var normalizedGallery = normalizePath(
        galleryPath || ""
    );

    if (!normalizedGallery) {
        return false;
    }

    var entry = findGalleryEntryByPath(
        normalizedGallery
    );

    if (!entry) {
        return false;
    }

    state.selectedParent = entry.parent;
    state.expandedLetter = entry.parent.letter
        ? String(entry.parent.letter).toUpperCase()
        : state.expandedLetter;

    renderParents();

    window.setTimeout(function() {
        focusParentThumbnail(
            entry.parent.path
        );
    }, 0);

    return true;
}

function openGalleryDialog(parent, focusGalleryPath) {
    state.selectedGallery = null;
    document.getElementById("galleryTitle").innerText =
        parent.name;
    document.getElementById("galleryKeywords").innerText =
        parent.keywords.length
        ? parent.keywords.join(", ")
        : "";

    var grid = document.getElementById(
        "galleryGrid"
    );
    grid.innerHTML = "";

    var normalizedFocusPath = lower(
        normalizePath(focusGalleryPath || "")
    );
    var focusGallery = null;
    var focusCard = null;
    var i;

    for (i = 0; i < parent.galleries.length; i++) {
        var gallery = parent.galleries[i];
        var card = createGalleryCard(gallery);
        grid.appendChild(card);

        if (
            normalizedFocusPath
            && lower(normalizePath(gallery.path))
                === normalizedFocusPath
        ) {
            focusGallery = gallery;
            focusCard = card;
        }
    }

    sizeGalleryDialog(parent.galleries.length);
    document.getElementById(
        "galleryOverlay"
    ).style.display = "block";

    if (focusGallery && focusCard) {
        selectGalleryCard(
            focusGallery,
            focusCard,
            true
        );
        window.setTimeout(function() {
            focusGalleryCardElement(focusCard);
        }, 0);
    } else {
        updateSelectedGalleryButton();
    }

    scheduleVisibleThumbnailRefresh();

    if (
        !state.thumbnailBuildRunning
        && collectMissingGalleryThumbnails(parent) > 0
    ) {
        startThumbnailGeneration();
    }
}

function closeGalleryDialog() {
    document.getElementById("galleryOverlay").style.display = "none";
    state.selectedGallery = null;
    updateSelectedGalleryButton();
    hideContextMenu();
}

function isGalleryDialogOpen() {
    return document.getElementById("galleryOverlay").style.display === "block";
}

function updateSelectedGalleryButton() {
    var button = document.getElementById(
        "startSelectedRandomButton"
    );

    if (!button) {
        return false;
    }

    var hasParentGalleries = !!(
        state.selectedParent
        && state.selectedParent.galleries
        && state.selectedParent.galleries.length
    );

    button.disabled = !hasParentGalleries;

    if (button.disabled) {
        button.title =
            "This parent has no available galleries.";
    } else if (
        state.selectedGallery
        && state.selectedGallery.path
    ) {
        button.title =
            "Start random slideshow from "
            + state.selectedGallery.name;
    } else {
        button.title =
            "Start random slideshow from a random "
            + "gallery in this parent.";
    }

    return true;
}

function clearSelectedGallery() {
    state.selectedGallery = null;

    var grid = document.getElementById("galleryGrid");

    if (grid) {
        var cards = grid.getElementsByTagName("div");
        var i;

        for (i = 0; i < cards.length; i++) {
            if (
                (" " + cards[i].className + " ")
                    .indexOf(" galleryCard ") >= 0
            ) {
                cards[i].className =
                    cards[i].className
                        .replace(/\s*selected\b/g, "");
            }
        }
    }

    updateSelectedGalleryButton();
    return true;
}

function selectGalleryCard(
    gallery,
    card,
    suppressStatus
) {
    clearSelectedGallery();

    state.selectedGallery = gallery;

    if (
        (" " + card.className + " ")
            .indexOf(" selected ") < 0
    ) {
        card.className += " selected";
    }

    updateSelectedGalleryButton();

    if (!suppressStatus) {
        setStatus(
            "Selected gallery: "
            + gallery.name
        );
    }

    return true;
}

function startRandomFromSelectedGallery() {
    var parent = state.selectedParent;

    if (
        !parent
        || !parent.galleries
        || !parent.galleries.length
    ) {
        setStatus(
            "This parent has no available galleries."
        );
        return false;
    }

    var gallery = state.selectedGallery;

    if (!gallery || !gallery.path) {
        gallery = parent.galleries[
            Math.floor(
                Math.random()
                * parent.galleries.length
            )
        ];
    }

    var candidates = getVisibleParents();

    if (!parentMatches(parent)) {
        setStatus(
            "The selected parent does not match "
            + "the current filters."
        );
        return false;
    }

    var shuffledPaths = activateRandomNavigation(
        candidates,
        parent.path,
        gallery.path
    );

    setActiveSlideshowType("random");
    closeGalleryDialog();
    startGallery(gallery, true);
    setStatus(
        "Random slideshow starts from "
        + gallery.name
        + "; "
        + Math.max(0, shuffledPaths.length - 1)
        + " following galleries were shuffled."
    );
    return true;
}

function createGalleryCard(gallery) {
    var card = document.createElement("div");
    card.className = "galleryCard" + (gallery.video ? " video" : "");
    card.title = gallery.path;
    card.tabIndex = -1;
    card._galleryPath = normalizePath(gallery.path);

    var imagePanel = document.createElement("div");
    imagePanel.className = "galleryImage";
    configureLazyCover(
        imagePanel,
        gallery.thumbnail,
        gallery.cover,
        gallery.name
    );

    var infoPanel = document.createElement("div");
    infoPanel.className = "galleryInfo";
    infoPanel.innerHTML =
        '<div class="galleryName">' + escapeHtml(gallery.name) + '</div>' +
        '<div class="galleryFlags">' + (gallery.video ? "Paired video" : "Images only") + '</div>';

    card.appendChild(imagePanel);
    card.appendChild(infoPanel);

    card.onclick = function() {
        selectGalleryCard(gallery, card);
    };
    card.ondblclick = function() {
        selectGalleryCard(gallery, card);
        startGallery(gallery);
    };
    card.oncontextmenu = function() {
        if (state.selectedParent) {
            showKeywordContext(
                state.selectedParent,
                window.event.clientX,
                window.event.clientY
            );
        }

        window.event.cancelBubble = true;
        window.event.returnValue = false;
        return false;
    };
    return card;
}

function startGallery(gallery, preserveNavigationOrder) {
    if (!gallery || !gallery.path) {
        return;
    }

    if (!preserveNavigationOrder) {
        activateNormalNavigation(
            getVisibleParents()
        );
        setActiveSlideshowType("normal");
    }

    ensureBridge();

    var commandAction = "start";

    if (
        preserveNavigationOrder
        && state.activeSlideshowType === "random"
    ) {
        commandAction = state.uniqueRandom
            ? "startrandomunique"
            : "startrandom";
    }

    sendCommand(commandAction, gallery.path);
    state.currentGalleryPath = gallery.path;
    state.currentParentPath =
        fso.GetParentFolderName(gallery.path);
    focusRunningGalleryThumbnail(gallery.path);
    setStatus("Starting: " + gallery.name);
}

function firstFilteredParentGallery() {
    var i;

    for (i = 0; i < state.parents.length; i++) {
        if (
            parentMatches(state.parents[i])
            && state.parents[i].galleries.length
        ) {
            return {
                parent: state.parents[i],
                gallery: state.parents[i].galleries[0]
            };
        }
    }

    return null;
}

function startMainSlideshow() {
    var parent = null;
    var gallery = null;

    if (
        state.selectedGallery
        && state.selectedParent
        && parentMatches(state.selectedParent)
    ) {
        parent = state.selectedParent;
        gallery = state.selectedGallery;
    } else if (
        state.selectedParent
        && parentMatches(state.selectedParent)
        && state.selectedParent.galleries.length
    ) {
        parent = state.selectedParent;
        gallery = state.selectedParent.galleries[0];
    } else {
        var firstMatch = firstFilteredParentGallery();

        if (firstMatch) {
            parent = firstMatch.parent;
            gallery = firstMatch.gallery;
        }
    }

    if (!gallery) {
        alert(
            "No gallery matches the current keyword and rating filters."
        );
        return false;
    }

    state.selectedParent = parent;
    state.expandedLetter = parent.letter
        ? String(parent.letter).toUpperCase()
        : state.expandedLetter;

    if (isGalleryDialogOpen()) {
        closeGalleryDialog();
    }

    startGallery(gallery);
    return true;
}

function startRandom() {
    var candidates = getVisibleParents();

    if (!candidates.length) {
        alert(
            "No parent gallery matches the current filters."
        );
        return false;
    }

    var preferredEntry = null;

    if (
        state.selectedGallery
        && state.selectedGallery.path
    ) {
        var selectedEntry = findGalleryEntryByPath(
            state.selectedGallery.path
        );

        if (
            selectedEntry
            && parentMatches(selectedEntry.parent)
        ) {
            preferredEntry = selectedEntry;
        }
    }

    if (
        !preferredEntry
        && state.selectedParent
        && parentMatches(state.selectedParent)
        && state.selectedParent.galleries.length
    ) {
        preferredEntry = {
            parent: state.selectedParent,
            gallery: state.selectedParent.galleries[0]
        };
    }

    var shuffledPaths = activateRandomNavigation(
        candidates,
        preferredEntry
            ? preferredEntry.parent.path
            : "",
        preferredEntry
            ? preferredEntry.gallery.path
            : ""
    );

    var firstEntry = preferredEntry;

    if (!firstEntry) {
        var randomParent = candidates[
            Math.floor(Math.random() * candidates.length)
        ];

        if (randomParent.galleries.length) {
            firstEntry = {
                parent: randomParent,
                gallery: randomParent.galleries[
                    Math.floor(
                        Math.random()
                        * randomParent.galleries.length
                    )
                ]
            };
        }
    }

    if (!firstEntry) {
        alert(
            "No gallery could be added to the random queue."
        );
        return false;
    }

    state.selectedParent = firstEntry.parent;
    state.expandedLetter = firstEntry.parent.letter
        ? String(firstEntry.parent.letter).toUpperCase()
        : state.expandedLetter;

    if (isGalleryDialogOpen()) {
        closeGalleryDialog();
    }

    setActiveSlideshowType("random");
    startGallery(firstEntry.gallery, true);
    setStatus(
        "Random slideshow starts on selected parent: "
        + firstEntry.parent.name
        + ", gallery: "
        + firstEntry.gallery.name
        + ". Next parent will be chosen randomly from "
        + candidates.length
        + " filtered parents."
    );
    return true;
}

function openCurrentParent() {
    var parent = state.selectedParent;
    if (!parent && state.currentParentPath) {
        parent = { path: state.currentParentPath };
    }
    if (!parent || !parent.path) {
        alert("Select a parent gallery first.");
        return;
    }
    shell.Run('explorer.exe "' + parent.path.replace(/"/g, '""') + '"', 1, false);
}

function searchChanged() {
    state.searchText = document.getElementById("searchInput").value;
    renderParents();
}

function showKeywordContext(parent, x, y) {
    var menu = document.getElementById("contextMenu");
    var parentRating = parseInt(parent.rating, 10) || 0;
    menu.innerHTML =
        '<div class="contextTitle">'
        + 'Rating: '
        + escapeHtml(ratingStarsText(parentRating))
        + '</div>';

    if (!state.keywords.length) {
        menu.innerHTML +=
            '<div class="smallMuted" style="padding:8px;">'
            + 'No keywords defined.'
            + '</div>';
    } else {
        var assigned = {};
        var i;

        for (i = 0; i < parent.keywords.length; i++) {
            assigned[lower(parent.keywords[i])] = true;
        }

        var groups = groupedKeywords(state.keywords);
        var groupIndex;

        for (groupIndex = 0; groupIndex < groups.length; groupIndex++) {
            var group = groups[groupIndex];
            var groupElement = document.createElement("div");
            groupElement.className = "contextKeywordGroup";

            var buttons = document.createElement("div");
            buttons.className = "contextKeywordButtons";

            var wordIndex;

            for (
                wordIndex = 0;
                wordIndex < group.words.length;
                wordIndex++
            ) {
                (function(word) {
                    var key = lower(word);
                    var button = document.createElement("button");
                    var mark = null;

                    function refreshButton() {
                        var active = !!assigned[key];

                        button.className =
                            "contextKeywordButton"
                            + (active ? " active" : "");
                        button.title =
                            active
                            ? "Remove keyword: " + word
                            : "Assign keyword: " + word;
                        button.innerHTML =
                            '<span class="contextKeywordMark">'
                            + (active ? "✓" : "")
                            + '</span>'
                            + '<span>'
                            + escapeHtml(word)
                            + '</span>';
                        mark = button.firstChild;
                    }

                    button.type = "button";
                    refreshButton();

                    button.onclick = function() {
                        var newChecked = !assigned[key];
                        toggleParentKeyword(
                            parent,
                            word,
                            newChecked
                        );
                        assigned[key] = newChecked;
                        refreshButton();

                        window.event.cancelBubble = true;
                        window.event.returnValue = false;
                        return false;
                    };

                    buttons.appendChild(button);
                })(group.words[wordIndex]);
            }

            groupElement.appendChild(buttons);
            menu.appendChild(groupElement);
        }
    }

    menu.style.left = "0px";
    menu.style.top = "0px";
    menu.style.display = "block";

    var margin = 8;
    var maximumLeft =
        document.documentElement.clientWidth
        - menu.offsetWidth
        - margin;
    var maximumTop =
        document.documentElement.clientHeight
        - menu.offsetHeight
        - margin;

    menu.style.left =
        Math.max(margin, Math.min(x, maximumLeft))
        + "px";
    menu.style.top =
        Math.max(margin, Math.min(y, maximumTop))
        + "px";
}

function hideContextMenu() {
    document.getElementById("contextMenu").style.display = "none";
}

function toggleParentKeyword(parent, word, checked) {
    var words = getParentKeywords(parent.path);
    var result = [];
    var found = false;
    var i;
    for (i = 0; i < words.length; i++) {
        if (lower(words[i]) === lower(word)) {
            found = true;
            if (!checked) {
                continue;
            }
        }
        result.push(words[i]);
    }
    if (checked && !found) {
        result.push(word);
    }
    result = parseKeywordList(joinKeywords(result));
    saveParentKeywords(parent.path, result);
    parent.keywords = result;
    renderParents();
    saveLibraryCache();
    document.getElementById("galleryKeywords").innerText = result.join(", ");
}

function ensureBridge() {
    if (!fso.FileExists(bridgePath)) {
        alert("Missing bridge:\n\n" + bridgePath);
        return false;
    }
    try {
        shell.Run(
            '"' + bridgePath + '" --resident --takeover',
            0,
            false
        );
    } catch (error) {
        alert("Could not start the AutoHotkey bridge.\n\n" + error.message);
        return false;
    }
    return true;
}

function sendCommand(action, path) {
    var commandId = String(new Date().getTime()) + String(Math.floor(Math.random() * 10000));
    var tempPath = commandPath + ".tmp";
    var text =
        "[Command]\r\n" +
        "Id=" + commandId + "\r\n" +
        "Action=" + action + "\r\n" +
        "Path=" + (path || "") + "\r\n";

    try {
        if (fso.FileExists(tempPath)) {
            fso.DeleteFile(tempPath, true);
        }
        if (!writeText(tempPath, text, false)) {
            throw new Error("The command file is temporarily locked.");
        }

        if (fso.FileExists(commandPath)) {
            fso.DeleteFile(commandPath, true);
        }
        fso.MoveFile(tempPath, commandPath);
    } catch (error) {
        alert("Could not send command to bridge.\n\n" + error.message);
    }
}

function reloadParentKeywordsFromIni() {
    if (!state.root || !state.parents.length) {
        return false;
    }

    var i;

    for (i = 0; i < state.parents.length; i++) {
        state.parents[i].keywords = getParentKeywords(state.parents[i].path);
    }

    if (state.selectedParent) {
        var selectedPath = lower(state.selectedParent.path);

        for (i = 0; i < state.parents.length; i++) {
            if (lower(state.parents[i].path) === selectedPath) {
                state.selectedParent = state.parents[i];
                document.getElementById("galleryKeywords").innerText =
                    state.selectedParent.keywords.length
                    ? state.selectedParent.keywords.join(", ")
                    : "";
                break;
            }
        }
    }

    renderParents();
    saveLibraryCache();
    return true;
}

function pollSession() {
    pollThumbnailGeneration();

    var data = readIni(sessionPath);
    var currentParent = normalizePath(getIniValue(data, "Session", "CurrentParent", ""));
    var currentGallery = normalizePath(getIniValue(data, "Session", "CurrentGallery", ""));
    var keywordRevision = getIniValue(data, "Session", "KeywordRevision", "");
    var ratingRevision = getIniValue(data, "Session", "RatingRevision", "");
    var changed = lower(currentParent) !== lower(state.currentParentPath)
        || lower(currentGallery) !== lower(state.currentGalleryPath);
    var keywordsChanged = keywordRevision !== state.keywordRevision;
    var ratingsChanged = ratingRevision !== state.ratingRevision;

    state.currentParentPath = currentParent;
    state.currentGalleryPath = currentGallery;
    state.keywordRevision = keywordRevision;
    state.ratingRevision = ratingRevision;

    if (keywordsChanged) {
        reloadParentKeywordsFromIni();
    }

    if (ratingsChanged) {
        refreshParentRatings();
    }

    if (changed && currentGallery) {
        focusRunningGalleryThumbnail(
            currentGallery
        );
    } else if (changed && !keywordsChanged) {
        renderParents();
    }
}

function saveWindowPlacement() {
    try {
        var data = readIni(settingsPath);

        if (!data.HtmlWindow) {
            data.HtmlWindow = {};
        }

        data.HtmlWindow.X = String(window.screenLeft);
        data.HtmlWindow.Y = String(window.screenTop);
        data.HtmlWindow.Width = String(
            document.documentElement.clientWidth
        );
        data.HtmlWindow.Height = String(
            document.documentElement.clientHeight
        );

        writeIni(settingsPath, data);
    } catch (error) {
    }
}

function restoreWindowPlacement() {
    var data = readIni(settingsPath);
    var x = parseInt(getIniValue(data, "HtmlWindow", "X", ""), 10);
    var y = parseInt(getIniValue(data, "HtmlWindow", "Y", ""), 10);
    var width = parseInt(getIniValue(data, "HtmlWindow", "Width", ""), 10);
    var height = parseInt(getIniValue(data, "HtmlWindow", "Height", ""), 10);

    if (!isNaN(width) && !isNaN(height) && width >= 880 && height >= 600) {
        window.resizeTo(width, height);
    }
    if (!isNaN(x) && !isNaN(y)) {
        window.moveTo(x, y);
    }
}

function handleWindowScriptError(message, url, lineNumber) {
    var text = lower(String(message || ""));

    if (text.indexOf("another process") >= 0
        || text.indexOf("locked a portion") >= 0
        || text.indexOf("sharing violation") >= 0) {
        try {
            setStatus("A shared file was temporarily busy; retrying.");
        } catch (error) {
        }

        return true;
    }

    return false;
}

function requestExit() {
    if (confirm("Exit Gallery Slideshow Manager and close the current IrfanView slideshow?")) {
        sendCommand("exit", "");
        window.close();
    }
}

function setStatus(text) {
    document.getElementById("statusBar").innerText =
        "v" + APP_VERSION + " | " + text;
}

function claimSingleManagerInstance() {
    if (!fso.FileExists(bridgePath)) {
        document.title =
            "Gallery Slideshow Manager "
            + APP_VERSION;
        return false;
    }

    managerInstanceToken =
        String(new Date().getTime())
        + "-"
        + String(
            Math.floor(Math.random() * 1000000)
        );

    document.title =
        "Gallery Slideshow Manager "
        + APP_VERSION
        + " ["
        + managerInstanceToken
        + "]";

    try {
        shell.Run(
            '"'
            + bridgePath
            + '" --claim-manager='
            + managerInstanceToken,
            0,
            false
        );
    } catch (error) {
        document.title =
            "Gallery Slideshow Manager "
            + APP_VERSION;
        return false;
    }

    window.setTimeout(function() {
        if (
            document.title.indexOf(
                "[" + managerInstanceToken + "]"
            ) >= 0
        ) {
            document.title =
                "Gallery Slideshow Manager "
                + APP_VERSION;
        }
    }, 2500);

    return true;
}

function initialize() {
    window.onerror = handleWindowScriptError;
    claimSingleManagerInstance();
    migrateLegacyDataToSharedTemp();
    restoreWindowPlacement();
    loadSettings();
    restoreActiveSlideshowType();
    ensureBridge();
    renderKeywordFilters();
    renderRatingFilters();

    if (state.root && fso.FolderExists(state.root)) {
        loadKeywords();

        if (!loadLibraryCache()) {
            scanLibrary();
        }
    } else {
        renderParents();
        setStatus("Select the galleries root folder.");
    }

    document.onclick = function() {
        hideContextMenu();
    };

    window.onresize = function() {
        updateFixedControlsLayout();

        if (isGalleryDialogOpen() && state.selectedParent) {
            sizeGalleryDialog(state.selectedParent.galleries.length);
        }
    };

    var content = document.getElementById("content");
    content.onscroll = scheduleVisibleThumbnailRefresh;

    var galleryGrid = document.getElementById("galleryGrid");
    galleryGrid.onscroll = scheduleVisibleThumbnailRefresh;

    document.onkeydown = function() {
        if (window.event.keyCode === 27) {
            window.event.returnValue = false;

            if (isGalleryDialogOpen()) {
                closeGalleryDialog();
            } else {
                requestExit();
            }

            return false;
        }
    };

    window.onbeforeunload = function() {
        saveWindowPlacement();
    };

    updateFixedControlsLayout();
    scheduleVisibleThumbnailRefresh();
    pollSession();
    window.setInterval(pollSession, 1000);
}
</script>
</head>
<body onload="initialize()">
<div id="appShell">
    <div id="fixedControls">
        <div id="topBar">
        <div class="row">
            <span class="label">Galleries root</span>
            <input id="rootPath" class="grow" type="text" />
            <button onclick="browseRoot()">Browse</button>
            <button onclick="saveRoot()">Save &amp; refresh</button>
        </div>
        <div class="row">
            <span class="label">New keyword</span>
            <input id="keywordName" type="text" />
            <button onclick="addKeyword()">Add keyword</button>
            <button onclick="clearUnusedKeywords()">Clear unused</button>
            <span class="label" style="margin-left:18px;">Search</span>
            <input id="searchInput" type="text" onkeyup="searchChanged()" />
        </div>
        <div class="row">
            <span class="label">Filter</span>
            <div id="keywordFilters" class="grow"></div>
        </div>
        <div class="row">
            <span class="label">Rating</span>
            <div id="ratingFilters"></div>
            <span id="ratingFilterHint"></span>
        </div>
        <div class="row">
            <span class="label">Filter preset</span>
            <select id="filterPresetSelect" onchange="loadSelectedFilterPreset()"></select>
            <input id="filterPresetName" type="text" placeholder="New preset name" />
            <button id="saveFilterPresetButton" onclick="saveCurrentFilterPreset()">Save current filter</button>
            <span id="filterPresetHint"></span>
        </div>
        </div>

        <div id="toolbar">
            <div class="toolbarZone left">
                <button id="displayModeButton" class="toolbarControl toolbarCheckButton" type="button" onclick="displayModeChanged()"><span class="checkbuttonMark">✓</span><span>TILES</span></button>
                <button id="autoVlcButton" class="toolbarControl toolbarCheckButton" type="button" onclick="toggleAutoVlc()"><span class="checkbuttonMark">✓</span><span>Open paired video in VLC</span></button>
                <button id="uniqueRandomButton" class="toolbarControl toolbarCheckButton" type="button" onclick="toggleUniqueRandom()"><span class="checkbuttonMark">✓</span><span>UNIQUE</span></button>
            </div>

            <div id="slideshowActions">
                <button id="mainSlideshowButton" class="toolbarControl toolbarCheckButton slideshowActionButton" type="button" onclick="startMainSlideshow()"><span class="checkbuttonMark">✓</span><span>SLIDESHOW</span></button>
                <button id="mainRandomSlideshowButton" class="toolbarControl toolbarCheckButton slideshowActionButton" type="button" onclick="startRandom()"><span class="checkbuttonMark">✓</span><span>RANDOM SLIDESHOW</span></button>
            </div>

            <div class="toolbarZone right">
                <button class="toolbarControl" type="button" onclick="openCurrentParent()">Open parent folder</button>
                <button class="toolbarControl" type="button" onclick="scanLibrary()" title="Rescan folders and rebuild the persistent cache">Refresh library</button>
                <button class="toolbarControl danger" type="button" onclick="requestExit()">Exit</button>
            </div>
        </div>
    </div>

    <div id="content">
        <div id="summaryBar">
            <div id="summaryTitle">Parent galleries</div>
            <div id="summaryText"></div>
        </div>
        <div id="parentGrid"></div>
        <div id="emptyState">No parent galleries match the current filters.</div>
    </div>

    <div id="statusBar">v0.56 | Ready.</div>
</div>

<div id="galleryOverlay" onclick="if (window.event.srcElement === this) closeGalleryDialog();">
    <div id="galleryDialog">
        <div id="galleryHeader">
            <div id="galleryHeaderText">
                <div id="galleryTitle"></div>
                <div id="galleryKeywords"></div>
            </div>
            <button onclick="openCurrentParent()">Open folder</button>
            <button class="primary" onclick="if(state.selectedParent && state.selectedParent.galleries.length) startGallery(state.selectedParent.galleries[0]);">Start first gallery</button>
            <button id="startSelectedRandomButton" class="primary" onclick="startRandomFromSelectedGallery()">Start random slideshow</button>
            <button onclick="closeGalleryDialog()">Close</button>
        </div>
        <div id="galleryGrid"></div>
    </div>
</div>

<div id="contextMenu" onclick="window.event.cancelBubble=true;"></div>
</body>
</html>
